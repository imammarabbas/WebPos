<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WebPos.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.webPosFocusById = function (id) {
            if (!id) {
                return;
            }
            var el = document.getElementById(id);
            if (el) {
                el.focus();
            }
        };

        window.webPosBindCtrlK = function () {
            if (window.__webPosCtrlKBound) {
                return;
            }
            window.__webPosCtrlKBound = true;
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                    e.preventDefault();
                }
            });
        };

        window.webPosLoginKeys = {
            bind: function (dotNetRef) {
                this.unbind();
                this._ref = dotNetRef;
                this._handler = function (e) {
                    var el = document.activeElement;
                    var tag = el && el.tagName;
                    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
                        return;
                    }
                    if (e.ctrlKey || e.metaKey || e.altKey) {
                        return;
                    }
                    if (e.key.length === 1 || e.key === 'Enter' || e.key === 'Tab') {
                        e.preventDefault();
                        dotNetRef.invokeMethodAsync('CaptureLoginKey', e.key);
                    }
                };
                document.addEventListener('keydown', this._handler, true);
            },
            unbind: function () {
                if (this._handler) {
                    document.removeEventListener('keydown', this._handler, true);
                    this._handler = null;
                }
                this._ref = null;
            }
        };
    </script>
</body>

</html>
