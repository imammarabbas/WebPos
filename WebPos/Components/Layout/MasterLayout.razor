@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<link rel="stylesheet" href="master.css" />

@if (_authUi == AuthUi.Authenticated)
{
    <div class="mm-shell">
        <CircuitTenantInitializer />

        <MasterTopBar />

        <div class="mm-body">
            <MasterNav />
            <main class="mm-main">
                @Body
            </main>
        </div>
    </div>
}
else if (_authUi == AuthUi.Anonymous)
{
    @Body
}

@code {
    private enum AuthUi
    {
        Pending,
        Authenticated,
        Anonymous
    }

    private AuthUi _authUi = AuthUi.Pending;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            _authUi = AuthUi.Anonymous;
            return;
        }

        AuthenticationState state = await AuthenticationState;
        bool authenticated = state.User.Identity?.IsAuthenticated == true;
        _authUi = authenticated ? AuthUi.Authenticated : AuthUi.Anonymous;
    }
}
