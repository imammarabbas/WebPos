@inherits LayoutComponentBase
@using WebPos.Core.Abstractions
@inject IStoreBrandingService BrandingService

<link rel="stylesheet" href="master.css" />

<div class="mm-shell">
    <CircuitTenantInitializer />

    <MasterTopBar />

    <div class="mm-body">
        <MasterNav />
        <main class="mm-main">
            @Body
        </main>
    </div>

    <footer class="mm-footer">© @_storeName @DateTime.UtcNow.Year</footer>
</div>

@code {
    private string _storeName = "Cone Mart";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _storeName = (await BrandingService.GetAsync()).StoreName;
        }
        catch
        {
            _storeName = "Cone Mart";
        }
    }
}
