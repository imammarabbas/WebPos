@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using WebPos.Core.Abstractions
@using WebPos.Core.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IMasterOverviewService OverviewService
@inject IStoreStatusService StoreStatusService
@inject ICircuitTenantContext CircuitTenantContext

<aside class="mm-nav-duo" aria-label="Master navigation">
    <nav class="mm-rail" aria-label="Primary">
        <div class="mm-rail-brand" aria-hidden="true">TP</div>

        @foreach (NavSection section in Sections)
        {
            string sectionId = section.Id;
            bool active = string.Equals(_sectionId, sectionId, StringComparison.Ordinal);
            <button type="button"
                    class="mm-rail-item @(active ? "active" : null)"
                    @onclick="@(() => SelectSectionAsync(sectionId))">
                <span class="mm-rail-ico" aria-hidden="true">@((MarkupString)section.IconSvg)</span>
                <span class="mm-rail-label">@section.Title</span>
            </button>
        }

        <div class="mm-rail-spacer"></div>
        <div class="mm-rail-foot" aria-hidden="true">@_initials</div>
    </nav>

    <div class="mm-subnav">
        <div class="mm-subnav-title">@ActiveSection.Title</div>
        <nav class="mm-subnav-links" aria-label="@ActiveSection.Title">
            @foreach (NavChild child in ActiveSection.Children)
            {
                string href = child.Href;
                bool childActive = IsChildActive(child);
                <a class="mm-subnav-link @(childActive ? "active" : null)"
                   href="@href"
                   @onclick="@(() => NavigateChild(href))"
                   @onclick:preventDefault>
                    <span class="mm-nav-ico" aria-hidden="true">@((MarkupString)child.IconSvg)</span>
                    <span class="mm-subnav-text">@child.Label</span>
                    @if (child.ShowLowStockBadge && _overview?.LowStockCount > 0)
                    {
                        <span class="mm-nav-badge">@_overview.LowStockCount pending</span>
                    }
                </a>
            }
        </nav>

        <div class="mm-sidebar-bottom">
            <div class="mm-status-card mm-cash-card">
                <div class="mm-status-title">Cash Position</div>
                <div class="mm-cash-value">Rs @FormatRs(_overview?.TodayRevenuePaisa ?? 0)</div>
                <div class="mm-status-row compact">
                    <span class="mm-dot @(_storeStatus?.ApiOnline == true ? "online" : "offline")"></span>
                    <span>@(_storeStatus?.ApiOnline == true ? "Online" : "Offline")</span>
                    <span class="mm-status-sep">·</span>
                    <span>Till @(_storeStatus?.TillOpen == true ? "open" : "closed")</span>
                </div>
            </div>
        </div>
    </div>
</aside>

@code {
    private static readonly TimeSpan StatusPollInterval = TimeSpan.FromSeconds(30);

    private static readonly string IconCart =
