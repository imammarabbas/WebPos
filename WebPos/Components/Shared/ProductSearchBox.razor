@using WebPos.Core.Abstractions
@inject IProductAdminService ProductService
@inject IJSRuntime Js
@implements IDisposable

<div class="mm-product-search @(_open ? "open" : null)">
    @if (ShowChip)
    {
        <div class="mm-product-chip" title="@SelectedLabel">
            <span class="mm-product-chip-text">@SelectedLabel</span>
            <button type="button"
                    class="mm-product-chip-clear"
                    disabled="@Disabled"
                    title="Change product"
                    @onclick="ClearAsync">✕</button>
        </div>
    }
    else
    {
        <input class="form-control"
               id="@InputId"
               type="search"
               autocomplete="off"
               placeholder="@Placeholder"
               value="@_query"
               disabled="@Disabled"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onkeydown="OnKeyDown" />
        @if (_open && _hits.Count > 0)
        {
            <ul class="mm-product-suggest" role="listbox">
                @for (int i = 0; i < _hits.Count; i++)
                {
                    ProductAdminDto hit = _hits[i];
                    int index = i;
                    <li role="option"
                        class="@(index == _highlight ? "active" : null)"
                        @onmousedown:preventDefault
                        @onclick="() => SelectAsync(hit)">
                        <strong>@hit.Name</strong>
                        <span>
                            @(hit.IsBulk ? "Master" : "SKU")
                            · @(string.IsNullOrWhiteSpace(hit.ShortCode) ? hit.Sku : hit.ShortCode)
                            · Rs @FormatRs(hit.LatestRetailPricePaisa)
                        </span>
                    </li>
                }
            </ul>
        }
        else if (_open && _searching)
        {
            <div class="mm-product-suggest muted">Searching…</div>
        }
        else if (_open && _query.Trim().Length >= 1 && !_searching && _hits.Count == 0)
        {
            <div class="mm-product-suggest muted">No products match “@_query.Trim()”</div>
        }
    }
</div>

@code {
    [Parameter] public string? ProductId { get; set; }
    [Parameter] public EventCallback<string?> ProductIdChanged { get; set; }
    [Parameter] public string? SelectedLabel { get; set; }
    [Parameter] public EventCallback<string?> SelectedLabelChanged { get; set; }
    [Parameter] public EventCallback<ProductAdminDto> OnSelected { get; set; }
    [Parameter] public bool MastersOnly { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Type name, SKU, barcode, or code…";
    [Parameter] public string? InputId { get; set; }

    private readonly List<ProductAdminDto> _hits = [];
    private string _query = string.Empty;
    private bool _open;
    private bool _searching;
    private int _highlight;
    private CancellationTokenSource? _debounceCts;
    private int _searchVersion;

    private bool ShowChip =>
        !string.IsNullOrWhiteSpace(ProductId)
        && !string.IsNullOrWhiteSpace(SelectedLabel)
        && string.IsNullOrWhiteSpace(_query);

    private async Task ClearAsync()
    {
        _query = string.Empty;
        _open = false;
        _hits.Clear();
        await ProductIdChanged.InvokeAsync(string.Empty);
        await SelectedLabelChanged.InvokeAsync(string.Empty);
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        if (!string.IsNullOrWhiteSpace(InputId))
        {
            try
            {
                await Js.InvokeVoidAsync("webPosFocusById", InputId);
            }
            catch
            {
                /* ignore */
            }
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _open = true;
        _highlight = 0;
        await DebouncedSearchAsync();
    }

    private async Task OnFocus()
    {
        _open = true;
        if (_hits.Count == 0 && _query.Trim().Length >= 1)
        {
            await DebouncedSearchAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open)
        {
            return;
        }

        if (e.Key == "ArrowDown" && _hits.Count > 0)
        {
            _highlight = Math.Min(_highlight + 1, _hits.Count - 1);
            return;
        }

        if (e.Key == "ArrowUp" && _hits.Count > 0)
        {
            _highlight = Math.Max(_highlight - 1, 0);
            return;
        }

        if (e.Key == "Enter" && _hits.Count > 0)
        {
            await SelectAsync(_hits[_highlight]);
            return;
        }

        if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        CancellationToken token = _debounceCts.Token;
        int version = Interlocked.Increment(ref _searchVersion);

        try
        {
            await Task.Delay(220, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        string q = _query.Trim();
        if (q.Length == 0)
        {
            _hits.Clear();
            _searching = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _searching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            PagedResult<ProductAdminDto> result = await ProductService.SearchAsync(
                new ProductSearchQuery
                {
                    Search = q,
                    Page = 1,
                    PageSize = 40
                },
                token);

            if (version != _searchVersion)
            {
                return;
            }

            IEnumerable<ProductAdminDto> items = result.Items;
            if (MastersOnly)
            {
                items = items.Where(p => p.ParentProductId is null);
            }

            _hits.Clear();
            _hits.AddRange(items.Take(25));
            _highlight = 0;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            if (version == _searchVersion)
            {
                _hits.Clear();
            }
        }
        finally
        {
            if (version == _searchVersion)
            {
                _searching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SelectAsync(ProductAdminDto product)
    {
        string id = product.Id.ToString();
        string label = product.IsBulk
            ? $"{product.Name} (master)"
            : $"{product.Name} ({product.Sku})";

        _query = string.Empty;
        _open = false;
        _hits.Clear();

        await ProductIdChanged.InvokeAsync(id);
        await SelectedLabelChanged.InvokeAsync(label);
        await OnSelected.InvokeAsync(product);
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
