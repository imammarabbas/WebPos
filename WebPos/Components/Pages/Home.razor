@page "/"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Redirecting…</PageTitle>

<p style="margin:2rem;font-family:Segoe UI,sans-serif;color:#6b7280;">Redirecting…</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/master", replace: true);
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true, replace: true);
        }
    }
}
