@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using WebPos.Core.Models
@using WebPos.Core.Security
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject LoginTicketStore LoginTicketStore
@inject NavigationManager NavigationManager
@inject IStoreBrandingService BrandingService

<link rel="stylesheet" href="master.css" />

<PageTitle>Sign in · @_storeName</PageTitle>

<div class="mm-shell login-shell">
    <header class="mm-topbar">
        <div class="mm-brand">
            <div class="mm-logo" aria-hidden="true">TP</div>
            <div class="mm-brand-text">
                <div class="mm-brand-title">POS Master · @_storeName</div>
                <div class="mm-brand-sub">MASTER DATA • v2.4.1</div>
            </div>
        </div>

        <form class="mm-search" @onsubmit:preventDefault>
            <input type="search"
                   class="mm-search-input"
                   placeholder="Sign in to search…"
                   disabled
                   aria-label="Search unavailable until sign in" />
        </form>

        <div class="mm-top-actions">
            <div class="mm-avatar" title="Sign in" aria-hidden="true">IN</div>
        </div>
    </header>

    <div class="mm-body">
        <aside class="mm-nav-duo" aria-label="Master navigation">
            <nav class="mm-rail" aria-label="Primary">
                <div class="mm-rail-brand" aria-hidden="true">TP</div>

                @foreach (NavSection section in Sections)
                {
                    string sectionId = section.Id;
                    bool active = string.Equals(_sectionId, sectionId, StringComparison.Ordinal);
                    <button type="button"
                            class="mm-rail-item @(active ? "active" : null)"
                            @onclick="@(() => _sectionId = sectionId)">
                        <span class="mm-rail-ico" aria-hidden="true">@((MarkupString)section.IconSvg)</span>
                        <span class="mm-rail-label">@section.Title</span>
                    </button>
                }

                <div class="mm-rail-spacer"></div>
                <div class="mm-rail-foot" aria-hidden="true">IN</div>
            </nav>

            <div class="mm-subnav">
                <div class="mm-subnav-title">@ActiveSection.Title</div>
                <nav class="mm-subnav-links" aria-label="@ActiveSection.Title">
                    <span class="mm-subnav-link active">
                        <span class="mm-nav-ico" aria-hidden="true">@((MarkupString)IconLock)</span>
                        <span class="mm-subnav-text">Sign in</span>
                    </span>
                    @foreach (NavChild child in ActiveSection.Children)
                    {
                        <span class="mm-subnav-link is-locked" title="Sign in required">
                            <span class="mm-nav-ico" aria-hidden="true">@((MarkupString)child.IconSvg)</span>
                            <span class="mm-subnav-text">@child.Label</span>
                        </span>
                    }
                </nav>

                <div class="mm-sidebar-bottom">
                    <div class="mm-status-card mm-cash-card">
                        <div class="mm-status-title">Staff access</div>
                        <div class="mm-cash-value">Sign in required</div>
                        <div class="mm-status-row compact">
                            <span class="mm-dot online"></span>
                            <span>Portal ready</span>
                            <span class="mm-status-sep">·</span>
                            <span>Till locked</span>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="mm-main">
            <div class="mm-page">
                <div class="mm-page-header">
                    <div>
                        <h1>Sign in</h1>
                        <p>@_storeName master data overview</p>
                    </div>
                </div>

                <section class="mm-card login-card">
                    <h2>WebPos Sign In</h2>
                    <p class="login-lead">Use your Owner, Manager, or Admin account.</p>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="mm-alert mm-alert-error" role="alert">@_errorMessage</div>
                    }

                    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
                        <div class="mm-field">
                            <label for="username">Username</label>
                            <InputText id="username"
                                       @bind-Value="_model.Username"
                                       autocomplete="username"
                                       disabled="@_isSubmitting" />
                        </div>

                        <div class="mm-field">
                            <label for="password">Password</label>
                            <InputText id="password"
                                       type="password"
                                       @bind-Value="_model.Password"
                                       autocomplete="current-password"
                                       disabled="@_isSubmitting"
                                       @onkeydown="HandleKeyDown" />
                        </div>

                        <button class="mm-btn mm-btn-primary login-submit"
                                type="submit"
                                disabled="@_isSubmitting">
                            @(_isSubmitting ? "Signing in…" : "Sign In")
                        </button>
                    </EditForm>

                    <p class="login-hint">Cashiers sign in on the POS terminal with a PIN.</p>
                </section>
            </div>
        </main>
    </div>
</div>

@code {
