@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using WebPos.Core.Models
@using WebPos.Core.Security
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h1 class="h4 text-center mb-4">WebPos Sign In</h1>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username"
                               class="form-control"
                               @bind-Value="_model.Username"
                               autocomplete="username"
                               disabled="@_isSubmitting" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText id="password"
                               type="password"
                               class="form-control"
                               @bind-Value="_model.Password"
                               autocomplete="current-password"
                               disabled="@_isSubmitting"
                               @onkeydown="HandleKeyDown" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _errorMessage;
    private bool _isSubmitting;

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_isSubmitting)
        {
            await HandleLoginAsync();
        }
    }

private async Task HandleLoginAsync()
{
    _errorMessage = null;
    _isSubmitting = true;

    try
    {
        User? user = await AuthService.AuthenticateAsync(_model.Username, _model.Password);

        if (user is null)
        {
            _errorMessage = "Invalid username or password.";
            return;
        }

        // کوکی کا جھنجھٹ ختم، صرف Provider پر بھروسہ کریں
        if (AuthStateProvider is PosAuthStateProvider posAuth)
        {
            await posAuth.MarkUserAsAuthenticated(user);
        }

        // forceLoad: true ضروری ہے تاکہ نئی آتھنٹیکیشن اسٹیٹ کے ساتھ سرور ریفریش ہو
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
    finally
    {
        _isSubmitting = false;
    }
}
}