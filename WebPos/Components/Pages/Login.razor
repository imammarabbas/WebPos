@page "/login"
@layout EmptyLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using WebPos.Core.Models
@using WebPos.Core.Security
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject LoginTicketStore LoginTicketStore
@inject NavigationManager NavigationManager
@inject IStoreBrandingService BrandingService
@inject IJSRuntime JS

<link rel="stylesheet" href="master.css" />

<PageTitle>Sign in · @_storeName</PageTitle>

<div class="mm-shell login-page">
    <header class="mm-topbar login-topbar">
        <div class="mm-brand">
            <div class="mm-logo" aria-hidden="true">TP</div>
            <div class="mm-brand-text">
                <div class="mm-brand-title">POS Master · @_storeName</div>
                <div class="mm-brand-sub">MASTER DATA • v2.4.1</div>
            </div>
        </div>
    </header>

    <main class="login-main">
        <section class="mm-card login-card">
            <div class="mm-page-header">
                <div>
                    <h1>Sign in</h1>
                    <p>Use your Owner, Manager, or Admin account.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mm-alert mm-alert-error" role="alert">@_errorMessage</div>
            }

            <EditForm Model="_model">
                <div class="mm-field">
                    <label for="username">Username</label>
                    <input id="username"
                           @ref="_usernameInput"
                           @bind="_model.Username"
                           @bind:event="oninput"
                           autocomplete="username"
                           disabled="@_isSubmitting"
                           @onkeydown="HandleUsernameKeyDown" />
                </div>

                <div class="mm-field">
                    <label for="password">Password</label>
                    <input id="password"
                           @ref="_passwordInput"
                           type="password"
                           @bind="_model.Password"
                           @bind:event="oninput"
                           autocomplete="current-password"
                           disabled="@_isSubmitting"
                           @onkeydown="HandlePasswordKeyDown" />
                </div>

                <button class="mm-btn mm-btn-primary login-submit"
                        type="button"
                        @onclick="HandleLoginAsync"
                        disabled="@_isSubmitting">
                    @(_isSubmitting ? "Signing in…" : "Sign In")
                </button>
            </EditForm>

            <p class="login-hint">Cashiers sign in on the POS terminal with a PIN.</p>
        </section>
    </main>
</div>

@code {
    private readonly LoginModel _model = new();
    private ElementReference _usernameInput;
    private ElementReference _passwordInput;
    private DotNetObjectReference<Login>? _self;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _keysBound;
    private string _storeName = "Cone Mart";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _storeName = (await BrandingService.GetAsync()).StoreName;
        }
        catch
        {
            _storeName = "Cone Mart";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("webPosLoginKeys.bind", _self);
            _keysBound = true;
            await _usernameInput.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    [JSInvokable]
    public async Task CaptureLoginKey(string key)
    {
        if (_isSubmitting)
        {
            return;
        }

        if (key is "Enter" or "Tab")
        {
            if (string.IsNullOrEmpty(_model.Username))
            {
                await FocusAsync(_usernameInput);
            }
            else
            {
                await FocusAsync(_passwordInput);
            }

            return;
        }

        if (key.Length != 1)
        {
            return;
        }

        _model.Username += key;
        await FocusAsync(_usernameInput);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleUsernameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is not ("Enter" or "Tab"))
        {
            return;
        }

        if (args.Key == "Enter")
        {
            await FocusAsync(_passwordInput);
        }
        // Tab uses native focus order (username → password).
    }

    private async Task HandlePasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_isSubmitting)
        {
            await HandleLoginAsync();
        }
    }

    private async Task FocusAsync(ElementReference input)
    {
        try
        {
            await input.FocusAsync();
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            User? user = await AuthService.AuthenticateAsync(_model.Username, _model.Password);

            if (user is null)
            {
                _errorMessage = "Invalid username or password.";
                return;
            }

            bool canAccessMaster =
                string.Equals(user.Role.RoleName, "Owner", StringComparison.OrdinalIgnoreCase)
                || string.Equals(user.Role.RoleName, "Manager", StringComparison.OrdinalIgnoreCase)
                || string.Equals(user.Role.RoleName, "Admin", StringComparison.OrdinalIgnoreCase);
            if (!canAccessMaster)
            {
                _errorMessage = "This account cannot access the Master Data portal. Use the POS terminal.";
                return;
            }

            if (AuthStateProvider is PosAuthStateProvider posAuth)
            {
                await posAuth.MarkUserAsAuthenticated(user);
            }

            string ticket = LoginTicketStore.Issue(user);
            NavigationManager.NavigateTo(
                $"/account/complete-login?ticket={Uri.EscapeDataString(ticket)}",
                forceLoad: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_keysBound)
        {
            try
            {
                await JS.InvokeVoidAsync("webPosLoginKeys.unbind");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
