@page "/master/purchases/{PurchaseOrderId:guid}"
@layout MasterLayout
@attribute [Authorize(Roles = "Owner,Manager")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using WebPos.Core.Abstractions
@inject IPurchaseService PurchaseService
@inject IPartyService PartyService
@inject NavigationManager Navigation
@inject IJSRuntime Js

<link rel="stylesheet" href="po-master.css" />

<PageTitle>Purchase @_detail?.SupplierInvoiceNo · Cone Mart</PageTitle>

<div class="mm-page pov-page" tabindex="0" @onkeydown="OnKeyDown">
    <div class="po-page-header">
        <div class="po-page-header-left">
            <div class="po-icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" stroke-linecap="round" />
                </svg>
            </div>
            <div>
                <h1>Purchase Order</h1>
                <p>View and manage purchase order details</p>
            </div>
        </div>
        <a class="po-btn po-btn-outline" href="/master/purchases">Back to Purchase Orders</a>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mm-alert mm-alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="mm-alert mm-alert-ok">@_success</div>
    }

    @if (_detail is null && string.IsNullOrEmpty(_error))
    {
        <p class="mm-muted">Loading purchase…</p>
    }
    else if (_detail is not null)
    {
        <div class="po-card">
            <h2>PO Information</h2>
            <div class="pov-info-grid">
                <div class="pov-info-item">
                    <label>PO No.</label>
                    @if (IsOpen)
                    {
                        <input class="form-control" @bind="_invoiceNo" @onfocus='() => _focusedField = "meta"' />
                    }
                    else
                    {
                        <div class="pov-value">@_detail.SupplierInvoiceNo</div>
                    }
                </div>
                <div class="pov-info-item">
                    <label>Supplier</label>
                    @if (IsOpen)
                    {
                        <select class="form-control" @bind="_supplierId" @onfocus='() => _focusedField = "meta"'>
                            @foreach (PartyDto s in _suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="pov-value">@(_detail.SupplierName ?? _detail.SupplierId.ToString("N")[..8])</div>
                    }
                </div>
                <div class="pov-info-item">
                    <label>Purchase Date</label>
                    @if (IsOpen)
                    {
                        <input class="form-control" type="date" @bind="_purchaseDate" @onfocus='() => _focusedField = "meta"' />
                    }
                    else
                    {
                        <div class="pov-value">@_detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    }
                </div>
                <div class="pov-info-item">
                    <label>Status</label>
                    <div>
                        @if (_detail.IsReceived)
                        {
                            <span class="po-badge po-badge-received">Received</span>
                        }
                        else
                        {
                            <span class="po-badge po-badge-open">Open</span>
                        }
                    </div>
                </div>
                <div class="pov-info-item">
                    <label>Payment</label>
                    <div class="pov-value">@_detail.PaymentStatus</div>
                </div>
                @if (IsOpen)
                {
                    <div class="pov-info-item">
                        <label>Discount (Rs)</label>
                        <input class="form-control" type="number" step="0.01" @bind="_discountRs" @onfocus='() => _focusedField = "meta"' />
                    </div>
                }
            </div>
        </div>

        <div class="po-card">
            <h2>Receiving Summary</h2>
            <div class="pov-summary-row">
                <div class="pov-summary-kpi">
                    <span>Lines</span>
                    <strong>@_lines.Count</strong>
                </div>
                <div class="pov-summary-kpi">
                    <span>Total Qty</span>
                    <strong>@TotalQty.ToString("N3")</strong>
                </div>
                <div class="pov-summary-kpi">
                    <span>Stock Status</span>
                    <strong style="font-size:1rem;">@(_detail.IsReceived ? "Fully received" : "Not received")</strong>
                </div>
            </div>
        </div>

        <div class="po-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 style="margin:0;">Items</h2>
                @if (IsOpen)
                {
                    <button type="button" class="po-btn po-btn-outline" @onclick="AddLine">+ Line</button>
                }
            </div>
            <div class="po-table-wrap">
                <table class="po-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th class="po-num">Qty</th>
                            <th class="po-num">Bonus</th>
                            <th class="po-num">Cost</th>
                            <th class="po-num">Retail</th>
                            <th>Batch</th>
                            <th>Expiry</th>
                            <th>Rack</th>
                            <th class="po-num">Total Purchase</th>
                            @if (IsOpen)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _lines.Count; i++)
                        {
                            int index = i;
                            LineEdit line = _lines[index];
                            decimal amount = line.Quantity * line.PurchasePriceRs;
                            <tr class="@(index == _selectedLineIndex ? "selected" : null)"
                                @onclick="() => _selectedLineIndex = index">
                                <td>@(index + 1)</td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <ProductSearchBox InputId="@($"mm-po-detail-product-{index}")"
                                                          ProductId="@line.ProductId"
                                                          ProductIdChanged="v => line.ProductId = v ?? string.Empty"
                                                          SelectedLabel="@line.ProductName"
                                                          SelectedLabelChanged="v => line.ProductName = v"
                                                          OnSelected="p => OnLineProductSelectedAsync(index, p)"
                                                          OnFocused='() => OnLineFieldFocus(index, "product")'
                                                          MastersOnly="true"
                                                          Disabled="@_saving" />
                                    }
                                    else
                                    {
                                        @(line.ProductName ?? line.ProductId)
                                    }
                                </td>
                                <td class="po-num">
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.001" @bind="line.Quantity" @bind:after="() => _amountText.Remove(index)" @onfocus='() => OnLineFieldFocus(index, "qty")' />
                                    }
                                    else
                                    {
                                        @line.Quantity.ToString("N3")
                                    }
                                </td>
                                <td class="po-num">
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.001" @bind="line.BonusQuantity" @onfocus='() => OnLineFieldFocus(index, "bonus")' />
                                    }
                                    else
                                    {
                                        @line.BonusQuantity.ToString("N3")
                                    }
                                </td>
                                <td class="po-num">
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.01" @bind="line.PurchasePriceRs" @bind:after="() => _amountText.Remove(index)" @onfocus='() => OnLineFieldFocus(index, "price")' />
                                    }
                                    else
                                    {
                                        <text>@line.PurchasePriceRs.ToString("N2")</text>
                                    }
                                </td>
                                <td class="po-num">
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.01" @bind="line.RetailPriceRs" @onfocus='() => OnLineFieldFocus(index, "retail")' />
                                    }
                                    else
                                    {
                                        <text>@line.RetailPriceRs.ToString("N2")</text>
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" @bind="line.BatchNumber" @onfocus='() => OnLineFieldFocus(index, "batch")' />
                                    }
                                    else
                                    {
                                        @line.BatchNumber
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="date" @bind="line.ExpiryDate" @onfocus='() => OnLineFieldFocus(index, "expiry")' />
                                    }
                                    else
                                    {
                                        @(line.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" @bind="line.RackLocation" @onfocus='() => OnLineFieldFocus(index, "rack")' />
                                    }
                                    else
                                    {
                                        @(line.RackLocation ?? "—")
                                    }
                                </td>
                                <td class="po-num">
                                    @if (IsOpen)
                                    {
                                        <input class="form-control"
                                               type="text"
                                               inputmode="decimal"
                                               value="@GetAmountText(index, amount)"
                                               @oninput="e => OnAmountChanged(index, e)"
                                               @onfocus='() => OnLineFieldFocus(index, "total")' />
                                    }
                                    else
                                    {
                                        @amount.ToString("N2")
                                    }
                                </td>
                                @if (IsOpen)
                                {
                                    <td>
                                        <button type="button"
                                                class="mm-btn mm-btn-danger"
                                                title="Remove line"
                                                @onclick="() => RemoveLine(index)"
                                                @onclick:stopPropagation="true">🗑</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="po-card">
            <h2>Totals</h2>
            <div class="pov-totals">
                <div class="pov-totals-row">
                    <span>Sub Total</span>
                    <span>Rs @FormatRs(DisplaySubTotalPaisa)</span>
                </div>
                <div class="pov-totals-row">
                    <span>Discount</span>
                    <span>Rs @(IsOpen ? _discountRs.ToString("N2") : FormatRs(_detail.DiscountPaisa))</span>
                </div>
                <div class="pov-totals-row grand">
                    <span>Grand Total</span>
                    <span>Rs @FormatRs(DisplayNetPaisa)</span>
                </div>
            </div>
        </div>

        <div class="pov-footer-actions">
            @if (IsOpen)
            {
                <button type="button" class="po-btn po-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save changes")
                </button>
                <button type="button" class="po-btn po-btn-outline" disabled="@_saving" @onclick="ReceiveAsync">Receive stock</button>
            }
            <a class="po-btn" href="/master/purchases">Back</a>
        </div>
    }
</div>

@code {
    [Parameter] public Guid PurchaseOrderId { get; set; }

    private PurchaseOrderDetailDto? _detail;
    private readonly List<PartyDto> _suppliers = [];
    private readonly List<LineEdit> _lines = [];
    private readonly Dictionary<int, string> _amountText = [];
    private string _invoiceNo = string.Empty;
    private string _supplierId = string.Empty;
    private DateOnly _purchaseDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal _discountRs;
    private bool _saving;
    private string? _error;
    private string? _success;
    private int _selectedLineIndex = -1;
    private string? _focusedField;

    private bool IsOpen => _detail is { IsReceived: false };

    private decimal TotalQty => _lines.Sum(l => l.Quantity);

    private long DisplaySubTotalPaisa =>
        IsOpen
            ? (long)Math.Round(_lines.Sum(l => l.Quantity * l.PurchasePriceRs) * 100m, MidpointRounding.AwayFromZero)
            : (_detail?.SubTotalPaisa ?? 0);

    private long DisplayNetPaisa =>
        IsOpen
            ? Math.Max(0, DisplaySubTotalPaisa - (long)Math.Round(_discountRs * 100m, MidpointRounding.AwayFromZero))
            : (_detail?.NetPayablePaisa ?? 0);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _success = null;
        try
        {
            if (_suppliers.Count == 0)
            {
                IReadOnlyList<PartyDto> suppliers = await PartyService.GetSuppliersAsync();
                _suppliers.Clear();
                _suppliers.AddRange(suppliers);
            }

            PurchaseOrderDetailDto? detail = await PurchaseService.GetAsync(PurchaseOrderId);
            if (detail is null)
            {
                _detail = null;
                _error = "Purchase order not found.";
                return;
            }

            ApplyDetail(detail);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ApplyDetail(PurchaseOrderDetailDto detail)
    {
        _detail = detail;
        _invoiceNo = detail.SupplierInvoiceNo;
        _supplierId = detail.SupplierId.ToString();
        _purchaseDate = DateOnly.FromDateTime(detail.CreatedAt.UtcDateTime);
        _discountRs = detail.DiscountPaisa / 100m;
        _lines.Clear();
        _amountText.Clear();
        _selectedLineIndex = -1;
        foreach (PurchaseOrderLineDto line in detail.Lines)
        {
            _lines.Add(new LineEdit
            {
                ProductId = line.ProductId.ToString(),
                ProductName = line.ProductName,
                Quantity = line.Quantity,
                BonusQuantity = line.BonusQuantity,
                PurchasePriceRs = line.PurchasePricePaisa / 100m,
                RetailPriceRs = line.RetailPricePaisa / 100m,
                BatchNumber = line.BatchNumber,
                ExpiryDate = line.ExpiryDate,
                RackLocation = line.RackLocation ?? string.Empty
            });
        }
    }

    private void AddLine() =>
        _lines.Add(new LineEdit
        {
            ProductId = string.Empty,
            Quantity = 1,
            PurchasePriceRs = 0,
            RetailPriceRs = 0,
            BatchNumber = string.Empty,
            RackLocation = string.Empty
        });

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < _lines.Count)
        {
            _lines.RemoveAt(index);
            _amountText.Remove(index);
            _selectedLineIndex = _lines.Count == 0
                ? -1
                : Math.Min(index, _lines.Count - 1);
        }
    }

    private void OnLineFieldFocus(int row, string field)
    {
        _selectedLineIndex = row;
        _focusedField = field;
    }

    private bool IsEditableFieldFocused =>
        _focusedField is "product" or "qty" or "bonus" or "price" or "retail" or "batch" or "expiry" or "rack" or "total" or "meta";

    private string GetAmountText(int index, decimal amount) =>
        _amountText.TryGetValue(index, out string? text)
            ? text
            : amount.ToString("N2");

    private void OnAmountChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _lines.Count)
        {
            return;
        }

        string raw = e.Value?.ToString() ?? string.Empty;
        _amountText[index] = raw;
        LineEdit line = _lines[index];
        if (!decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out decimal total)
            && !decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out total))
        {
            return;
        }

        if (total < 0 || line.Quantity == 0)
        {
            return;
        }

        line.PurchasePriceRs = total / line.Quantity;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!IsOpen || _saving)
        {
            return;
        }

        if (e.Key is "ArrowUp" or "ArrowDown")
        {
            if (_lines.Count == 0)
            {
                return;
            }

            if (e.Key == "ArrowDown")
            {
                _selectedLineIndex = Math.Min(_lines.Count - 1, Math.Max(0, _selectedLineIndex) + 1);
            }
            else
            {
                _selectedLineIndex = Math.Max(0, (_selectedLineIndex < 0 ? _lines.Count : _selectedLineIndex) - 1);
            }

            return;
        }

        if ((e.Key is "Delete" or "Backspace") && !IsEditableFieldFocused)
        {
            RemoveLine(_selectedLineIndex);
        }
    }

    private async Task SaveAsync()
    {
        if (_detail is null || !IsOpen)
        {
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        try
        {
            UpdateOpenPurchaseRequest request = BuildUpdateRequest();
            PurchaseOrderDetailDto updated = await PurchaseService.UpdateOpenPurchaseAsync(
                PurchaseOrderId,
                request);
            ApplyDetail(updated);
            _success = "Purchase order saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReceiveAsync()
    {
        if (_detail is null || !IsOpen)
        {
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        try
        {
            UpdateOpenPurchaseRequest request = BuildUpdateRequest();
            await PurchaseService.UpdateOpenPurchaseAsync(PurchaseOrderId, request);
            await PurchaseService.ReceiveStockAsync(PurchaseOrderId);
            PurchaseOrderDetailDto? detail = await PurchaseService.GetAsync(PurchaseOrderId);
            if (detail is not null)
            {
                ApplyDetail(detail);
            }

            _success = "Stock received — inventory and AP updated.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private UpdateOpenPurchaseRequest BuildUpdateRequest()
    {
        if (!Guid.TryParse(_supplierId, out Guid supplierId) || supplierId == Guid.Empty)
        {
            throw new InvalidOperationException("Select a supplier.");
        }

        List<CreatePurchaseLineRequest> lines = [];
        foreach (LineEdit line in _lines)
        {
            if (!Guid.TryParse(line.ProductId, out Guid productId) || productId == Guid.Empty)
            {
                throw new InvalidOperationException("Each line needs a product.");
            }

            lines.Add(new CreatePurchaseLineRequest
            {
                ProductId = productId,
                Quantity = line.Quantity,
                BonusQuantity = line.BonusQuantity,
                PurchasePricePaisa = (long)Math.Round(line.PurchasePriceRs * 100m, MidpointRounding.AwayFromZero),
                RetailPricePaisa = (long)Math.Round(line.RetailPriceRs * 100m, MidpointRounding.AwayFromZero),
                BatchNumber = line.BatchNumber?.Trim() ?? string.Empty,
                ExpiryDate = line.ExpiryDate,
                RackLocation = string.IsNullOrWhiteSpace(line.RackLocation) ? null : line.RackLocation.Trim()
            });
        }

        return new UpdateOpenPurchaseRequest
        {
            SupplierInvoiceNo = _invoiceNo.Trim(),
            SupplierId = supplierId,
            PurchaseDate = new DateTimeOffset(_purchaseDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
            DiscountPaisa = (long)Math.Round(_discountRs * 100m, MidpointRounding.AwayFromZero),
            Lines = lines
        };
    }

    private async Task OnLineProductSelectedAsync(int index, ProductAdminDto product)
    {
        if (index < 0 || index >= _lines.Count)
        {
            return;
        }

        LineEdit line = _lines[index];
        line.ProductId = product.Id.ToString();
        line.ProductName = product.IsBulk
            ? $"{product.Name} (master)"
            : $"{product.Name} ({product.Sku})";
        if (line.PurchasePriceRs <= 0 && product.LatestCostPricePaisa > 0)
        {
            line.PurchasePriceRs = product.LatestCostPricePaisa / 100m;
        }

        if (line.RetailPriceRs <= 0 && product.LatestRetailPricePaisa > 0)
        {
            line.RetailPriceRs = product.LatestRetailPricePaisa / 100m;
        }

        int nextIndex = index + 1;
        if (index == _lines.Count - 1)
        {
            AddLine();
        }

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", $"mm-po-detail-product-{nextIndex}");
        }
        catch
        {
            /* ignore */
        }
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private sealed class LineEdit
    {
        public string ProductId { get; set; } = string.Empty;
        public string? ProductName { get; set; }
        public decimal Quantity { get; set; }
        public decimal BonusQuantity { get; set; }
        public decimal PurchasePriceRs { get; set; }
        public decimal RetailPriceRs { get; set; }
        public string BatchNumber { get; set; } = string.Empty;
        public DateOnly? ExpiryDate { get; set; }
        public string RackLocation { get; set; } = string.Empty;
    }
}
