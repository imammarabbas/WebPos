@page "/master/purchases/{PurchaseOrderId:guid}"
@layout MasterLayout
@attribute [Authorize(Roles = "Owner,Manager")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using WebPos.Core.Abstractions
@inject IPurchaseService PurchaseService
@inject IPartyService PartyService
@inject IProductAdminService ProductService
@inject NavigationManager Navigation

<PageTitle>Purchase @_detail?.SupplierInvoiceNo · Copenhagen Mart</PageTitle>

<div class="mm-page">
    <div class="mm-page-header">
        <div>
            <h1>@(IsOpen ? "Edit purchase order" : "Purchase order")</h1>
            <p>
                @if (_detail is not null)
                {
                    <text>@_detail.SupplierInvoiceNo · @(_detail.IsReceived ? "Received" : "Open") · @_detail.PaymentStatus</text>
                }
                else
                {
                    <text>Loading…</text>
                }
            </p>
        </div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
            <a class="mm-btn" href="/master/purchases">← Back to list</a>
            @if (IsOpen)
            {
                <button type="button" class="mm-btn mm-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save changes")
                </button>
                <button type="button" class="mm-btn" disabled="@_saving" @onclick="ReceiveAsync">Receive stock</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mm-alert mm-alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="mm-alert mm-alert-ok">@_success</div>
    }

    @if (_detail is null && string.IsNullOrEmpty(_error))
    {
        <p class="mm-muted">Loading purchase…</p>
    }
    else if (_detail is not null)
    {
        <div class="mm-card">
            <h2>Header</h2>
            <div class="mm-form-grid">
                <div class="mm-field">
                    <label>Supplier invoice #</label>
                    @if (IsOpen)
                    {
                        <input class="form-control" @bind="_invoiceNo" />
                    }
                    else
                    {
                        <div class="mm-kpi-value" style="font-size:1.1rem;">@_detail.SupplierInvoiceNo</div>
                    }
                </div>
                <div class="mm-field">
                    <label>Supplier</label>
                    @if (IsOpen)
                    {
                        <select class="form-control" @bind="_supplierId">
                            @foreach (PartyDto s in _suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div>@(_detail.SupplierName ?? _detail.SupplierId.ToString("N")[..8])</div>
                    }
                </div>
                <div class="mm-field">
                    <label>Purchase date</label>
                    @if (IsOpen)
                    {
                        <input class="form-control" type="date" @bind="_purchaseDate" />
                    }
                    else
                    {
                        <div>@_detail.CreatedAt.ToLocalTime().ToString("g")</div>
                    }
                </div>
                <div class="mm-field">
                    <label>Discount (Rs)</label>
                    @if (IsOpen)
                    {
                        <input class="form-control" type="number" step="0.01" @bind="_discountRs" />
                    }
                    else
                    {
                        <div>Rs @FormatRs(_detail.DiscountPaisa)</div>
                    }
                </div>
                <div class="mm-field">
                    <label>Subtotal</label>
                    <div>Rs @FormatRs(_detail.SubTotalPaisa)</div>
                </div>
                <div class="mm-field">
                    <label>Net payable</label>
                    <div class="mm-kpi-value" style="font-size:1.25rem;">Rs @FormatRs(_detail.NetPayablePaisa)</div>
                </div>
            </div>
        </div>

        <div class="mm-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 style="margin:0;">Lines</h2>
                @if (IsOpen)
                {
                    <button type="button" class="mm-btn" @onclick="AddLine">+ Line</button>
                }
            </div>
            <div class="mm-table-wrap">
                <table class="mm-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Bonus</th>
                            <th>Cost</th>
                            <th>Retail</th>
                            <th>Batch</th>
                            <th>Expiry</th>
                            <th>Rack</th>
                            @if (IsOpen)
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _lines.Count; i++)
                        {
                            int index = i;
                            LineEdit line = _lines[index];
                            <tr>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <select class="form-control" @bind="line.ProductId">
                                            <option value="">— Select —</option>
                                            @foreach (ProductAdminDto p in _products)
                                            {
                                                <option value="@p.Id">@p.Name (@p.Sku)</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @(line.ProductName ?? line.ProductId)
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.001" @bind="line.Quantity" />
                                    }
                                    else
                                    {
                                        @line.Quantity.ToString("N3")
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.001" @bind="line.BonusQuantity" />
                                    }
                                    else
                                    {
                                        @line.BonusQuantity.ToString("N3")
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.01" @bind="line.PurchasePriceRs" />
                                    }
                                    else
                                    {
                                        <text>Rs @line.PurchasePriceRs.ToString("N2")</text>
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="number" step="0.01" @bind="line.RetailPriceRs" />
                                    }
                                    else
                                    {
                                        <text>Rs @line.RetailPriceRs.ToString("N2")</text>
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" @bind="line.BatchNumber" />
                                    }
                                    else
                                    {
                                        @line.BatchNumber
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" type="date" @bind="line.ExpiryDate" />
                                    }
                                    else
                                    {
                                        @(line.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
                                    }
                                </td>
                                <td>
                                    @if (IsOpen)
                                    {
                                        <input class="form-control" @bind="line.RackLocation" />
                                    }
                                    else
                                    {
                                        @(line.RackLocation ?? "—")
                                    }
                                </td>
                                @if (IsOpen)
                                {
                                    <td>
                                        <button type="button" class="mm-btn mm-btn-danger" @onclick="() => RemoveLine(index)">✕</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid PurchaseOrderId { get; set; }

    private PurchaseOrderDetailDto? _detail;
    private readonly List<PartyDto> _suppliers = [];
    private readonly List<ProductAdminDto> _products = [];
    private readonly List<LineEdit> _lines = [];
    private string _invoiceNo = string.Empty;
    private string _supplierId = string.Empty;
    private DateOnly _purchaseDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal _discountRs;
    private bool _saving;
    private string? _error;
    private string? _success;

    private bool IsOpen => _detail is { IsReceived: false };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _success = null;
        try
        {
            if (_suppliers.Count == 0)
            {
                IReadOnlyList<PartyDto> suppliers = await PartyService.GetSuppliersAsync();
                _suppliers.Clear();
                _suppliers.AddRange(suppliers);
            }

            if (_products.Count == 0)
            {
                IReadOnlyList<ProductAdminDto> products = await ProductService.ListAsync();
                _products.Clear();
                _products.AddRange(products);
            }

            PurchaseOrderDetailDto? detail = await PurchaseService.GetAsync(PurchaseOrderId);
            if (detail is null)
            {
                _detail = null;
                _error = "Purchase order not found.";
                return;
            }

            ApplyDetail(detail);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ApplyDetail(PurchaseOrderDetailDto detail)
    {
        _detail = detail;
        _invoiceNo = detail.SupplierInvoiceNo;
        _supplierId = detail.SupplierId.ToString();
        _purchaseDate = DateOnly.FromDateTime(detail.CreatedAt.UtcDateTime);
        _discountRs = detail.DiscountPaisa / 100m;
        _lines.Clear();
        foreach (PurchaseOrderLineDto line in detail.Lines)
        {
            _lines.Add(new LineEdit
            {
                ProductId = line.ProductId.ToString(),
                ProductName = line.ProductName,
                Quantity = line.Quantity,
                BonusQuantity = line.BonusQuantity,
                PurchasePriceRs = line.PurchasePricePaisa / 100m,
                RetailPriceRs = line.RetailPricePaisa / 100m,
                BatchNumber = line.BatchNumber,
                ExpiryDate = line.ExpiryDate,
                RackLocation = line.RackLocation ?? string.Empty
            });
        }
    }

    private void AddLine() =>
        _lines.Add(new LineEdit
        {
            ProductId = string.Empty,
            Quantity = 1,
            PurchasePriceRs = 0,
            RetailPriceRs = 0,
            BatchNumber = string.Empty,
            RackLocation = string.Empty
        });

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < _lines.Count)
        {
            _lines.RemoveAt(index);
        }
    }

    private async Task SaveAsync()
    {
        if (_detail is null || !IsOpen)
        {
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        try
        {
            UpdateOpenPurchaseRequest request = BuildUpdateRequest();
            PurchaseOrderDetailDto updated = await PurchaseService.UpdateOpenPurchaseAsync(
                PurchaseOrderId,
                request);
            ApplyDetail(updated);
            _success = "Purchase order saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReceiveAsync()
    {
        if (_detail is null || !IsOpen)
        {
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        try
        {
            // Persist edits before receiving so stock matches the form.
            UpdateOpenPurchaseRequest request = BuildUpdateRequest();
            await PurchaseService.UpdateOpenPurchaseAsync(PurchaseOrderId, request);
            await PurchaseService.ReceiveStockAsync(PurchaseOrderId);
            PurchaseOrderDetailDto? detail = await PurchaseService.GetAsync(PurchaseOrderId);
            if (detail is not null)
            {
                ApplyDetail(detail);
            }

            _success = "Stock received — inventory and AP updated.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private UpdateOpenPurchaseRequest BuildUpdateRequest()
    {
        if (!Guid.TryParse(_supplierId, out Guid supplierId) || supplierId == Guid.Empty)
        {
            throw new InvalidOperationException("Select a supplier.");
        }

        List<CreatePurchaseLineRequest> lines = [];
        foreach (LineEdit line in _lines)
        {
            if (!Guid.TryParse(line.ProductId, out Guid productId) || productId == Guid.Empty)
            {
                throw new InvalidOperationException("Each line needs a product.");
            }

            lines.Add(new CreatePurchaseLineRequest
            {
                ProductId = productId,
                Quantity = line.Quantity,
                BonusQuantity = line.BonusQuantity,
                PurchasePricePaisa = (long)Math.Round(line.PurchasePriceRs * 100m, MidpointRounding.AwayFromZero),
                RetailPricePaisa = (long)Math.Round(line.RetailPriceRs * 100m, MidpointRounding.AwayFromZero),
                BatchNumber = line.BatchNumber?.Trim() ?? string.Empty,
                ExpiryDate = line.ExpiryDate,
                RackLocation = string.IsNullOrWhiteSpace(line.RackLocation) ? null : line.RackLocation.Trim()
            });
        }

        return new UpdateOpenPurchaseRequest
        {
            SupplierInvoiceNo = _invoiceNo.Trim(),
            SupplierId = supplierId,
            PurchaseDate = new DateTimeOffset(_purchaseDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
            DiscountPaisa = (long)Math.Round(_discountRs * 100m, MidpointRounding.AwayFromZero),
            Lines = lines
        };
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private sealed class LineEdit
    {
        public string ProductId { get; set; } = string.Empty;
        public string? ProductName { get; set; }
        public decimal Quantity { get; set; }
        public decimal BonusQuantity { get; set; }
        public decimal PurchasePriceRs { get; set; }
        public decimal RetailPriceRs { get; set; }
        public string BatchNumber { get; set; } = string.Empty;
        public DateOnly? ExpiryDate { get; set; }
        public string RackLocation { get; set; } = string.Empty;
    }
}
