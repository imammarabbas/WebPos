    private void EditParty(PartyDto p)
    {
        _editingPartyId = p.Id;
        _partyForm = new PartyForm
        {
            Name = p.Name,
            PhoneNumber = p.PhoneNumber,
            Address = p.Address,
            CreditLimitRs = p.CreditLimitPaisa / 100m
        };
    }

    private async Task SavePartyAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            long creditPaisa = (long)Math.Round(_partyForm.CreditLimitRs * 100m, MidpointRounding.AwayFromZero);
            if (_editingPartyId is Guid id)
            {
                await PartyService.UpdatePartyAsync(id, new UpdatePartyRequest
                {
                    Name = _partyForm.Name.Trim(),
                    PhoneNumber = _partyForm.PhoneNumber.Trim(),
                    Address = _partyForm.Address.Trim(),
                    CreditLimitPaisa = creditPaisa
                });
                _success = "Party updated.";
            }
            else
            {
                await PartyService.CreatePartyAsync(new CreatePartyRequest
                {
                    Role = _manageRole,
                    Name = _partyForm.Name.Trim(),
                    PhoneNumber = _partyForm.PhoneNumber.Trim(),
                    Address = _partyForm.Address.Trim(),
                    CreditLimitPaisa = creditPaisa
                });
                _success = "Party created.";
            }

            _editingPartyId = null;
            _partyForm = new PartyForm();
            await LoadManagePartiesAsync();
            await ReloadShellAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);

    private static string FormatFundingLabel(
        CashAccountDto account,
        IReadOnlyDictionary<string, long> spendableByCode)
    {
        string name;
        if (account.Type == CashAccountType.Till)
        {
            string term = string.IsNullOrWhiteSpace(account.TerminalName)
                ? account.Name
                : account.TerminalName;
            name = $"Till — {term}";
        }
        else
        {
            name = account.Name;
        }

        if (spendableByCode.TryGetValue(account.AccountCode, out long spendable))
        {
            return $"{name} — Available Rs {FormatRs(spendable)}";
        }

        return name;
    }

    private static string FormatShift(OpenShiftDto s) =>
        $"{s.CashierName} · {s.TerminalName ?? s.TerminalId.ToString()[..8]} · Rs {FormatRs(s.ExpectedCashPaisa)}";

