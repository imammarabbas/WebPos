    private async Task ShareWhatsApp()
    {
        if (_selectedParty is null || _dashboard is null)
        {
            return;
        }

        string phone = new string(_selectedParty.PhoneNumber.Where(char.IsDigit).ToArray());
        if (phone.StartsWith("0"))
        {
            phone = "92" + phone[1..];
        }

        string text =
            $"*Statement — {_dashboard.PartyName}*%0A" +
            $"Opening: Rs {FormatRs(_dashboard.OpeningBalancePaisa)}%0A" +
            $"Paid: Rs {FormatRs(_dashboard.PaidPaisa)}%0A" +
            $"Closing: Rs {FormatRs(_dashboard.ClosingBalancePaisa)}%0A" +
            $"— Cone Mart";
        string url = string.IsNullOrWhiteSpace(phone)
            ? $"https://wa.me/?text={text}"
            : $"https://wa.me/{phone}?text={text}";
        await Js.InvokeVoidAsync("open", url, "_blank");
    }

