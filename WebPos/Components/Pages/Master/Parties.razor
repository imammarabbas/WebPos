    private async Task RecordAsync()
    {
        _saving = true;
        _error = null;
        _success = null;
        try
        {
            if (_partyId is not Guid partyId)
            {
                _error = "Select a party.";
                return;
            }

            long amountPaisa = (long)Math.Round(_amountRs * 100m, MidpointRounding.AwayFromZero);
            long discountPaisa = (long)Math.Round(_discountRs * 100m, MidpointRounding.AwayFromZero);
            if (amountPaisa <= 0)
            {
                _error = "Enter an amount greater than zero.";
                return;
            }

            if (!IsCustomerContext
                && _payKind == "PAYMENT"
                && string.IsNullOrWhiteSpace(_reference))
            {
                _error = "Reference / invoice ID is required for supplier payments.";
                return;
            }

            if (_payKind == "PAYMENT"
                && ShowsFundingSource
                && _fundingSpendablePaisa.TryGetValue(_fundingAccountCode, out long available)
                && amountPaisa > available)
            {
                _error = InsufficientCashBalanceException.StandardMessage;
                return;
            }

            if (_payKind == "ADJUSTMENT")
            {
                string notes = string.IsNullOrWhiteSpace(_notes) ? "Adjustment" : _notes.Trim();
                if (!string.IsNullOrWhiteSpace(_reference))
                {
                    notes = $"{_reference.Trim()} — {notes}";
                }

                await ProcurementService.RecordPartyAdjustmentAsync(new RecordPartyAdjustmentRequest
                {
                    PartyId = partyId,
                    AmountPaisa = amountPaisa,
                    IncreaseBalance = false,
                    Notes = notes
                });
                _success = "Adjustment recorded.";
            }
            else
            {
                if (_payMethod == "CASH")
                {
                    if (string.IsNullOrWhiteSpace(_fundingAccountCode))
                    {
                        _error = "Select a funding source.";
                        return;
                    }

                    if (IsTillFunding && !Guid.TryParse(_selectedShiftId, out _))
                    {
                        _error = "Select an open till/shift for till-funded payments.";
                        return;
                    }
                }

                bool isAdvance = _payKind == "ADVANCE";
                List<PaymentAllocationRequest> allocations = [];
                if (!isAdvance)
                {
                    foreach (OpenSlipRow row in _openSlips)
                    {
                        long allocPaisa = (long)Math.Round(row.AllocateRs * 100m, MidpointRounding.AwayFromZero);
                        if (allocPaisa <= 0)
                        {
                            continue;
                        }

                        if (IsCustomerContext)
                        {
                            allocations.Add(new PaymentAllocationRequest
                            {
                                InvoiceNo = row.InvoiceNo,
                                AmountPaisa = allocPaisa
                            });
                        }
                        else if (row.PurchaseOrderId is Guid poId)
                        {
                            allocations.Add(new PaymentAllocationRequest
                            {
                                PurchaseOrderId = poId,
                                AmountPaisa = allocPaisa
                            });
                        }
                    }
                }

                string baseRef = string.IsNullOrWhiteSpace(_reference)
                    ? $"PAY-{DateTime.UtcNow:yyyyMMddHHmmss}"
                    : _reference.Trim();
                if (isAdvance && !baseRef.StartsWith("ADV-", StringComparison.OrdinalIgnoreCase))
                {
                    baseRef = $"ADV-{baseRef}";
                }

                if (!string.IsNullOrWhiteSpace(_notes))
                {
                    baseRef = $"{baseRef} — {_notes.Trim()}";
                }

                string? accountCode = _payMethod == "CASH" ? _fundingAccountCode : null;
                Guid? shiftId = IsTillFunding && Guid.TryParse(_selectedShiftId, out Guid sid)
                    ? sid
                    : null;

                if (IsCustomerContext)
                {
                    await ProcurementService.RecordCustomerPaymentAsync(new RecordCustomerPaymentRequest
                    {
                        CustomerId = partyId,
                        AmountPaisa = amountPaisa,
                        PaymentMethod = _payMethod,
                        ReferenceNo = baseRef,
                        ShiftId = shiftId,
                        AccountCode = accountCode,
                        Allocations = allocations.Count > 0 ? allocations : null
                    });
                }
                else
                {
                    await ProcurementService.RecordSupplierPaymentAsync(new RecordSupplierPaymentRequest
                    {
                        SupplierId = partyId,
                        AmountPaisa = amountPaisa,
                        PaymentMethod = _payMethod,
                        ReferenceNo = baseRef,
                        ShiftId = shiftId,
                        AccountCode = accountCode,
                        Allocations = allocations.Count > 0 ? allocations : null
                    });
                }

                if (discountPaisa > 0)
                {
                    await ProcurementService.RecordPartyAdjustmentAsync(new RecordPartyAdjustmentRequest
                    {
                        PartyId = partyId,
                        AmountPaisa = discountPaisa,
                        IncreaseBalance = false,
                        Notes = $"DISCOUNT — {baseRef}"
                    });
                }

                _success = isAdvance ? "Advance recorded." : "Payment recorded.";
            }

            _amountRs = 0;
            _discountRs = 0;
            _reference = string.Empty;
            _notes = string.Empty;
            foreach (OpenSlipRow row in _openSlips)
            {
                row.AllocateRs = 0;
            }

            await ReloadShellAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

