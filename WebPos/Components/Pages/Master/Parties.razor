    private void OnMethodChanged()
    {
        if (_payMethod != "CASH")
        {
            _selectedShiftId = string.Empty;
            return;
        }

        PreferActiveTillForCash();
        OnFundingChanged();
    }

    private void OnFundingChanged()
    {
        if (!IsTillFunding)
        {
            _selectedShiftId = string.Empty;
            return;
        }

        CashAccountDto? till = _fundingAccounts.FirstOrDefault(a =>
            a.AccountCode.Equals(_fundingAccountCode, StringComparison.OrdinalIgnoreCase));
        if (till?.TerminalId is Guid terminalId)
        {
            OpenShiftDto? match = _openShifts.FirstOrDefault(s => s.TerminalId == terminalId);
            if (match is not null)
            {
                _selectedShiftId = match.ShiftId.ToString();
            }
        }
    }

    /// <summary>
    /// Supplier/customer Method=CASH defaults to the live till (open shift), not Owner.
    /// </summary>
    private void PreferActiveTillForCash()
    {
        if (_payMethod != "CASH" || _payKind == "ADJUSTMENT" || _fundingAccounts.Count == 0)
        {
            return;
        }

        CashAccountDto? liveTill = _fundingAccounts.FirstOrDefault(a =>
            a.Type == CashAccountType.Till
            && a.IsActive
            && a.TerminalId is Guid tid
            && _openShifts.Any(s => s.TerminalId == tid));

        if (liveTill is null)
        {
            if (!_fundingAccounts.Any(a =>
                    a.AccountCode.Equals(_fundingAccountCode, StringComparison.OrdinalIgnoreCase)))
            {
                _fundingAccountCode = _fundingAccounts
                    .FirstOrDefault(a => a.AccountCode.Equals("OWNER_CASH", StringComparison.OrdinalIgnoreCase))
                    ?.AccountCode
                    ?? _fundingAccounts[0].AccountCode;
            }

            return;
        }

        _fundingAccountCode = liveTill.AccountCode;
        OpenShiftDto? shift = _openShifts.FirstOrDefault(s => s.TerminalId == liveTill.TerminalId);
        _selectedShiftId = shift?.ShiftId.ToString() ?? string.Empty;
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            _recent.Clear();
            _recent.AddRange(await LedgerService.ListRecentPaymentsAsync(
                ActiveRole,
                search: string.IsNullOrWhiteSpace(_recentSearch) ? null : _recentSearch));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadOpenSlipsAsync(Guid partyId)
    {
        _openSlips.Clear();
        try
        {
            DateTimeOffset now = DateTimeOffset.UtcNow;
            foreach (OpenPartySlipDto slip in await LedgerService.ListOpenSlipsAsync(partyId))
            {
                _openSlips.Add(new OpenSlipRow
                {
                    InvoiceNo = slip.InvoiceNo,
                    PurchaseOrderId = slip.PurchaseOrderId,
                    Reference = slip.Reference,
                    OutstandingPaisa = slip.OutstandingPaisa,
                    AgeDays = Math.Max(0, (int)(now - slip.CreatedAt).TotalDays)
                });
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetLedgerRangeAsync(string range)
    {
        _ledgerRange = range;
        await LoadLedgerAsync();
        PushUrl();
    }

    private (DateTimeOffset From, DateTimeOffset To) ResolveLedgerWindow()
    {
        DateTimeOffset to = DateTimeOffset.UtcNow;
        DateTimeOffset from = _ledgerRange switch
        {
            "today" => DateTime.UtcNow.Date,
            "7" => to.AddDays(-7),
            "30" => to.AddDays(-30),
            _ => new DateTimeOffset(2000, 1, 1, 0, 0, 0, TimeSpan.Zero)
        };
        return (from, to);
    }

    private async Task LoadLedgerAsync()
    {
        _dashboard = null;
        _ageing = null;
        if (_partyId is not Guid partyId)
        {
            return;
        }

        try
        {
            (DateTimeOffset from, DateTimeOffset to) = ResolveLedgerWindow();
            _dashboard = await LedgerService.GetLedgerDashboardAsync(partyId, from, to);
            _ageing = await LedgerService.GetAgeingAsync(partyId);
            SyncSelectedParty();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

