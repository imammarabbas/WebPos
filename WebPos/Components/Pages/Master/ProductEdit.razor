        public string Barcode { get; set; } = string.Empty;
        public string ShortCode { get; set; } = string.Empty;
        public string CategoryId { get; set; } = string.Empty;
        public string Brand { get; set; } = string.Empty;
        public bool ShowOnWebshop { get; set; }
        public bool ShowOnPosQuick { get; set; }
        public int PosQuickSort { get; set; }
        public string BaseUnit { get; set; } = "PCS";
        public string PurchaseUnit { get; set; } = string.Empty;
        public int ConversionMultiplier { get; set; } = 1;
        public decimal MinStockQty { get; set; } = 10m;
        public string ParentProductId { get; set; } = string.Empty;
        public decimal? DeductionMultiplier { get; set; }
        public string PackSizeText { get; set; } = string.Empty;
        public decimal? CostRs { get; set; }
        public decimal? RetailRs { get; set; }
        public decimal? CurrentStockQty { get; set; }
        public decimal DefaultMarginPercent { get; set; } = 20m;
        public decimal MarginPercent { get; set; } = 20m;
    }
