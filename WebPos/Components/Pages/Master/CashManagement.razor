    private void PrefillShortage(CashAccountCardDto card, long gapPaisa)
    {
        ClearMovementForm();
        _shortageTillId = card.Account.Id;
        _shortageShiftId = card.OpenShiftId ?? Guid.Empty;
        _shortageRs = gapPaisa / 100m;
        _shortageNotes = "Cash shortage — ledger vs drawer";
        _fromAccountId = card.Account.Id.ToString();
    }

    private void PrefillCashDrop(CashAccountCardDto card)
    {
        _fromAccountId = card.Account.Id.ToString();
        CashAccountDto? owner = PickAccount("owner");
        if (owner is not null)
        {
            _toAccountId = owner.Id.ToString();
        }

        long drawer = card.DrawerExpectedCashPaisa ?? 0;
        long spendable = card.SpendablePaisa;
        _amountRs = spendable / 100m;
        _notes = "Cash drop — physical drawer to owner safe";
        ClearShortageForm();
        ClearMovementForm();
    }

    private void ClearShortageForm()
    {
        _shortageTillId = Guid.Empty;
        _shortageShiftId = Guid.Empty;
        _shortageRs = 0;
        _shortageNotes = string.Empty;
    }

    private async Task PostShortageAsync()
    {
        _saving = true;
        _error = null;
        _success = null;
        try
        {
            if (_shortageTillId == Guid.Empty || _shortageShiftId == Guid.Empty)
            {
                _error = "Select a till with an open shift for shortage posting.";
                return;
            }

            long shortagePaisa = (long)Math.Round(_shortageRs * 100m, MidpointRounding.AwayFromZero);
            if (shortagePaisa <= 0)
            {
                _error = "Enter a shortage greater than zero.";
                return;
            }

            TillShortageResult result = await CashTransfers.RecordTillShortageAsync(
                new RecordTillShortageRequest
                {
                    ShiftId = _shortageShiftId,
                    TillCashAccountId = _shortageTillId,
                    ShortagePaisa = shortagePaisa,
                    Notes = string.IsNullOrWhiteSpace(_shortageNotes) ? null : _shortageNotes
                });

            _success = $"Shortage {result.ReferenceNo} posted ({FormatRs(result.ShortagePaisa)} Rs).";
            ClearShortageForm();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PostFundingAsync()
    {
        _saving = true;
        _error = null;
        _success = null;
        try
        {
            if (!Guid.TryParse(_fundAccountId, out Guid accountId))
            {
                _error = "Select an account.";
                return;
            }

            long amountPaisa = (long)Math.Round(_fundRs * 100m, MidpointRounding.AwayFromZero);
            if (amountPaisa <= 0)
            {
                _error = "Enter an amount greater than zero.";
                return;
            }

            CashAccountCardDto? card = _summary?.Accounts.FirstOrDefault(c => c.Account.Id == accountId);
            Guid? shiftId = card?.OpenShiftId;

            var request = new CapitalFundingRequest
            {
                CashAccountId = accountId,
                AmountPaisa = amountPaisa,
                Note = string.IsNullOrWhiteSpace(_fundNote) ? null : _fundNote,
                ShiftId = shiftId
            };

            CapitalFundingResult result = _fundKind switch
            {
                "loan-in" => await CashTransfers.RecordLoanReceivedAsync(request),
                "loan-out" => await CashTransfers.RecordLoanRepaymentAsync(request),
                _ => await CashTransfers.RecordOwnerInvestmentAsync(request)
            };

            _success = $"{result.TransactionType} {result.ReferenceNo} posted ({FormatRs(result.AmountPaisa)} Rs).";
            _fundRs = 0;
            _fundNote = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void PrefillTransfer(string fromKind, string toKind)
    {
        CashAccountDto? from = PickAccount(fromKind);
        CashAccountDto? to = PickAccount(toKind);
        if (from is not null)
        {
            _fromAccountId = from.Id.ToString();
        }

        if (to is not null)
        {
            _toAccountId = to.Id.ToString();
        }
    }

    private CashAccountDto? PickAccount(string kind) =>
        kind switch
        {
            "till" => _accounts.FirstOrDefault(a => a.Type == CashAccountType.Till && a.IsActive),
            "bank" => _accounts.FirstOrDefault(a =>
                a.IsActive && (a.AccountCode.Equals("BANK", StringComparison.OrdinalIgnoreCase)
                    || a.Type == CashAccountType.Bank)),
            "owner" => _accounts.FirstOrDefault(a =>
                a.IsActive && (a.AccountCode.Equals("OWNER_CASH", StringComparison.OrdinalIgnoreCase)
                    || a.Type == CashAccountType.Owner)),
            _ => null
        };

    private async Task OnCardKeyAsync(KeyboardEventArgs e, CashAccountCardDto card)
    {
        if (e.Key is "Enter" or " ")
        {
            await OpenLedgerAsync(card);
        }
    }

    private async Task OpenLedgerAsync(CashAccountCardDto card)
    {
        _ledgerOpen = true;
        _ledgerTitle = card.Account.Name;
        _ledgerAccountCode = card.Account.AccountCode;
        _ledgerPreset = "30";
        ApplyPresetDates("30");
        await LoadLedgerAsync();
    }

    private void CloseLedger()
    {
        _ledgerOpen = false;
        _ledger = null;
        _ledgerError = null;
    }

    private async Task SetLedgerPresetAsync(string preset)
    {
        _ledgerPreset = preset;
        if (preset != "custom")
        {
            ApplyPresetDates(preset);
            await LoadLedgerAsync();
        }
    }

    private void ApplyPresetDates(string preset)
    {
        DateTime today = DateTime.Today;
        (DateTime from, DateTime to) = preset switch
        {
            "today" => (today, today),
            "7" => (today.AddDays(-6), today),
            "30" => (today.AddDays(-29), today),
            _ => (
                DateTime.TryParse(_ledgerFromDate, out DateTime f) ? f : today.AddDays(-29),
                DateTime.TryParse(_ledgerToDate, out DateTime t) ? t : today)
        };
        _ledgerFromDate = from.ToString("yyyy-MM-dd");
        _ledgerToDate = to.ToString("yyyy-MM-dd");
    }

    private async Task LoadLedgerAsync()
    {
        if (string.IsNullOrWhiteSpace(_ledgerAccountCode))
        {
            return;
        }

        _ledgerLoading = true;
        _ledgerError = null;
        try
        {
            if (!DateTime.TryParse(_ledgerFromDate, out DateTime fromDate)
                || !DateTime.TryParse(_ledgerToDate, out DateTime toDate))
            {
                _ledgerError = "Enter valid from/to dates.";
                return;
            }

            DateTimeOffset from = new(fromDate.Year, fromDate.Month, fromDate.Day, 0, 0, 0, TimeSpan.Zero);
            DateTimeOffset to = new(toDate.Year, toDate.Month, toDate.Day, 23, 59, 59, TimeSpan.Zero);
            _ledger = await CashAccounts.GetLedgerByAccountCodeAsync(_ledgerAccountCode, from, to);
        }
        catch (Exception ex)
        {
            _ledgerError = ex.InnerException?.Message ?? ex.Message;
            _ledger = null;
        }
        finally
        {
            _ledgerLoading = false;
        }
    }

    private async Task TransferAsync()
    {
        _saving = true;
        _error = null;
        _success = null;
        try
        {
            if (!Guid.TryParse(_fromAccountId, out Guid fromId)
                || !Guid.TryParse(_toAccountId, out Guid toId))
            {
                _error = "Select both From and To accounts.";
                return;
            }

            long amountPaisa = (long)Math.Round(_amountRs * 100m, MidpointRounding.AwayFromZero);
            if (amountPaisa <= 0)
            {
                _error = "Enter an amount greater than zero.";
                return;
            }

            CashAccountCardDto? fromCard = _summary?.Accounts.FirstOrDefault(c => c.Account.Id == fromId);
            if (fromCard is not null)
            {
                long spendable = fromCard.Account.Type == CashAccountType.Till
                    ? fromCard.SpendablePaisa
                    : Math.Max(0, fromCard.DerivedGlBalancePaisa);
                if (amountPaisa > spendable)
                {
                    _error =
                        $"Insufficient spendable funds. Available Rs {FormatRs(spendable)} " +
                        $"({spendable} paisa), requested Rs {FormatRs(amountPaisa)} ({amountPaisa} paisa).";
                    return;
                }
            }

            CashTransferResult result = await CashTransfers.TransferAsync(
                fromId,
                toId,
                amountPaisa,
                string.IsNullOrWhiteSpace(_notes) ? null : _notes);

            _success = $"Transfer {result.ReferenceNo} posted.";
            _amountRs = 0;
            _notes = string.Empty;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

