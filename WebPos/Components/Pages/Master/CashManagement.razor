    private static string DisplayReference(CashAccountLedgerEntryDto row) =>
        string.IsNullOrWhiteSpace(row.ReferenceDetails)
            ? row.ReferenceNo
            : $"{row.ReferenceNo} · {row.ReferenceDetails}";

    private static bool TryBuildReferenceHref(CashAccountLedgerEntryDto row, out string? href)
    {
        href = null;
        string type = row.TransactionType ?? string.Empty;
        string refNo = row.ReferenceNo ?? string.Empty;
        if (type.Contains("SALE", StringComparison.OrdinalIgnoreCase)
            || refNo.StartsWith("INV-", StringComparison.OrdinalIgnoreCase))
        {
            href = $"/master/reports?invoice={Uri.EscapeDataString(refNo)}";
            return true;
        }

        if (type.Contains("PURCHASE", StringComparison.OrdinalIgnoreCase)
            || type.Contains("SUPPLIER", StringComparison.OrdinalIgnoreCase))
        {
            href = "/master/parties?tab=supplier-ledger";
            return true;
        }

        return false;
    }

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);
}
