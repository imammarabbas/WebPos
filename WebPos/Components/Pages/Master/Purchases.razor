@page "/master/purchases"
@layout MasterLayout
@attribute [Authorize(Roles = "Owner,Manager")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using WebPos.Core.Abstractions
@inject IPurchaseService PurchaseService
@inject IPartyService PartyService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime Js

<link rel="stylesheet" href="po-master.css" />

<PageTitle>Purchase Orders · Cone Mart</PageTitle>

<div class="mm-page po-page">
    <div class="po-page-header">
        <div class="po-page-header-left">
            <div class="po-icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" stroke-linecap="round" />
                </svg>
            </div>
            <div>
                <h1>Purchase Orders</h1>
                <p>View, manage and track all purchase orders</p>
            </div>
        </div>
        <button type="button" class="po-btn po-btn-primary" @onclick="ShowCreate">+ New Purchase Order</button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mm-alert mm-alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="mm-alert mm-alert-ok">@_success</div>
    }

    <div class="po-card">
        <div class="po-filter-row">
            <div class="po-field">
                <label for="po-search">Search</label>
                <input id="po-search"
                       class="form-control"
                       placeholder="Search PO No / Supplier / Item…"
                       @bind="_filter"
                       @bind:event="oninput"
                       @bind:after="OnFilterChanged" />
            </div>
            <div class="po-field">
                <label for="po-from">Date From</label>
                <input id="po-from" class="form-control" type="date" @bind="_dateFrom" @bind:after="OnFilterChanged" />
            </div>
            <div class="po-field">
                <label for="po-to">Date To</label>
                <input id="po-to" class="form-control" type="date" @bind="_dateTo" @bind:after="OnFilterChanged" />
            </div>
            <div class="po-field">
                <label for="po-status">Status</label>
                <select id="po-status" class="form-control" @bind="_statusFilter" @bind:after="OnFilterChanged">
                    <option value="all">All</option>
                    <option value="open">Open</option>
                    <option value="received">Received</option>
                </select>
            </div>
            <div class="po-filter-actions">
                <button type="button" class="po-btn po-btn-primary" @onclick="ApplySearch">Search</button>
                <button type="button" class="po-btn po-btn-outline" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    @if (_showForm)
    {
        <div class="po-card" style="margin-top:1rem;">
            <h2>Create purchase order</h2>
            <EditForm Model="_form" OnValidSubmit="CreateAsync">
                <div class="mm-form-grid">
                    <div class="mm-field po-field">
                        <label for="po-supplier">Supplier</label>
                        <InputSelect id="po-supplier" class="form-control" @bind-Value="_form.SupplierId">
                            <option value="">— Select —</option>
                            @foreach (PartyDto s in _suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mm-field po-field">
                        <label for="po-invoice">Purchase order nr</label>
                        <InputText id="po-invoice" class="form-control" @bind-Value="_form.SupplierInvoiceNo" placeholder="e.g. PO-20260913-001" />
                    </div>
                    <div class="mm-field po-field">
                        <label for="po-date">Purchase date</label>
                        <InputDate id="po-date" class="form-control" @bind-Value="_form.PurchaseDate" />
                    </div>
                    <div class="mm-field po-field">
                        <label for="po-discount">Discount (Rs)</label>
                        <InputNumber id="po-discount" class="form-control" @bind-Value="_form.DiscountRs" />
                    </div>
                </div>

                <div class="mm-line-editor">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Lines</strong>
                        <button type="button" class="po-btn po-btn-outline" @onclick="AddLine">+ Line</button>
                    </div>
                    @for (int i = 0; i < _form.Lines.Count; i++)
                    {
                        int index = i;
                        LineForm line = _form.Lines[index];
                        <div class="mm-line-row">
                            <div class="mm-field po-field">
                                <label>Product</label>
                                <ProductSearchBox InputId="@($"mm-po-product-{index}")"
                                                  ProductId="@line.ProductId"
                                                  ProductIdChanged="v => line.ProductId = v ?? string.Empty"
                                                  SelectedLabel="@line.ProductLabel"
                                                  SelectedLabelChanged="v => line.ProductLabel = v ?? string.Empty"
                                                  OnSelected="p => OnLineProductSelectedAsync(index, p)"
                                                  MastersOnly="true"
                                                  Disabled="@_saving" />
                            </div>
                            <div class="mm-field po-field">
                                <label>Qty</label>
                                <InputNumber class="form-control" @bind-Value="line.Quantity" />
                            </div>
                            <div class="mm-field po-field">
                                <label>Cost (Rs)</label>
                                <InputNumber class="form-control" @bind-Value="line.PurchasePriceRs" />
                            </div>
                            <div class="mm-field po-field">
                                <label>Retail (Rs)</label>
                                <InputNumber class="form-control" @bind-Value="line.RetailPriceRs" />
                            </div>
                            <button type="button" class="mm-btn mm-btn-danger" @onclick="() => RemoveLine(index)">✕</button>
                        </div>
                    }
                </div>

                <div class="mm-form-actions">
                    <button type="submit" class="po-btn po-btn-primary" disabled="@_saving">
                        @(_saving ? "Creating…" : "Create PO")
                    </button>
                    <button type="button" class="po-btn" @onclick="HideCreate" disabled="@_saving">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    <div class="po-card" style="margin-top:1rem;">
        <div class="po-table-wrap">
            <table class="po-table">
                <thead>
                    <tr>
                        <th>PO No.</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th class="po-num">Items</th>
                        <th class="po-num">Total (Rs)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PageRows.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;color:var(--po-muted);padding:1.5rem;">
                                No purchase orders match the current filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (PurchaseOrderSummaryDto po in PageRows)
                        {
                            <tr>
                                <td>
                                    <a href="/master/purchases/@po.Id">@po.SupplierInvoiceNo</a>
                                </td>
                                <td>@po.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>@(po.SupplierName ?? po.SupplierId.ToString("N")[..8])</td>
                                <td class="po-num">@po.LineCount</td>
                                <td class="po-num">@FormatRs(po.NetPayablePaisa)</td>
                                <td>
                                    @if (po.IsReceived)
                                    {
                                        <span class="po-badge po-badge-received">Received</span>
                                    }
                                    else
                                    {
                                        <span class="po-badge po-badge-open">Open</span>
                                    }
                                    <span class="mm-muted" style="margin-left:0.35rem;font-size:0.8rem;">@po.PaymentStatus</span>
                                </td>
                                <td>
                                    <div class="po-actions">
                                        <a class="po-btn po-btn-sm po-btn-outline" href="/master/purchases/@po.Id">View</a>
                                        @if (!po.IsReceived)
                                        {
                                            <a class="po-btn po-btn-sm po-btn-outline" href="/master/purchases/@po.Id">Edit</a>
                                            <button type="button"
                                                    class="po-btn po-btn-sm po-btn-primary"
                                                    disabled="@_saving"
                                                    @onclick="() => ReceiveAsync(po.Id)">
                                                Receive
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="po-pager">
            <div class="po-pager-meta">
                @if (FilteredCount == 0)
                {
                    <text>Showing 0 purchase orders</text>
                }
                else
                {
                    <text>Showing @FromIndex to @ToIndex of @FilteredCount purchase orders</text>
                }
            </div>
            <div class="po-pager-controls">
                <button type="button" class="po-page-btn" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">‹</button>
                <button type="button" class="po-page-btn active">@_page</button>
                <button type="button" class="po-page-btn" disabled="@(_page >= TotalPages)" @onclick="() => GoPage(_page + 1)">›</button>
            </div>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 10;

    private readonly List<PurchaseOrderSummaryDto> _orders = [];
    private readonly List<PartyDto> _suppliers = [];
    private PurchaseForm _form = PurchaseForm.CreateDefault();
    private Guid _receiverId;
    private string _filter = string.Empty;
    private string _statusFilter = "all";
    private DateOnly? _dateFrom;
    private DateOnly? _dateTo;
    private int _page = 1;
    private bool _showForm;
    private bool _saving;
    private string? _error;
    private string? _success;

    private List<PurchaseOrderSummaryDto> FilteredList =>
        _orders.Where(MatchesFilters).OrderByDescending(o => o.CreatedAt).ToList();

    private int FilteredCount => FilteredList.Count;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));

    private int FromIndex => FilteredCount == 0 ? 0 : ((_page - 1) * PageSize) + 1;

    private int ToIndex => Math.Min(_page * PageSize, FilteredCount);

    private List<PurchaseOrderSummaryDto> PageRows =>
        FilteredList.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private bool MatchesFilters(PurchaseOrderSummaryDto o)
    {
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            bool textMatch =
                o.SupplierInvoiceNo.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || (o.SupplierName?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!textMatch)
            {
                return false;
            }
        }

        if (_statusFilter == "open" && o.IsReceived)
        {
            return false;
        }

        if (_statusFilter == "received" && !o.IsReceived)
        {
            return false;
        }

        DateOnly created = DateOnly.FromDateTime(o.CreatedAt.ToLocalTime().DateTime);
        if (_dateFrom is DateOnly from && created < from)
        {
            return false;
        }

        if (_dateTo is DateOnly to && created > to)
        {
            return false;
        }

        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();
        string? id = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(id, out _receiverId))
        {
            _error = "Signed-in user id is missing.";
        }

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("q", out var q) && !string.IsNullOrWhiteSpace(q))
        {
            _filter = q.ToString();
        }

        await LoadAsync();
        if (query.ContainsKey("new"))
        {
            ShowCreate();
        }
    }

    private void OnFilterChanged()
    {
        _page = 1;
    }

    private void ApplySearch() => _page = 1;

    private void ResetFilters()
    {
        _filter = string.Empty;
        _statusFilter = "all";
        _dateFrom = null;
        _dateTo = null;
        _page = 1;
    }

    private void GoPage(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages);
    }

    private async Task LoadAsync()
    {
        try
        {
            _orders.Clear();
            _orders.AddRange(await PurchaseService.ListAsync());
            _suppliers.Clear();
            _suppliers.AddRange(await PartyService.GetSuppliersAsync());
            _page = Math.Clamp(_page, 1, TotalPages);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnLineProductSelectedAsync(int index, ProductAdminDto product)
    {
        if (index < 0 || index >= _form.Lines.Count)
        {
            return;
        }

        LineForm line = _form.Lines[index];
        line.ProductId = product.Id.ToString();
        line.ProductLabel = product.IsBulk
            ? $"{product.Name} (master)"
            : $"{product.Name} ({product.Sku})";
        if (line.PurchasePriceRs <= 0 && product.LatestCostPricePaisa > 0)
        {
            line.PurchasePriceRs = product.LatestCostPricePaisa / 100m;
        }

        if (line.RetailPriceRs <= 0 && product.LatestRetailPricePaisa > 0)
        {
            line.RetailPriceRs = product.LatestRetailPricePaisa / 100m;
        }

        int nextIndex = index + 1;
        if (index == _form.Lines.Count - 1)
        {
            AddLine();
        }

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", $"mm-po-product-{nextIndex}");
        }
        catch
        {
            /* ignore */
        }
    }

    private void ShowCreate()
    {
        _form = PurchaseForm.CreateDefault();
        _showForm = true;
        _error = null;
        _success = null;
    }

    private void HideCreate() => _showForm = false;

    private void AddLine() => _form.Lines.Add(new LineForm());

    private void RemoveLine(int index)
    {
        if (index >= 0 && index < _form.Lines.Count)
        {
            _form.Lines.RemoveAt(index);
        }
    }

    private async Task CreateAsync()
    {
        if (_receiverId == Guid.Empty)
        {
            _error = "Cannot create purchase without a receiver user id.";
            return;
        }

        if (!Guid.TryParse(_form.SupplierId, out Guid supplierId))
        {
            _error = "Select a supplier.";
            return;
        }

        List<CreatePurchaseLineRequest> lines = [];
        foreach (LineForm line in _form.Lines)
        {
            if (!Guid.TryParse(line.ProductId, out Guid productId))
            {
                _error = "Each line needs a product.";
                return;
            }

            lines.Add(new CreatePurchaseLineRequest
            {
                ProductId = productId,
                Quantity = line.Quantity,
                PurchasePricePaisa = ToPaisa(line.PurchasePriceRs),
                RetailPricePaisa = ToPaisa(line.RetailPriceRs)
            });
        }

        if (lines.Count == 0)
        {
            _error = "Add at least one line.";
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        try
        {
            CreatePurchaseOrderResult result = await PurchaseService.CreatePurchaseOrderAsync(new CreatePurchaseRequest
            {
                SupplierId = supplierId,
                ReceiverId = _receiverId,
                SupplierInvoiceNo = _form.SupplierInvoiceNo.Trim(),
                PurchaseDate = new DateTimeOffset(_form.PurchaseDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero),
                DiscountPaisa = ToPaisa(_form.DiscountRs),
                Lines = lines
            });

            _success = $"Purchase created ({result.PurchaseOrderId:N}). Net Rs {FormatRs(result.NetPayablePaisa)}.";
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReceiveAsync(Guid purchaseOrderId)
    {
        _saving = true;
        _error = null;
        _success = null;
        try
        {
            ReceiveStockResult result = await PurchaseService.ReceiveStockAsync(purchaseOrderId);
            _success = $"Received stock for PO. Net Rs {FormatRs(result.NetPayablePaisa)}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static long ToPaisa(decimal rs) =>
        (long)Math.Round(rs * 100m, MidpointRounding.AwayFromZero);

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private sealed class PurchaseForm
    {
        public string SupplierId { get; set; } = string.Empty;
        public string SupplierInvoiceNo { get; set; } = string.Empty;
        public DateOnly PurchaseDate { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
        public decimal DiscountRs { get; set; }
        public List<LineForm> Lines { get; set; } = [];

        public static PurchaseForm CreateDefault() => new()
        {
            Lines = [new LineForm()]
        };
    }

    private sealed class LineForm
    {
        public string ProductId { get; set; } = string.Empty;
        public string ProductLabel { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1m;
        public decimal PurchasePriceRs { get; set; }
        public decimal RetailPriceRs { get; set; }
    }
}
