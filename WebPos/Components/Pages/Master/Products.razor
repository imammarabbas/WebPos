@page "/master/products"
@layout MasterLayout
@attribute [Authorize(Roles = "Owner,Manager")]
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using WebPos.Core.Abstractions
@inject IProductAdminService ProductService
@inject NavigationManager Navigation

<PageTitle>Products · Cone Mart</PageTitle>

<div class="mm-page">
    <div class="mm-page-header">
        <div>
            <h1>Products</h1>
            <p>Catalog, stock floors, and opening balances</p>
        </div>
        <a class="mm-btn mm-btn-primary" href="/master/products/new">+ New product</a>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mm-alert mm-alert-error">@_error</div>
    }

    <div class="mm-toolbar">
        <input class="form-control"
               style="max-width: 320px;"
               placeholder="Search name, SKU, barcode…"
               value="@_filter"
               @oninput="OnFilterInput" />
        @if (_lowOnly)
        {
            <span class="mm-badge mm-badge-warn">Low stock filter on</span>
            <button type="button" class="mm-btn" @onclick="ClearLowFilter">Clear</button>
        }
        <span class="mm-muted" style="margin-left:auto;">@_pagerLabel</span>
    </div>

    <div class="mm-table-wrap">
        <table class="mm-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Brand</th>
                    <th>Stock</th>
                    <th>Min</th>
                </tr>
            </thead>
            <tbody>
                @if (_loading)
                {
                    <tr>
                        <td colspan="5" class="mm-muted">Loading…</td>
                    </tr>
                }
                else if (_pageItems.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="mm-muted">No products match this search.</td>
                    </tr>
                }
                else
                {
                    @foreach (ProductAdminDto p in _pageItems)
                    {
                        <tr class="clickable" @onclick="() => OpenProduct(p.Id)">
                            <td>
                                @p.Name
                                @if (p.IsLoose)
                                {
                                    <span class="mm-badge">Loose</span>
                                }
                                @if (p.IsBulk)
                                {
                                    <span class="mm-badge">Bulk</span>
                                }
                                else if (p.ParentProductId is not null)
                                {
                                    <span class="mm-badge">Alias</span>
                                }
                            </td>
                            <td>@p.Sku</td>
                            <td>@p.Brand</td>
                            <td>@p.AvailableStock.ToString("0.##")</td>
                            <td>@p.MinStockQty.ToString("0.##")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mm-pager">
        <button type="button" class="mm-btn" disabled="@(_page <= 1 || _loading)" @onclick="PrevPage">Previous</button>
        <span>Page @_page of @_totalPages</span>
        <button type="button" class="mm-btn" disabled="@(_page >= _totalPages || _loading)" @onclick="NextPage">Next</button>
    </div>
</div>

@code {
    private const int PageSize = 50;
    private readonly List<ProductAdminDto> _pageItems = [];
    private string _filter = string.Empty;
    private bool _lowOnly;
    private bool _loading;
    private string? _error;
    private int _page = 1;
    private int _totalCount;
    private CancellationTokenSource? _searchCts;

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    private string _pagerLabel =>
        _totalCount == 0
            ? "0 products"
            : $"Showing {((_page - 1) * PageSize) + 1}–{Math.Min(_page * PageSize, _totalCount)} of {_totalCount}";

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryFlags();
        if (QueryHasFlag("new"))
        {
            Navigation.NavigateTo("/master/products/new", replace: true);
            return;
        }

        await LoadPageAsync();
    }

    private void ApplyQueryFlags()
    {
        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query =
            QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("q", out var q) && !string.IsNullOrWhiteSpace(q))
        {
            _filter = q.ToString();
        }

        _lowOnly = query.ContainsKey("low");
    }

    private bool QueryHasFlag(string key)
    {
        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        return QueryHelpers.ParseQuery(uri.Query).ContainsKey(key);
    }

    private async Task OnFilterInput(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        CancellationToken token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
            _page = 1;
            await LoadPageAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task LoadPageAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            PagedResult<ProductAdminDto> result = await ProductService.SearchAsync(new ProductSearchQuery
            {
                Search = _filter,
                LowStockOnly = _lowOnly,
                Page = _page,
                PageSize = PageSize
            });
            _pageItems.Clear();
            _pageItems.AddRange(result.Items);
            _totalCount = result.TotalCount;
            _page = result.Page;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrevPage()
    {
        if (_page <= 1)
        {
            return;
        }

        _page--;
        await LoadPageAsync();
    }

    private async Task NextPage()
    {
        if (_page >= _totalPages)
        {
            return;
        }

        _page++;
        await LoadPageAsync();
    }

    private void OpenProduct(Guid id) =>
        Navigation.NavigateTo($"/master/products/{id}");

    private async Task ClearLowFilter()
    {
        _lowOnly = false;
        _page = 1;
        Navigation.NavigateTo("/master/products", replace: true);
        await LoadPageAsync();
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
