# Optional. Copy to .env for stable pilot secrets, or rely on docker-compose defaults
# + Security:AllowInsecureDevDefaults (ephemeral keys generated at API startup).
#
# Zero-config:  docker compose up --build
# Postgres:     user=postgres password=postgres db=webpos_db
# API:          http://localhost:8080

POSTGRES_PASSWORD=postgres

# Leave blank to let the API generate ephemeral local keys (see Program.cs).
# Or run: pwsh -File scripts/Generate-PilotEnv.ps1
SECURITY_PIN_HASH_KEY=
SECURITY_JWT_KEY=dev_jwt_secret_key_must_be_32_chars_min
SECURITY_ENROLLMENT_PRIVATE_KEY_PEM=
SECURITY_ENROLLMENT_PUBLIC_KEY_PEM=

PILOT_TERMINAL_ID=00000000-0000-0000-0000-000000000010
PILOT_OWNER_PASSWORD=ammar123
PILOT_ADMIN_PASSWORD=admin123
PILOT_OWNER_PIN=9753
PILOT_MANAGER_PIN=8642
PILOT_CASHIER_PIN=2468
PILOT_ABC_CASHIER_PIN=1357
