# Copy to .env (or run: pwsh -File scripts/Generate-PilotEnv.ps1)
# That script also writes WebPos/appsettings.Development.Local.json so Master
# (dotnet run) uses the same Database=WebPos + password as Docker.
POSTGRES_PASSWORD=change-me
SECURITY_PIN_HASH_KEY=base64-encoded-32-byte-key
SECURITY_JWT_KEY=stable-jwt-signing-key-min-32-chars
SECURITY_ENROLLMENT_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
SECURITY_ENROLLMENT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
PILOT_TERMINAL_ID=00000000-0000-0000-0000-000000000010
PILOT_OWNER_PASSWORD=ammar123
PILOT_ADMIN_PASSWORD=admin123
PILOT_OWNER_PIN=9753
PILOT_MANAGER_PIN=8642
PILOT_CASHIER_PIN=2468
PILOT_ABC_CASHIER_PIN=1357
