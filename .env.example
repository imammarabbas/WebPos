# Copy this file to .env and replace CHANGE_ME values before starting.
#   copy .env.example .env
#
# Never commit .env — it holds shop secrets.
# Docker Compose reads .env automatically from the repo root.
#
# After editing .env:
#   docker compose up -d --build
#
# API:          http://localhost:8080
# Health:       http://localhost:8080/health
# Master:       http://localhost:8080/master

# Required — use a strong unique password for this shop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Required — JWT signing key, at least 32 characters
SECURITY_JWT_KEY=CHANGE_ME_JWT_KEY_AT_LEAST_32_CHARS_LONG

# Optional — leave blank to let the API generate local keys (dev / first install).
# For a lasting install, run: pwsh -File scripts/Generate-PilotEnv.ps1
SECURITY_PIN_HASH_KEY=
SECURITY_ENROLLMENT_PRIVATE_KEY_PEM=
SECURITY_ENROLLMENT_PUBLIC_KEY_PEM=

# ASP.NET environment (Development enables insecure local defaults when keys are blank)
ASPNETCORE_ENVIRONMENT=Development

# DEMO_ONLY — change these before exposing the shop on any network
PILOT_TERMINAL_ID=00000000-0000-0000-0000-000000000010
PILOT_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
PILOT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PILOT_OWNER_PIN=CHANGE_ME
PILOT_MANAGER_PIN=CHANGE_ME
PILOT_CASHIER_PIN=CHANGE_ME
PILOT_ABC_CASHIER_PIN=CHANGE_ME
