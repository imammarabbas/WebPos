# Copy to .env and fill before: docker compose up
POSTGRES_PASSWORD=change-me
SECURITY_PIN_HASH_KEY=base64-encoded-32-byte-key
SECURITY_JWT_KEY=stable-jwt-signing-key-min-32-chars
SECURITY_ENROLLMENT_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
SECURITY_ENROLLMENT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
PILOT_TERMINAL_ID=00000000-0000-0000-0000-000000000010
