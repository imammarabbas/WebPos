<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cfd="clr-namespace:WebPos.WindowsTerminal.Components.CustomerDisplay"
             x:Class="WebPos.WindowsTerminal.CustomerDisplayPage"
             BackgroundColor="#0F172A"
             Title="Customer Display — Smart POS">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/customer-display-host.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#cfd-root" ComponentType="{x:Type cfd:CustomerDisplayView}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
