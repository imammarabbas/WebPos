@page "/suppliers"
@using System.Globalization
@using Common.Models
@inject PurchaseIntakeApiClient Intake
@inject ISessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Suppliers</PageTitle>

<div class="page-shell party-page po-page">
    <PosTopMenu />

    <div class="po-page-header">
        <div class="po-page-header-left">
            <div class="po-icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 10.5 12 4l9 6.5V20H3V10.5Z" />
                    <path d="M12 22V12" />
                </svg>
            </div>
            <div>
                <h1>Suppliers</h1>
                <p>View vendors and open purchase orders</p>
            </div>
        </div>
        <div class="po-actions">
            <button type="button" class="po-btn po-btn-primary" @onclick="OpenCreate">+ New Supplier</button>
            <a class="po-btn po-btn-outline" href="sales?orders=1">Purchase Orders</a>
            <a class="po-btn po-btn-outline" href="sales?createpo=1">+ New PO</a>
            <a class="po-btn po-btn-outline" href="sales">Back to Sale</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="po-alert">@_error</div>
    }

    @if (_mode == PartyUiMode.View && _selected is not null)
    {
        <div class="po-card">
            <h2>Supplier</h2>
            <div class="pov-info-grid">
                <div class="pov-info-item"><label>Name</label><div class="pov-value">@_selected.Name</div></div>
                <div class="pov-info-item"><label>Phone</label><div class="pov-value">@_selected.PhoneNumber</div></div>
                <div class="pov-info-item"><label>Balance</label><div class="pov-value">Rs @FormatRs(_selected.CurrentBalancePaisa)</div></div>
                <div class="pov-info-item"><label>Address</label><div class="pov-value">@(string.IsNullOrWhiteSpace(_selected.Address) ? "—" : _selected.Address)</div></div>
            </div>
            <div class="pov-footer-actions">
                <a class="po-btn po-btn-primary" href="sales?createpo=1">New Purchase Order</a>
                <a class="po-btn po-btn-outline" href="sales?orders=1">Purchase Orders</a>
                <button type="button" class="po-btn po-btn-outline" @onclick="OpenEditSelected">Edit</button>
                <button type="button" class="po-btn" @onclick="BackToList">Back</button>
            </div>
        </div>
    }
    else if (_mode == PartyUiMode.Edit)
    {
        <div class="po-card">
            <h2>@(_editingId is Guid ? "Edit Supplier" : "New Supplier")</h2>
            <div class="pov-info-grid">
                <div class="po-field">
                    <label for="sup-name">Name</label>
                    <input id="sup-name" class="form-control" @bind="_editName" disabled="@_saving" />
                </div>
                <div class="po-field">
                    <label for="sup-phone">Phone</label>
                    <input id="sup-phone" class="form-control" type="tel" @bind="_editPhone" disabled="@_saving" />
                </div>
                <div class="po-field">
                    <label for="sup-addr">Address</label>
                    <input id="sup-addr" class="form-control" @bind="_editAddress" disabled="@_saving" />
                </div>
            </div>
            <div class="pov-footer-actions">
                <button type="button" class="po-btn po-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : "Save")
                </button>
                <button type="button" class="po-btn" disabled="@_saving" @onclick="BackToList">Back</button>
            </div>
        </div>
    }
    else
    {
        <div class="po-card">
            <div class="po-filter-row" style="grid-template-columns:minmax(200px,1fr) auto;">
                <div class="po-field">
                    <label for="sup-search">Search</label>
                    <input id="sup-search"
                           class="form-control"
                           type="search"
                           placeholder="Search name or phone…"
                           @bind="_search"
                           @bind:event="oninput"
                           disabled="@_loading" />
                </div>
                <div class="po-filter-actions">
                    <button type="button" class="po-btn po-btn-outline" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <p class="po-empty">Loading suppliers…</p>
        }
        else if (Filtered.Count == 0)
        {
            <p class="po-empty">No suppliers found.</p>
        }
        else
        {
            <div class="po-card" style="margin-top:1rem;">
                <div class="po-table-wrap">
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th class="po-num">Balance</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (PartyDto s in Filtered)
                            {
                                <tr>
                                    <td><strong>@s.Name</strong></td>
                                    <td>@s.PhoneNumber</td>
                                    <td class="po-num">@FormatRs(s.CurrentBalancePaisa)</td>
                                    <td>
                                        <div class="po-actions">
                                            <button type="button" class="po-btn po-btn-sm po-btn-outline" @onclick="() => OpenView(s)">View</button>
                                            <button type="button" class="po-btn po-btn-sm po-btn-outline" @onclick="() => OpenEdit(s)">Edit</button>
                                            <a class="po-btn po-btn-sm po-btn-primary" href="sales?createpo=1">New PO</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private enum PartyUiMode { List, View, Edit }

    private IReadOnlyList<PartyDto> _suppliers = [];
    private string _search = string.Empty;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private PartyUiMode _mode = PartyUiMode.List;
    private PartyDto? _selected;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editPhone = string.Empty;
    private string _editAddress = string.Empty;

    private IReadOnlyList<PartyDto> Filtered
    {
        get
        {
            string q = _search.Trim();
            IEnumerable<PartyDto> query = _suppliers;
            if (!string.IsNullOrEmpty(q))
            {
                query = query.Where(s =>
                    s.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.PhoneNumber.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(s => s.Name).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        Result<IReadOnlyList<PartyDto>> result = await Intake.GetSuppliersAsync();
        _loading = false;
        if (result.Success && result.Data is not null)
        {
            _suppliers = result.Data;
            return;
        }

        _suppliers = [];
        _error = result.ErrorMessage ?? "Unable to load suppliers.";
    }

    private void OpenView(PartyDto s)
    {
        _selected = s;
        _mode = PartyUiMode.View;
    }

    private void OpenEdit(PartyDto s)
    {
        _selected = s;
        _editingId = s.Id;
        _editName = s.Name;
        _editPhone = s.PhoneNumber;
        _editAddress = s.Address ?? string.Empty;
        _mode = PartyUiMode.Edit;
    }

    private void OpenEditSelected()
    {
        if (_selected is not null)
        {
            OpenEdit(_selected);
        }
    }

    private void OpenCreate()
    {
        _selected = null;
        _editingId = null;
        _editName = string.Empty;
        _editPhone = string.Empty;
        _editAddress = string.Empty;
        _mode = PartyUiMode.Edit;
    }

    private void BackToList()
    {
        _mode = PartyUiMode.List;
        _selected = null;
        _editingId = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            Result<PartyDto> result;
            if (_editingId is Guid id)
            {
                long creditLimit = _selected?.CreditLimitPaisa ?? 0;
                result = await Intake.UpdateSupplierAsync(
                    id,
                    _editName,
                    _editPhone,
                    _editAddress,
                    creditLimit);
            }
            else
            {
                result = await Intake.CreateSupplierAsync(_editName, _editPhone, _editAddress);
            }

            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Unable to save supplier.";
                return;
            }

            await LoadAsync();
            OpenView(result.Data);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);
}
