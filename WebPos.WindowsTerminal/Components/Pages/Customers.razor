@page "/customers"
@using System.Globalization
@using Common.Models
@using WebPos.WindowsTerminal.Services
@inject CustomerApiClient CustomerApi
@inject ISessionService SessionService
@inject NavigationManager Navigation
@inject WhatsAppReceiptService WhatsAppReceipt

<PageTitle>Customers</PageTitle>

<div class="page-shell party-page po-page cust-page">
    <PosTopMenu />

    <div class="po-page-header">
        <div class="po-page-header-left">
            <div class="po-icon-tile" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="3.5" />
                    <path d="M5 19c1.5-3.5 4-5 7-5s5.5 1.5 7 5" stroke-linecap="round" />
                </svg>
            </div>
            <div>
                <h1>Customers</h1>
                <p>Contacts, balances, ledger, and payments</p>
            </div>
        </div>
        <div class="po-actions">
            <button type="button" class="po-btn po-btn-primary" @onclick="OpenCreate">+ Add Customer</button>
            <a class="po-btn po-btn-outline" href="sales">Back to Sale</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="po-alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="po-alert" style="background:#ecfdf5;border-color:#6ee7b7;color:#065f46;">@_success</div>
    }

    @if (_mode == PartyUiMode.Edit)
    {
        <div class="po-card cust-edit-card">
            <h2>@(_editingId is Guid ? "Edit Customer" : "Add New Customer")</h2>
            <div class="pov-info-grid">
                <div class="po-field">
                    <label for="cust-name">Name</label>
                    <input id="cust-name" class="form-control" @bind="_editName" disabled="@_saving" />
                </div>
                <div class="po-field">
                    <label for="cust-phone">Phone</label>
                    <input id="cust-phone" class="form-control" type="tel" @bind="_editPhone" disabled="@_saving" />
                </div>
                <div class="po-field">
                    <label for="cust-addr">Address</label>
                    <input id="cust-addr" class="form-control" @bind="_editAddress" disabled="@_saving" />
                </div>
                <div class="po-field">
                    <label for="cust-email">Email</label>
                    <input id="cust-email" class="form-control" type="email" @bind="_editEmail" disabled="@_saving" />
                </div>
            </div>
            <div class="pov-footer-actions">
                <button type="button" class="po-btn po-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                    @(_saving ? "Saving…" : (_editingId is Guid ? "Save changes" : "Create Customer"))
                </button>
                <button type="button" class="po-btn" disabled="@_saving" @onclick="BackToList">Back</button>
            </div>
        </div>
    }
    else
    {
        <div class="cust-kpi-row">
            <div class="cust-kpi">
                <span>Total Customers</span>
                <strong>@TotalCustomers</strong>
            </div>
            <div class="cust-kpi cust-kpi-recv">
                <span>Total Receivable</span>
                <strong>Rs @FormatRs(TotalReceivablePaisa)</strong>
                <em>Owes you</em>
            </div>
            <div class="cust-kpi cust-kpi-pay">
                <span>Total Payable</span>
                <strong>Rs @FormatRs(TotalPayablePaisa)</strong>
                <em>You owe</em>
            </div>
            <div class="cust-kpi cust-kpi-attn">
                <span>Need attention</span>
                <strong>@NeedAttentionCount</strong>
                <em>Pay soon</em>
            </div>
        </div>

        <div class="po-card cust-search-card">
            <div class="po-filter-row" style="grid-template-columns:minmax(200px,1fr) auto;">
                <div class="po-field">
                    <label for="cust-search">Search</label>
                    <input id="cust-search"
                           class="form-control"
                           type="search"
                           placeholder="Search name or phone…"
                           @bind="_search"
                           @bind:event="oninput"
                           disabled="@_loading" />
                </div>
                <div class="po-filter-actions">
                    <button type="button" class="po-btn po-btn-outline" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <p class="po-empty">Loading customers…</p>
        }
        else if (Filtered.Count == 0)
        {
            <p class="po-empty">No customers found. Try changing search or add a customer.</p>
        }
        else
        {
            <div class="po-card cust-list-card">
                <div class="cust-list-head">
                    <span class="cust-col-party">Customer</span>
                    <span class="cust-col-bal">Balance</span>
                    <span class="cust-col-act">Actions</span>
                </div>
                <ul class="cust-list">
                    @foreach (PartyDto c in Filtered)
                    {
                        <li class="cust-row">
                            <div class="cust-party">
                                <div class="cust-avatar" aria-hidden="true">@Initials(c.Name)</div>
                                <div class="cust-party-meta">
                                    <strong>@c.Name</strong>
                                    <span class="cust-phone">@(string.IsNullOrWhiteSpace(c.PhoneNumber) ? "No phone" : c.PhoneNumber)</span>
                                </div>
                            </div>
                            <div class="cust-balance @BalanceCss(c.CurrentBalancePaisa)">
                                <strong>Rs @FormatRs(Math.Abs(c.CurrentBalancePaisa))</strong>
                                <span>@BalanceLabel(c.CurrentBalancePaisa)</span>
                            </div>
                            <div class="cust-actions">
                                <button type="button" class="po-btn po-btn-sm po-btn-outline" @onclick="() => OpenLedger(c)" title="View ledger">View</button>
                                <button type="button" class="po-btn po-btn-sm po-btn-outline" @onclick="() => OpenPay(c)">Pay</button>
                                <button type="button" class="po-btn po-btn-sm po-btn-outline" @onclick="() => OpenEdit(c)">Edit</button>
                                <a class="po-btn po-btn-sm po-btn-primary" href="@($"sales?customer={c.Id:D}")">Sell</a>
                                @if (HasPhone(c))
                                {
                                    <button type="button" class="po-btn po-btn-sm" @onclick="() => CallAsync(c)" title="Call">Call</button>
                                    <button type="button" class="po-btn po-btn-sm" @onclick="() => WhatsAppAsync(c)" title="WhatsApp">WhatsApp</button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

<PartyPaymentModal Visible="_showPay"
                   Party="_payParty"
                   IsSupplier="false"
                   OnCancel="ClosePay"
                   OnPaid="OnPaidAsync" />

<style>
    .cust-kpi-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .cust-kpi {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 0.85rem 1rem;
    }
    .cust-kpi span { display: block; font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; }
    .cust-kpi strong { display: block; margin-top: 0.25rem; font-size: 1.15rem; color: #0f172a; }
    .cust-kpi em { display: block; margin-top: 0.15rem; font-style: normal; font-size: 0.75rem; color: #64748b; }
    .cust-kpi-recv strong { color: #15803d; }
    .cust-kpi-pay strong { color: #b91c1c; }
    .cust-kpi-attn { background: #fff7ed; border-color: #fed7aa; }
    .cust-kpi-attn strong { color: #c2410c; }
    .cust-search-card { margin-bottom: 1rem; }
    .cust-list-card { padding: 0; overflow: hidden; }
    .cust-list-head {
        display: grid;
        grid-template-columns: minmax(180px, 1.4fr) minmax(120px, 0.7fr) minmax(220px, 1.4fr);
        gap: 0.75rem;
        padding: 0.65rem 1rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
    }
    .cust-list { list-style: none; margin: 0; padding: 0; }
    .cust-row {
        display: grid;
        grid-template-columns: minmax(180px, 1.4fr) minmax(120px, 0.7fr) minmax(220px, 1.4fr);
        gap: 0.75rem;
        align-items: center;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .cust-row:last-child { border-bottom: none; }
    .cust-row:hover { background: #f8fafc; }
    .cust-party { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
    .cust-avatar {
        flex: 0 0 auto;
        width: 2.4rem; height: 2.4rem;
        border-radius: 999px;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem; font-weight: 700;
    }
    .cust-party-meta { min-width: 0; }
    .cust-party-meta strong { display: block; color: #0f172a; font-size: 0.95rem; }
    .cust-phone { display: block; color: #64748b; font-size: 0.8rem; margin-top: 0.1rem; font-variant-numeric: tabular-nums; }
    .cust-balance { display: flex; flex-direction: column; gap: 0.1rem; }
    .cust-balance strong { font-size: 0.95rem; font-variant-numeric: tabular-nums; }
    .cust-balance span { font-size: 0.72rem; font-weight: 600; }
    .cust-bal-recv strong, .cust-bal-recv span { color: #15803d; }
    .cust-bal-pay strong, .cust-bal-pay span { color: #b91c1c; }
    .cust-bal-zero strong, .cust-bal-zero span { color: #64748b; }
    .cust-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; justify-content: flex-end; }
    .cust-edit-card h2 { margin-top: 0; }
    @@media (max-width: 1100px) {
        .cust-kpi-row { grid-template-columns: 1fr 1fr; }
        .cust-list-head { display: none; }
        .cust-row {
            grid-template-columns: 1fr;
            gap: 0.55rem;
        }
        .cust-actions { justify-content: flex-start; }
    }
</style>

@code {
    private enum PartyUiMode { List, Edit }

    private IReadOnlyList<PartyDto> _customers = [];
    private string _search = string.Empty;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _saving;
    private PartyUiMode _mode = PartyUiMode.List;
    private PartyDto? _selected;
    private PartyDto? _payParty;
    private bool _showPay;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editPhone = string.Empty;
    private string _editAddress = string.Empty;
    private string _editEmail = string.Empty;

    private IReadOnlyList<PartyDto> Filtered =>
        CustomerApiClient.FilterCustomers(_customers, _search).ToList();

    private int TotalCustomers => _customers.Count;

    private long TotalReceivablePaisa =>
        _customers.Where(c => c.CurrentBalancePaisa > 0).Sum(c => c.CurrentBalancePaisa);

    private long TotalPayablePaisa =>
        _customers.Where(c => c.CurrentBalancePaisa < 0).Sum(c => -c.CurrentBalancePaisa);

    private int NeedAttentionCount =>
        _customers.Count(c => c.CurrentBalancePaisa != 0);

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        Result<IReadOnlyList<PartyDto>> result = await CustomerApi.GetCustomersAsync();
        _loading = false;
        if (result.Success && result.Data is not null)
        {
            _customers = result.Data;
            return;
        }

        _customers = [];
        _error = result.ErrorMessage ?? "Unable to load customers.";
    }

    private void OpenLedger(PartyDto c) =>
        Navigation.NavigateTo($"recent-bills?customer={c.Id:D}");

    private void OpenPay(PartyDto c)
    {
        _payParty = c;
        _showPay = true;
        _success = null;
    }

    private void ClosePay()
    {
        _showPay = false;
        _payParty = null;
    }

    private async Task OnPaidAsync(PartyDto updated)
    {
        _showPay = false;
        _payParty = null;
        _success = $"Payment received · Bal Rs {FormatRs(updated.CurrentBalancePaisa)}";
        await LoadAsync();
    }

    private void OpenEdit(PartyDto c)
    {
        _selected = c;
        _editingId = c.Id;
        _editName = c.Name;
        _editPhone = c.PhoneNumber;
        _editAddress = c.Address ?? string.Empty;
        _editEmail = c.Email ?? string.Empty;
        _mode = PartyUiMode.Edit;
        _success = null;
    }

    private void OpenCreate()
    {
        _selected = null;
        _editingId = null;
        _editName = string.Empty;
        _editPhone = string.Empty;
        _editAddress = string.Empty;
        _editEmail = string.Empty;
        _mode = PartyUiMode.Edit;
        _success = null;
    }

    private void BackToList()
    {
        _mode = PartyUiMode.List;
        _selected = null;
        _editingId = null;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        try
        {
            Result<PartyDto> result;
            if (_editingId is Guid id)
            {
                long creditLimit = _selected?.CreditLimitPaisa ?? 0;
                result = await CustomerApi.UpdateCustomerAsync(
                    id,
                    _editName,
                    _editPhone,
                    _editAddress,
                    creditLimit,
                    _editEmail);
            }
            else
            {
                result = await CustomerApi.CreateCustomerAsync(_editName, _editPhone, _editAddress, _editEmail);
            }

            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Unable to save customer.";
                return;
            }

            _success = _editingId is Guid ? "Customer updated" : "Customer added";
            await LoadAsync();
            BackToList();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CallAsync(PartyDto c)
    {
        string? digits = WhatsAppReceiptService.NormalizePhoneDigits(c.PhoneNumber);
        if (string.IsNullOrEmpty(digits))
        {
            _error = "No valid phone number.";
            return;
        }

        try
        {
            await Browser.Default.OpenAsync($"tel:+{digits}", BrowserLaunchMode.SystemPreferred);
        }
        catch
        {
            _error = "Could not open dialer.";
        }
    }

    private async Task WhatsAppAsync(PartyDto c)
    {
        string message = $"Hello {c.Name},";
        string? url = WhatsAppReceipt.BuildWhatsAppUrl(c.PhoneNumber, message);
        if (url is null)
        {
            _error = "No valid WhatsApp number.";
            return;
        }

        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch
        {
            _error = "Could not open WhatsApp.";
        }
    }

    private static bool HasPhone(PartyDto c) =>
        !string.IsNullOrWhiteSpace(WhatsAppReceiptService.NormalizePhoneDigits(c.PhoneNumber));

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        }

        string one = parts[0];
        return one.Length >= 2
            ? one[..2].ToUpperInvariant()
            : one.ToUpperInvariant();
    }

    private static string BalanceCss(long paisa) =>
        paisa > 0 ? "cust-bal-recv" : paisa < 0 ? "cust-bal-pay" : "cust-bal-zero";

    private static string BalanceLabel(long paisa) =>
        paisa > 0 ? "Receivable · Owes you"
        : paisa < 0 ? "Payable · You owe"
        : "Settled";

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);
}
