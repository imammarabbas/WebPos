    private void HoldCart()
    {
        if (CartService.IsEmpty)
        {
            return;
        }

        List<CartLine> lines = CartService.Lines
            .Select(line => new CartLine
            {
                Product = line.Product,
                Quantity = line.Quantity,
                UnitPriceOverridePaisa = line.UnitPriceOverridePaisa
            })
            .ToList();

        CartHoldService.Hold(new HeldCartSnapshot
        {
            Lines = lines,
            Customer = _selectedCustomer,
            UseWalkIn = _useWalkInCustomer,
            DiscountAmountPaisa = DiscountAmountPaisa,
            WhatsAppReceipt = _whatsAppReceipt,
            PrintOnPrinter = _printOnPrinter
        });

        ClearCart();
        _selectedCustomer = null;
        _useWalkInCustomer = true;
        _whatsAppReceipt = false;
        _printOnPrinter = false;
        _successMessage = "Sale held. Press Ctrl+R to retrieve.";
    }

    private void ResumeHeldCart()
    {
        HeldCartSnapshot? snapshot = CartHoldService.Resume();
        if (snapshot is null || snapshot.Lines.Count == 0)
        {
            return;
        }

        CartService.Clear();
        _qtyText.Clear();
        _priceText.Clear();

        foreach (CartLine line in snapshot.Lines)
        {
            CartService.Add(line.Product, line.Quantity);
            if (line.UnitPriceOverridePaisa is long overridePrice)
            {
                CartService.SetUnitPrice(line.Product.ProductId, overridePrice);
            }

            SyncLineEditors(line.Product.ProductId);
        }

        _selectedCustomer = snapshot.Customer;
        _useWalkInCustomer = snapshot.UseWalkIn || snapshot.Customer is null;
        _whatsAppReceipt = snapshot.WhatsAppReceipt;
        _printOnPrinter = snapshot.PrintOnPrinter;
        if (snapshot.DiscountAmountPaisa > 0)
        {
            _discountRsText = (snapshot.DiscountAmountPaisa / 100m).ToString(
                "0.##",
                CultureInfo.InvariantCulture);
            SyncDiscountPctFromRs();
        }
        else
        {
            _discountRsText = string.Empty;
            _discountPctText = string.Empty;
        }

        _successMessage = "Held sale retrieved.";
        _checkoutError = null;
    }

    private async Task PayNowAsync()
    {
        _checkoutError = null;
        _errorMessage = null;
        _successMessage = null;

        if (CartService.IsEmpty)
        {
            _checkoutError = "Cart is empty.";
            return;
        }

        if (!_useWalkInCustomer && _selectedCustomer is null)
        {
            _checkoutError = "Select a registered customer or switch to Walk-in.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_discountRsText) && !TryParseRs(_discountRsText, out _))
        {
            _checkoutError = "Enter a valid discount amount.";
            return;
        }

        if (DiscountAmountPaisa > CartService.SubtotalPaisa)
        {
            _checkoutError = "Discount cannot exceed the cart total.";
            return;
        }

        string paymentMethod;
        Guid? customerId = _selectedCustomer?.Id;
        long? changePaisa = null;
        string? txnRef = null;
        long discountPaisa = DiscountAmountPaisa;

        if (_paymentMode == PaymentUiMode.Credit)
        {
            if (_selectedCustomer is null)
            {
                _checkoutError = "Select a registered customer for credit sales.";
                return;
            }

            paymentMethod = CheckoutPaymentMethods.CustomerAccount;
        }
        else if (_paymentMode == PaymentUiMode.Cash)
        {
            paymentMethod = CheckoutPaymentMethods.Cash;
            if (!string.IsNullOrWhiteSpace(_cashGivenText))
            {
                if (!TryParseRs(_cashGivenText, out long given) || given < PayablePaisa)
                {
                    _checkoutError = "Cash given must cover the total.";
                    return;
                }

                changePaisa = given - PayablePaisa;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_onlineTxnRef))
            {
                _checkoutError = "Enter the online transaction reference.";
                return;
            }

            paymentMethod = _onlineChannel;
            txnRef = _onlineTxnRef.Trim();
        }

        List<CartLine> saleLines = CartService.Lines
            .Select(line => new CartLine
            {
                Product = line.Product,
                Quantity = line.Quantity,
                UnitPriceOverridePaisa = line.UnitPriceOverridePaisa
            })
            .ToList();
        string? customerPhone = _selectedCustomer?.PhoneNumber;
        bool whatsApp = _whatsAppReceipt;
        bool printPrinter = _printOnPrinter;

        _isBusy = true;
        try
        {
            Result<CompleteSaleResult> result = await SalesApi.CompleteCartAsync(
                CartService.Lines,
                paymentMethod,
                customerId,
                discountPaisa,
                invoiceNo: string.IsNullOrWhiteSpace(_draftInvoiceNo) ? null : $"POS-{_draftInvoiceNo}");

            if (!result.Success)
            {
                _checkoutError = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Sale failed."
                    : result.ErrorMessage;
                return;
            }

            CompleteSaleResult sale = result.Data!;
            string paymentLabel = CheckoutPaymentMethods.DisplayLabel(paymentMethod);

            LastSaleReceiptStore.Set(new LastSaleReceipt
            {
                Sale = sale,
                Lines = saleLines,
                PaymentLabel = paymentLabel,
                OnlineTxnRef = txnRef,
                ChangePaisa = changePaisa,
                CustomerPhone = customerPhone
            });

            _successMessage =
                $"Sale complete · {sale.InvoiceNo} · Rs {FormatRs(sale.TotalAmountPaisa)}";

            _qtyText.Clear();
            _priceText.Clear();
            CartService.Clear();
            _cashGivenText = string.Empty;
            _onlineTxnRef = string.Empty;
            _discountRsText = string.Empty;
            _discountPctText = string.Empty;
            _remarks = string.Empty;
            _selectedCustomer = null;
            _useWalkInCustomer = true;
            _paymentMode = PaymentUiMode.Cash;
            _selectedLineIndex = -1;
            _whatsAppReceipt = false;
            _printOnPrinter = false;
            AssignDraftInvoiceNo();

            await Task.WhenAll(
                LoadProductsAsync(),
                LoadMastersAsync(),
                LoadQuickLinksAsync(),
                ShiftStatus.RefreshAsync());

            if (whatsApp)
            {
                await WhatsAppReceiptAsync();
            }

            if (printPrinter)
            {
                await PrintReceiptAsync();
            }

            await FocusScanAsync();
        }
        catch (SessionNotActiveException)
        {
            _checkoutError = "Start Shift before processing a sale.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PayNow failed with unexpected error.");
            _checkoutError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Unexpected sale error. Try again."
                : ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task WhatsAppReceiptAsync()
    {
        _whatsAppError = null;
        LastSaleReceipt? receipt = LastSaleReceiptStore.Current;
        if (receipt is null)
        {
            return;
        }

        string? phone = receipt.CustomerPhone;
        if (string.IsNullOrWhiteSpace(phone))
        {
            _whatsAppPhone = string.Empty;
            _showPhonePrompt = true;
            return;
        }

        await OpenWhatsAppAsync(phone, receipt);
    }

    private async Task PrintReceiptAsync()
    {
        LastSaleReceipt? receipt = LastSaleReceiptStore.Current;
        if (receipt is null)
        {
            return;
        }

        string message = WhatsAppReceiptService.BuildReceiptMessage(
            receipt.Sale,
            receipt.Lines,
            receipt.PaymentLabel,
            receipt.OnlineTxnRef,
            receipt.ChangePaisa);

        try
        {
            await Js.InvokeVoidAsync("webPosPrintReceipt", message);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Printer receipt failed");
            _checkoutError = "Could not open the printer dialog.";
        }
    }

    private async Task ConfirmWhatsAppPhoneAsync()
    {
        LastSaleReceipt? receipt = LastSaleReceiptStore.Current;
        if (receipt is null)
        {
            _showPhonePrompt = false;
            return;
        }

        await OpenWhatsAppAsync(_whatsAppPhone, receipt);
    }

    private async Task OpenWhatsAppAsync(string phone, LastSaleReceipt receipt)
    {
        _whatsAppError = null;
        string message = WhatsAppReceiptService.BuildReceiptMessage(
            receipt.Sale,
            receipt.Lines,
            receipt.PaymentLabel,
            receipt.OnlineTxnRef,
            receipt.ChangePaisa);

        string? url = WhatsAppReceiptService.BuildWhatsAppUrl(phone, message);
        if (url is null)
        {
            _whatsAppError = "Enter a valid mobile number (e.g. 03009998877).";
            _showPhonePrompt = true;
            return;
        }

        _showPhonePrompt = false;
        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch (Exception)
        {
            _whatsAppError = "Could not open WhatsApp. Copy the number and send manually.";
            _showPhonePrompt = true;
        }
    }

    private void ClosePhonePrompt()
    {
        _showPhonePrompt = false;
        _whatsAppError = null;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (_showPhonePrompt)
            {
                ClosePhonePrompt();
                return;
            }

            if (_showCalculator)
            {
                _showCalculator = false;
                return;
            }

            if (_showCustomerAdd)
            {
                _showCustomerAdd = false;
                return;
            }

            if (_showCustomerSearch)
            {
                _showCustomerSearch = false;
                return;
            }

            if (_variantMaster is not null)
            {
                CloseVariant();
                return;
            }

            if (!string.IsNullOrWhiteSpace(_categoryPickName))
            {
                CloseCategoryPick();
                return;
            }

            if (_showItemSearch)
            {
                CloseItemSearch();
                return;
            }

            if (_showPriceChecker)
            {
                _showPriceChecker = false;
                return;
            }

            if (_showCreatePurchaseOrder)
            {
                CloseCreatePurchaseOrder();
                return;
            }

            if (_showPurchaseOrders)
            {
                ClosePurchaseOrders();
                return;
            }
        }

        if (ModalOpen || _isBusy)
        {
            return;
        }

        if (e.Key is "Delete")
        {
            DeleteSelectedLine();
            return;
        }

        if (e.CtrlKey && e.Key == "Enter")
        {
            if (CanPay && !CartService.IsEmpty)
            {
                await PayNowAsync();
            }

            return;
        }

        if (e.CtrlKey && (e.Key == "h" || e.Key == "H"))
        {
            HoldCart();
            return;
        }

        if (e.CtrlKey && (e.Key == "r" || e.Key == "R"))
        {
            ResumeHeldCart();
            return;
        }

        switch (e.Key)
        {
            case "F3":
                await OpenSearchCustomerAsync();
                break;
            case "F4":
                OpenAddCustomer();
                break;
            case "F5":
                NewSale();
                break;
            case "F6":
                ToggleWhatsAppInvoice();
                break;
            case "F7":
                TogglePrintInvoice();
                break;
            case "F8":
                await SelectRegisteredCustomerMode();
                break;
            case "F9":
                SelectWalkInCustomer();
                break;
            case "F12":
            case "Insert":
                if (CanPay && !CartService.IsEmpty)
                {
                    await PayNowAsync();
                }

                break;
        }
    }

