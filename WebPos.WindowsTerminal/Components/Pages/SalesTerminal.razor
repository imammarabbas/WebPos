    private Task PublishCfdSnapshotAsync(string? phaseOverride = null)
    {
        string phase = phaseOverride ?? _cfdPhase;
        PaymentBreakdown breakdown = ActiveBreakdown;

        IReadOnlyList<CustomerDisplayLine> items = CartService.Lines
            .Select(line => new CustomerDisplayLine(
                Description: string.IsNullOrWhiteSpace(line.DescriptionOverride)
                    ? (line.Product.Name ?? string.Empty)
                    : line.DescriptionOverride!,
                Quantity: line.Quantity,
                LineTotal: line.LineTotalPaisa / 100m))
            .ToList();

        CustomerDisplayState.Publish(new CustomerDisplaySnapshot(
            CustomerName: CustomerNameDisplay,
            InvoiceNo: string.IsNullOrWhiteSpace(_draftInvoiceNo) ? "—" : _draftInvoiceNo,
            Items: items,
            NetAmount: breakdown.AmountDuePaisa / 100m,
            Payment: breakdown.PaymentReceivedPaisa / 100m,
            Phase: phase,
            IsWalkIn: breakdown.IsWalkIn,
            CurrentSaleTotal: breakdown.CurrentSaleTotalPaisa / 100m,
            PreviousDue: breakdown.PreviousDuePaisa / 100m,
            PaymentReceived: breakdown.PaymentReceivedPaisa / 100m,
            ChangeReturn: breakdown.ChangeReturnPaisa / 100m,
            OnAccount: breakdown.OnAccountPaisa / 100m,
            AccountCredit: breakdown.AccountCreditPaisa / 100m,
            NewCustomerBalance: breakdown.NewCustomerBalancePaisa / 100m));

        return Task.CompletedTask;
    }

    private Task OnPaymentLivePreviewAsync(PaymentModal.PaymentLivePreview preview)
    {
        if (_paymentLivePreview is { } current
