            if (TryParseRs(_cashGivenText, out long given) && given > 0)
            {
                return given;
            }

            if (_paymentMode == PaymentUiMode.Online)
            {
                // Default online tender to full amount due (sale + previous due when registered).
                return PaymentBreakdownCalculator.Compute(
                    IsWalkInCustomer,
                    PreviousDuePaisa,
                    PayablePaisa,
                    paymentReceivedPaisa: 0,
                    PaymentBreakdownMode.Online,
                    applyExcessAsCustomerCredit: false).AmountDuePaisa;
            }

            return 0;
        }
    }

    private PaymentBreakdown ActiveBreakdown
    {
        get
