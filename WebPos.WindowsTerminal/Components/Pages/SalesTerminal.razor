    private void HoldCart()
    {
        if (CartService.IsEmpty)
        {
            return;
        }

        List<CartLine> lines = CartService.Lines
            .Select(line => new CartLine
            {
                LineId = line.LineId,
                Product = line.Product,
                Quantity = line.Quantity,
                UnitPriceOverridePaisa = line.UnitPriceOverridePaisa,
                DescriptionOverride = line.DescriptionOverride,
                PackingOverride = line.PackingOverride
            })
            .ToList();

        CartHoldService.Hold(new HeldCartSnapshot
        {
            Lines = lines,
            Customer = _selectedCustomer,
            UseWalkIn = _useWalkInCustomer,
            DiscountAmountPaisa = DiscountAmountPaisa,
            WhatsAppReceipt = _whatsAppReceipt,
            PrintOnPrinter = _printOnPrinter
        });

        ClearCart();
        _selectedCustomer = null;
        _useWalkInCustomer = true;
        _whatsAppReceipt = false;
        _printOnPrinter = false;
        _successMessage = "Sale held. Press Ctrl+R to retrieve.";
    }

    private void ResumeHeldCart()
    {
        HeldCartSnapshot? snapshot = CartHoldService.Resume();
        if (snapshot is null || snapshot.Lines.Count == 0)
        {
            return;
        }

        CartService.Clear();
        _qtyText.Clear();
        _priceText.Clear();
        _totalText.Clear();

        foreach (CartLine line in snapshot.Lines)
        {
            CartService.Add(line.Product, line.Quantity);
            if (line.UnitPriceOverridePaisa is long overridePrice)
            {
                CartService.SetUnitPrice(line.Product.ProductId, overridePrice);
            }

            SyncLineEditors(line.Product.ProductId);
        }

        _selectedCustomer = snapshot.Customer;
        _useWalkInCustomer = snapshot.UseWalkIn || snapshot.Customer is null;
        _whatsAppReceipt = snapshot.WhatsAppReceipt;
        _printOnPrinter = snapshot.PrintOnPrinter;
        if (snapshot.DiscountAmountPaisa > 0)
        {
            _discountRsText = (snapshot.DiscountAmountPaisa / 100m).ToString(
                "0.##",
                CultureInfo.InvariantCulture);
            SyncDiscountPctFromRs();
        }
        else
        {
            _discountRsText = string.Empty;
            _discountPctText = string.Empty;
        }

        _successMessage = "Held sale retrieved.";
        _checkoutError = null;
    }

    private async Task RequestSaveInvoiceAsync(bool repeat)
    {
        if (repeat || _isBusy || ModalOpen || _saveInFlight)
        {
            return;
        }

        _saveInFlight = true;
        try
        {
            try
            {
                await Js.InvokeVoidAsync("webPosPressSave");
            }
            catch
            {
                /* ignore */
            }

            if (CartService.IsEmpty)
            {
                await QuickCompleteSaleAsync();
                return;
            }

            if (!CanPay)
            {
                return;
            }

            await QuickCompleteSaleAsync();
        }
        finally
        {
            _saveInFlight = false;
        }
    }

    /// <summary>
    /// F12 / Insert / Ctrl+Enter — complete without opening Payment Breakdown.
    /// Empty cart + registered customer + tender → standalone ledger receipt (customer-payment).
    /// </summary>
    private async Task QuickCompleteSaleAsync()
    {
        _checkoutError = null;
        _errorMessage = null;
        _successMessage = null;

        if (CartService.IsEmpty)
        {
            await CompleteStandaloneCustomerReceiptAsync();
            return;
        }

        if (!_useWalkInCustomer && _selectedCustomer is null)
        {
            _checkoutError = "Select a registered customer or switch to Walk-in.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_discountRsText) && !TryParseRs(_discountRsText, out _))
        {
            _checkoutError = "Enter a valid discount amount.";
            return;
        }

        if (DiscountAmountPaisa > CartService.SubtotalPaisa)
        {
            _checkoutError = "Discount cannot exceed the cart total.";
            return;
        }

        PaymentBreakdown breakdown = ActiveBreakdown;

        if (IsWalkInCustomer)
        {
            if (_paymentMode == PaymentUiMode.Credit)
            {
                _checkoutError = "Walk-In payment must cover total amount due.";
                return;
            }

            long received = breakdown.PaymentReceivedPaisa;
            // Walk-In + 0 tender = fully paid; partial underpay still blocked.
            if (received > 0 && received < PayablePaisa)
            {
                _checkoutError = "Walk-In payment must cover total amount due.";
                return;
            }
        }

        if (_paymentMode == PaymentUiMode.Online
            && string.IsNullOrWhiteSpace(_onlineTxnRef))
        {
            _checkoutError = "Enter an online transaction reference, or open Payment Breakdown (Alt+Shift+B).";
            return;
        }

        if (_paymentMode == PaymentUiMode.Online && _paymentAccounts.Count == 0)
        {
            await LoadPaymentAccountsAsync();
        }

        PaymentModal.PaymentCheckoutResult choice = BuildQuickCheckoutResult(breakdown);
        await CompleteSaleFromModalAsync(choice);
    }

    private async Task CompleteStandaloneCustomerReceiptAsync()
    {
        if (IsWalkInCustomer || _selectedCustomer is null)
        {
            _checkoutError = "Select a registered customer to receive a balance payment.";
            return;
        }

        if (_paymentMode == PaymentUiMode.Credit)
        {
            _checkoutError = "Switch to Cash or Online to receive a customer payment.";
            return;
        }

        if (_isBusy)
        {
            return;
        }

        long paid = SidebarPaymentReceivedPaisa;
        if (paid <= 0)
        {
            _checkoutError = "Enter Payment Received to post a customer receipt.";
            return;
        }

        if (_paymentMode == PaymentUiMode.Online && string.IsNullOrWhiteSpace(_onlineTxnRef))
        {
            _checkoutError = "Enter an online transaction reference for the receipt.";
            return;
        }

        string method = CheckoutPaymentMethods.Cash;
        Guid? cashAccountId = null;
        if (_paymentMode == PaymentUiMode.Online)
        {
            if (_paymentAccounts.Count == 0)
            {
                await LoadPaymentAccountsAsync();
            }

            PaymentAccountDto? preferred = _paymentAccounts.FirstOrDefault(a =>
                    string.Equals(a.PaymentMethodKey, _onlineChannel, StringComparison.OrdinalIgnoreCase))
                ?? (_paymentAccounts.Count > 0 ? _paymentAccounts[0] : null);
            if (preferred is null)
            {
                _checkoutError = "No online payment account configured.";
                return;
            }

            cashAccountId = preferred.Id;
            method = string.IsNullOrWhiteSpace(preferred.PaymentMethodKey)
                ? CheckoutPaymentMethods.BankTransfer
                : preferred.PaymentMethodKey;
        }

        string reference = string.IsNullOrWhiteSpace(_onlineTxnRef)
            ? $"CR-{DateTime.UtcNow:yyyyMMddHHmmss}"
            : _onlineTxnRef.Trim();

        _isBusy = true;
        try
        {
            Result<RecordCustomerPaymentResult> result = await CustomerApi.RecordPaymentAsync(
                _selectedCustomer.Id,
                paid,
                method,
                reference,
                shiftId: SessionService.ShiftId == Guid.Empty ? null : SessionService.ShiftId,
                cashAccountId: cashAccountId);

            if (!result.Success)
            {
                _checkoutError = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Customer payment failed."
                    : result.ErrorMessage;
                return;
            }

            Result<PartyDto> refreshed = await CustomerApi.GetCustomerAsync(_selectedCustomer.Id);
            if (refreshed.Success && refreshed.Data is not null)
            {
                _selectedCustomer = refreshed.Data;
            }
            else
            {
                _selectedCustomer = new PartyDto
                {
                    Id = _selectedCustomer.Id,
                    Name = _selectedCustomer.Name,
                    Role = _selectedCustomer.Role,
                    PhoneNumber = _selectedCustomer.PhoneNumber,
                    Email = _selectedCustomer.Email,
                    Address = _selectedCustomer.Address,
                    CreditLimitPaisa = _selectedCustomer.CreditLimitPaisa,
                    CurrentBalancePaisa = _selectedCustomer.CurrentBalancePaisa - paid
                };
            }

            _cashGivenText = string.Empty;
            _onlineTxnRef = string.Empty;
            _successMessage =
                $"Receipt {reference} · Rs {paid / 100m:N2} received · Bal Rs {_selectedCustomer.CurrentBalancePaisa / 100m:N2}";
            await PublishCfdSnapshotAsync("selling");
            await RequestScanFocusAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private PaymentModal.PaymentCheckoutResult BuildQuickCheckoutResult(PaymentBreakdown breakdown)
    {
        if (_paymentMode == PaymentUiMode.Credit)
        {
            return new PaymentModal.PaymentCheckoutResult
            {
                PaymentMethod = CheckoutPaymentMethods.CustomerAccount,
                AmountPaidPaisa = 0,
                CashAccountId = null,
                ApplyExcessAsCustomerCredit = false,
                OnlineTxnRef = null,
                Mode = PaymentModal.PaymentUiMode.Credit,
                ChangePaisa = 0
            };
        }

        if (_paymentMode == PaymentUiMode.Online)
        {
            Guid? accountId = null;
            string method = _onlineChannel;
            if (_paymentAccounts.Count > 0)
            {
                PaymentAccountDto? preferred = _paymentAccounts.FirstOrDefault(a =>
                    string.Equals(a.PaymentMethodKey, _onlineChannel, StringComparison.OrdinalIgnoreCase))
                    ?? _paymentAccounts[0];
                accountId = preferred.Id;
                if (!string.IsNullOrWhiteSpace(preferred.PaymentMethodKey))
                {
                    method = preferred.PaymentMethodKey;
                }
            }

            return new PaymentModal.PaymentCheckoutResult
            {
                PaymentMethod = string.IsNullOrWhiteSpace(method)
                    ? CheckoutPaymentMethods.BankTransfer
                    : method,
                AmountPaidPaisa = breakdown.PaymentReceivedPaisa,
                CashAccountId = accountId,
                ApplyExcessAsCustomerCredit = breakdown.ApplyExcessAsCustomerCredit,
                OnlineTxnRef = _onlineTxnRef.Trim(),
                Mode = PaymentModal.PaymentUiMode.Online,
                ChangePaisa = breakdown.ChangeReturnPaisa
            };
        }

        return new PaymentModal.PaymentCheckoutResult
        {
            PaymentMethod = CheckoutPaymentMethods.Cash,
            AmountPaidPaisa = breakdown.PaymentReceivedPaisa,
            CashAccountId = null,
            ApplyExcessAsCustomerCredit = breakdown.ApplyExcessAsCustomerCredit,
            OnlineTxnRef = null,
            Mode = PaymentModal.PaymentUiMode.Cash,
            ChangePaisa = breakdown.ChangeReturnPaisa
        };
    }

