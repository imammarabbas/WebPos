    private async Task OnQuickLinkAsync(SaleQuickLinkDto link)
    {
        try
        {
            ArgumentNullException.ThrowIfNull(link);
            string linkType = link.LinkType ?? string.Empty;

            if (linkType.Equals("Category", StringComparison.OrdinalIgnoreCase))
            {
                OpenCategoryPick(link.Name);
                return;
            }

            if (linkType.Equals("Master", StringComparison.OrdinalIgnoreCase))
            {
                SaleMasterDto? master = _masters.FirstOrDefault(m => m.ProductId == link.TargetId);
                if (master is null)
                {
                    await LoadMastersAsync();
                    master = _masters.FirstOrDefault(m => m.ProductId == link.TargetId);
                }

                if (master is null)
                {
                    _errorMessage = "No sellable packs for this master yet.";
                    return;
                }

                OpenVariant(master);
                return;
            }

            if (link.Product is SalesProductDto product)
            {
                AddProductToCart(product);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Quick link failed for {Name}.", link?.Name);
            _errorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "Could not open that quick item."
                : ex.Message;
        }
    }

