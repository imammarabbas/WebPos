    private void HoldCart()
    {
        if (CartService.IsEmpty)
        {
            return;
        }

        List<CartLine> lines = CartService.Lines
            .Select(line => new CartLine { Product = line.Product, Quantity = line.Quantity })
            .ToList();

        CartHoldService.Hold(new HeldCartSnapshot
        {
            Lines = lines,
            Customer = _selectedCustomer,
            UseWalkIn = _useWalkInCustomer,
            DiscountAmountPaisa = DiscountAmountPaisa
        });

        ClearCart();
        _selectedCustomer = null;
        _useWalkInCustomer = true;
        _showDiscountInput = false;
        _successMessage = "Cart held.";
    }

    private void ResumeHeldCart()
    {
        HeldCartSnapshot? snapshot = CartHoldService.Resume();
        if (snapshot is null || snapshot.Lines.Count == 0)
        {
            return;
        }

        CartService.Clear();
        _looseQtyText.Clear();

        foreach (CartLine line in snapshot.Lines)
        {
            CartService.Add(line.Product, line.Quantity);
            if (line.Product.IsLoose)
            {
                _looseQtyText[line.Product.BatchId] =
                    line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);
            }
        }

        _selectedCustomer = snapshot.Customer;
        _useWalkInCustomer = snapshot.UseWalkIn || snapshot.Customer is null;
        if (snapshot.DiscountAmountPaisa > 0)
        {
            _showDiscountInput = true;
            _discountRsText = (snapshot.DiscountAmountPaisa / 100m).ToString(
                "0.##",
                CultureInfo.InvariantCulture);
        }
        else
        {
            _showDiscountInput = false;
            _discountRsText = string.Empty;
        }

        _successMessage = "Held cart resumed.";
        _checkoutError = null;
    }

    private async Task PayNowAsync()
    {
        _checkoutError = null;
        _errorMessage = null;
        _successMessage = null;

        if (CartService.IsEmpty)
        {
            _checkoutError = "Cart is empty.";
            return;
        }

        if (!_useWalkInCustomer && _selectedCustomer is null)
        {
            _checkoutError = "Select a registered customer or switch to Walk-in.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_discountRsText)
            && !TryParseRs(_discountRsText, out _)
            && _showDiscountInput)
        {
            _checkoutError = "Enter a valid discount amount.";
            return;
        }

        if (DiscountAmountPaisa > CartService.SubtotalPaisa)
        {
            _checkoutError = "Discount cannot exceed the cart total.";
            return;
        }

        string paymentMethod;
        Guid? customerId = _selectedCustomer?.Id;
        long? changePaisa = null;
        string? txnRef = null;
        long discountPaisa = DiscountAmountPaisa;

        if (_paymentMode == PaymentUiMode.Credit)
        {
            if (_selectedCustomer is null)
            {
                _checkoutError = "Select a registered customer for credit sales.";
                return;
            }

            paymentMethod = CheckoutPaymentMethods.CustomerAccount;
        }
        else if (_paymentMode == PaymentUiMode.Cash)
        {
            paymentMethod = CheckoutPaymentMethods.Cash;
            if (!string.IsNullOrWhiteSpace(_cashGivenText))
            {
                if (!TryParseRs(_cashGivenText, out long given) || given < PayablePaisa)
                {
                    _checkoutError = "Cash given must cover the total.";
                    return;
                }

                changePaisa = given - PayablePaisa;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_onlineTxnRef))
            {
                _checkoutError = "Enter the online transaction reference.";
                return;
            }

            paymentMethod = _onlineChannel;
            txnRef = _onlineTxnRef.Trim();
        }

        List<CartLine> saleLines = CartService.Lines
            .Select(line => new CartLine { Product = line.Product, Quantity = line.Quantity })
            .ToList();
        string? customerPhone = _selectedCustomer?.PhoneNumber;

        _isBusy = true;
        try
        {
            Result<CompleteSaleResult> result = await SalesApi.CompleteCartAsync(
                CartService.Lines,
                paymentMethod,
                customerId,
                discountPaisa);

            if (!result.Success)
            {
                _checkoutError = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Sale failed."
                    : result.ErrorMessage;
                return;
            }

            CompleteSaleResult sale = result.Data!;
            string paymentLabel = CheckoutPaymentMethods.DisplayLabel(paymentMethod);

            LastSaleReceiptStore.Set(new LastSaleReceipt
            {
                Sale = sale,
                Lines = saleLines,
                PaymentLabel = paymentLabel,
                OnlineTxnRef = txnRef,
                ChangePaisa = changePaisa,
                CustomerPhone = customerPhone
            });

            _successMessage =
                $"Sale complete · {sale.InvoiceNo} · Rs {FormatRs(sale.TotalAmountPaisa)}";

            _looseQtyText.Clear();
            CartService.Clear();
            _cashGivenText = string.Empty;
            _onlineTxnRef = string.Empty;
            _discountRsText = string.Empty;
            _showDiscountInput = false;
            _selectedCustomer = null;
            _useWalkInCustomer = true;
            _paymentMode = PaymentUiMode.Cash;

            await Task.WhenAll(
                LoadProductsAsync(),
                ShiftStatus.RefreshAsync(),
                LoadRecentBillsAsync());

            await _scanInput.FocusAsync();
        }
        catch (SessionNotActiveException)
        {
            _checkoutError = "Start Shift before processing a sale.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task WhatsAppOrPrintAsync()
    {
        _whatsAppError = null;
        LastSaleReceipt? receipt = LastSaleReceiptStore.Current;
        if (receipt is null)
        {
            _errorMessage = "No recent sale to send. Complete a sale first.";
            return;
        }

        string? phone = receipt.CustomerPhone;
        if (string.IsNullOrWhiteSpace(phone))
        {
            _whatsAppPhone = string.Empty;
            _showPhonePrompt = true;
            return;
        }

        await OpenWhatsAppAsync(phone, receipt);
    }

    private async Task ConfirmWhatsAppPhoneAsync()
    {
        LastSaleReceipt? receipt = LastSaleReceiptStore.Current;
        if (receipt is null)
        {
            _showPhonePrompt = false;
            return;
        }

        await OpenWhatsAppAsync(_whatsAppPhone, receipt);
    }

    private async Task OpenWhatsAppAsync(string phone, LastSaleReceipt receipt)
    {
        _whatsAppError = null;
        string message = WhatsAppReceiptService.BuildReceiptMessage(
            receipt.Sale,
            receipt.Lines,
            receipt.PaymentLabel,
            receipt.OnlineTxnRef,
            receipt.ChangePaisa);

        string? url = WhatsAppReceiptService.BuildWhatsAppUrl(phone, message);
        if (url is null)
        {
            _whatsAppError = "Enter a valid mobile number (e.g. 03009998877).";
            _showPhonePrompt = true;
            return;
        }

        _showPhonePrompt = false;
        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch (Exception)
        {
            _whatsAppError = "Could not open WhatsApp. Copy the number and send manually.";
            _showPhonePrompt = true;
        }
    }

    private void ClosePhonePrompt()
    {
        _showPhonePrompt = false;
        _whatsAppError = null;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _showPhonePrompt)
        {
            ClosePhonePrompt();
            return;
        }

        if (e.Key == "Escape" && _showReceiveGoods)
        {
            CloseReceiveGoods();
            return;
        }

        if (e.Key is "F9" && !_isBusy && !_showPhonePrompt)
        {
            OpenReceiveGoods();
            return;
        }

        if (e.Key == "Enter" && !_isBusy && !_showPhonePrompt && !_showReceiveGoods && !string.IsNullOrWhiteSpace(_scanText))
        {
            await AddFromScanAsync();
        }
    }

    private void OpenReceiveGoods()
    {
        _errorMessage = null;
        _showReceiveGoods = true;
    }

    private void CloseReceiveGoods() => _showReceiveGoods = false;

    private async Task OnGoodsReceivedAsync()
    {
        _successMessage = "Stock received — inventory updated.";
        await Task.WhenAll(LoadProductsAsync(), LoadReceiveProductsAsync(), ShiftStatus.RefreshAsync());
    }

    private static bool TryParseRs(string text, out long paisa)
    {
        paisa = 0;
        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal rupees)
            && !decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out rupees))
        {
            return false;
        }

        if (rupees < 0)
        {
            return false;
        }

        paisa = (long)Math.Round(rupees * 100m, MidpointRounding.AwayFromZero);
        return true;
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private static string FormatQty(CartLine line) =>
        line.Product.IsLoose
            ? line.Quantity.ToString("0.##")
            : line.Quantity.ToString("0");

    private static string DisplayCategory(SalesProductDto product) =>
        string.IsNullOrWhiteSpace(product.CategoryName) ? "General" : product.CategoryName;

    private static string ShortId(string invoiceNo) =>
        invoiceNo.Length <= 8 ? invoiceNo : invoiceNo[^8..];

    public void Dispose()
    {
        CartService.Changed -= OnCartChanged;
        ShiftStatus.Changed -= OnShiftStatusChanged;
        _clockTimer?.Dispose();
    }
