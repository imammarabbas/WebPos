        RemoveLine(line);
    }

    private void UpsertProductInCache(SalesProductDto product)
    {
        int index = _products.FindIndex(p => p.ProductId == product.ProductId);
        if (index >= 0)
        {
            _products[index] = product;
            return;
        }

        _products.Add(product);
    }

    private static void PlayNotFoundBeep()
    {
        try { Console.Beep(880, 160); }
        catch (Exception) { /* ignore */ }
    }

    private string GetQtyText(CartLine line) =>
        _qtyText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);

    private string GetPriceText(CartLine line) =>
        _priceText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : FormatRs(line.EffectiveUnitPricePaisa);

    private void OnQtyChanged(CartLine line, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        _qtyText[line.Product.ProductId] = raw;
        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal quantity)
            && !decimal.TryParse(raw, NumberStyles.Number, CultureInfo.CurrentCulture, out quantity))
        {
            return;
        }

        if (quantity <= 0)
        {
            return;
        }

        if (quantity > line.Product.AvailableStock)
        {
            _errorMessage =
                $"Only {line.Product.AvailableStock:0.##} units of {line.Product.Name} are available.";
            return;
        }

        _errorMessage = null;
        CartService.SetQuantity(line.Product.ProductId, quantity);
    }

    private void OnPriceChanged(CartLine line, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        _priceText[line.Product.ProductId] = raw;
        if (!TryParseRs(raw, out long paisa))
        {
            return;
        }

        CartService.SetUnitPrice(line.Product.ProductId, paisa);
    }

    private void RemoveLine(CartLine line)
    {
        _qtyText.Remove(line.Product.ProductId);
        _priceText.Remove(line.Product.ProductId);
        CartService.Remove(line.Product.ProductId);
        _selectedLineIndex = Math.Min(_selectedLineIndex, CartService.Lines.Count - 1);
        _scanFocus.OnRowRemoved();
    }

