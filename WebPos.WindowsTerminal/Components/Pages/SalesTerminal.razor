@page "/sales"
@using System.Globalization
@using Common.Models
@using Microsoft.Extensions.Logging
@using WebPos.WindowsTerminal
@using WebPos.WindowsTerminal.Services
@implements IDisposable
@inject SalesApiClient SalesApi
@inject CashAccountApiClient CashAccounts
@inject CartService CartService
@inject CustomerApiClient CustomerApi
@inject WhatsAppReceiptService WhatsAppReceiptService
@inject ISessionService SessionService
@inject InvoiceApiClient InvoiceApi
@inject PurchaseIntakeApiClient PurchaseIntake
@inject ShiftStatusApiClient ShiftStatus
@inject LastSaleReceiptStore LastSaleReceiptStore
@inject CartHoldService CartHoldService
@inject LoginApiClient Login
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ILogger<SalesTerminal> Logger
@inject CustomerDisplayState CustomerDisplayState
@inject IBarcodeScannerService BarcodeScanner

<PageTitle>Smart POS</PageTitle>

<div class="pos-shell sf-shell smart-pos" @onkeydown="OnKeyDown" tabindex="0">
    <PosTopMenu OnPurchaseOrders="OpenPurchaseOrdersAsync"
                OnCreatePurchaseOrder="OpenCreatePurchaseOrder"
                OnLockRequested="LockTerminal"
                OnHold="HoldCart"
                OnRetrieve="ResumeHeldCart" />

    <div class="sp-banner">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert-red" role="alert" aria-live="assertive">@_errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_checkoutError))
        {
            <p class="field-error sf-checkout-error sp-checkout-error" role="alert">@_checkoutError</p>
        }
    </div>

    <section class="sp-search-section">
        <div class="sp-search-grid">
            <div class="sp-search-wrap">
                <input id="scanInput"
                       class="sp-search-input"
                       type="text"
                       placeholder="Enter item code, description or barcode..."
                       autocomplete="off"
                       inputmode="search"
                       @ref="_scanInput"
                       value="@_scanText"
                       @oninput="OnScanInput"
                       @onkeydown="OnScanKeyDown"
                       @onfocus="OnScanFocus"
                       @onblur="OnScanBlur"
                       disabled="@(_isBusy || ModalOpen)" />
                <button type="button"
                        class="sp-search-mode @(_broadSearch ? "active" : null)"
                        id="searchIconToggle"
                        title="@(_broadSearch ? "All: name and barcode" : "Code only: barcode")"
                        aria-label="@(_broadSearch ? "Switch to code-only search" : "Switch to name and barcode search")"
                        aria-pressed="@_broadSearch"
                        disabled="@(_isBusy || ModalOpen)"
                        @onclick="OnSearchIconClick">
                    <i class="fa-solid @(_broadSearch ? "fa-xmark" : "fa-magnifying-glass")" aria-hidden="true"></i>
                </button>
                @if (_showScanDropdown && ScanHits.Count > 0)
                {
                    <ul class="sf-scan-dropdown" role="listbox">
                        @foreach ((object hit, int i) in ScanHits.Select((h, i) => (h, i)))
                        {
                            <li class="@(i == _scanHighlight ? "active" : null)"
                                role="option"
                                @onmousedown:preventDefault
                                @onclick="() => ChooseScanHitAsync(hit)">
                                @if (hit is SalesProductDto p)
                                {
                                    <strong>@p.Name</strong>
                                    <span>@(string.IsNullOrWhiteSpace(p.ShortCode) ? p.Barcode : p.ShortCode) · Rs @FormatRs(p.UnitPricePaisa)</span>
                                }
                                else if (hit is SaleMasterDto m)
                                {
                                    <strong>@m.Name</strong>
                                    <span>Master · @(m.ShortCode ?? "—") · @((m.Children?.Count) ?? 0) pack(s)</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="sp-qty-chip @(CartService.TotalQuantity > 0 ? "has-items" : null)" title="Total quantity">
                <span>Quantity</span>
                <strong>@FormatQty(CartService.TotalQuantity)</strong>
            </div>
            <div class="sp-invoice">
                <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
                <span>Invoice #@_draftInvoiceNo</span>
            </div>
        </div>
    </section>

    <main class="sp-main-content">
        <section class="sp-table-card">
            <div class="sp-table-scroll" @ref="_tableScroll">
                <table class="sp-items-table" style="--sp-slots: @VisibleSlotCount">
                    <thead>
                        <tr>
                            <th class="text-center col-sr">Sr. #</th>
                            <th class="col-code">Item Code</th>
                            <th class="col-desc">Description</th>
                            <th class="col-pack">Packing</th>
                            <th class="text-right col-qty">Qty</th>
                            <th class="text-right col-price">Price</th>
                            <th class="text-right col-total">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            IReadOnlyList<CartLine> cartLines = CartService.Lines;
                            for (int row = 0; row < VisibleSlotCount; row++)
                            {
                                if (row < cartLines.Count)
                                {
                                    int index = row;
                                    CartLine line = cartLines[index];
                                    bool selected = index == _selectedLineIndex;
                                    <tr class="@(selected ? "selected row-selected" : null) @(line.LineId == _lastScannedLineId ? "item-added" : null) @(index % 2 == 1 ? "zebra" : null)"
                                        data-line-id="@line.LineId"
                                        @onmousedown="() => SelectLine(index)"
                                        @onclick="() => SelectLine(index)">
                                        <td class="col-sr text-center">@(index + 1)</td>
                                        <td class="col-code">
                                            <input id="@CellId(line.LineId, "itemCode")"
                                                   class="sf-cell-input sf-cell-input-text"
                                                   type="text"
                                                   value="@GetCodeText(line)"
                                                   @oninput="e => OnCodeInput(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "itemCode")'
                                                   @onblur="() => OnCodeCommit(line)"
                                                   @onkeydown='e => OnCellKeyDown(e, index, "itemCode")'
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-desc">
                                            <input id="@CellId(line.LineId, "description")"
                                                   class="sf-cell-input sf-cell-input-text"
                                                   type="text"
                                                   value="@GetDescText(line)"
                                                   @oninput="e => OnDescInput(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "description")'
                                                   @onkeydown='e => OnCellKeyDown(e, index, "description")'
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-pack">
                                            <input id="@CellId(line.LineId, "packing")"
                                                   class="sf-cell-input sf-cell-input-text"
                                                   type="text"
                                                   value="@GetPackText(line)"
                                                   @oninput="e => OnPackInput(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "packing")'
                                                   @onkeydown='e => OnCellKeyDown(e, index, "packing")'
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-qty">
                                            <input id="@CellId(line.LineId, "qty")"
                                                   class="sf-cell-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   value="@GetQtyText(line)"
                                                   @oninput="e => OnQtyChanged(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "qty")'
                                                   @onkeydown='e => OnCellKeyDown(e, index, "qty")'
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-price">
                                            <input id="@CellId(line.LineId, "price")"
                                                   class="sf-cell-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   value="@GetPriceText(line)"
                                                   title="@(line.UnitPriceOverridePaisa is not null
                                                       ? $"Catalog Rs {FormatRs(line.Product.UnitPricePaisa)}"
                                                       : "Unit selling price")"
                                                   @oninput="e => OnPriceChanged(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "price")'
                                                   @onblur="() => OnPriceBlur(line)"
                                                   @onkeydown='e => OnCellKeyDown(e, index, "price")'
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-total">
                                            <input id="@CellId(line.LineId, "total")"
                                                   class="sf-cell-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   value="@GetTotalText(line)"
                                                   @oninput="e => OnTotalInput(line, e)"
                                                   @onfocus='() => OnCellFocusAsync(index, "total")'
                                                   @onblur="() => CommitTotal(line)"
                                                   @onkeydown='e => OnCellKeyDown(e, index, "total")'
                                                   disabled="@_isBusy" />
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="sp-empty-row @(row % 2 == 1 ? "zebra" : null)">
                                        <td class="col-sr text-center empty">@(row + 1)</td>
                                        <td class="col-code empty"><span class="sp-item-code-placeholder">Item code</span></td>
                                        <td class="empty"></td>
                                        <td class="empty"></td>
                                        <td class="empty"></td>
                                        <td class="empty"></td>
                                        <td class="empty"></td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="sp-lower-panels">
            <div class="sp-customer-bar">
                <button type="button" class="sp-customer-icon" title="Use walk-in customer" disabled="@(_isBusy || ModalOpen)" @onclick="SelectWalkInCustomer">
                    <i class="fa-solid fa-user"></i>
                </button>
                <div class="sp-customer-field sp-customer-code">
                    <label for="customerCode">Customer Code</label>
                    <input id="customerCode"
                           class="sp-customer-input"
                           value="@CustomerCodeDisplay"
                           readonly
                           disabled="@(_isBusy || ModalOpen)"
                           @onclick="OpenSearchCustomerAsync" />
                </div>
                <div class="sp-customer-field sp-customer-name">
                    <label for="customerName">Customer Name</label>
                    <input id="customerName"
                           class="sp-customer-input"
                           value="@CustomerNameDisplay"
                           readonly
                           disabled="@(_isBusy || ModalOpen)"
                           @onclick="OpenSearchCustomerAsync" />
                </div>
                <div class="sp-customer-actions">
                    <div class="sp-customer-action">
                        <i class="fa-solid fa-print" aria-hidden="true"></i>
                        <span>Print Receipt</span>
                        <label class="sp-switch">
                            <input type="checkbox" checked="@_printOnPrinter" @onchange="OnPrintToggle" disabled="@(_isBusy || ModalOpen)" />
                            <span class="sp-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="sp-finance-panel">
                <div class="sp-invoice-summary">
                    <div class="sp-summary-item">
                        <div class="sp-summary-label">Previous Due</div>
                        <div class="sp-summary-value">@FormatRs(PreviousDuePaisa)</div>
                    </div>
                    <div class="sp-summary-item">
                        <div class="sp-summary-label">
                            Discount
                            <span class="sp-shortcut-hint" title="Alt+Shift+P / Alt+Shift+C">Alt+Shift+P/C</span>
                        </div>
                        <div class="sp-discount-display">
                            <input id="pos-discount-pct"
                                   type="text"
                                   inputmode="decimal"
                                   title="Discount %"
                                   placeholder="0"
                                   value="@_discountPctText"
                                   @oninput="OnDiscountPctInput"
                                   @onfocus="OnDiscountFocusAsync"
                                   @onblur="OnDiscountBlur"
                                   disabled="@_isBusy" />
                            <span class="sp-discount-percent">%</span>
                            <input id="pos-discount-rs"
                                   type="text"
                                   inputmode="decimal"
                                   title="Discount amount"
                                   placeholder="0.00"
                                   value="@_discountRsText"
                                   @oninput="OnDiscountRsInput"
                                   @onfocus="OnDiscountRsFocusAsync"
                                   disabled="@_isBusy" />
                        </div>
                    </div>
                    <div class="sp-summary-item sp-payment-preview">
                        <div class="sp-summary-label">
                            Payment Received
                            <span class="sp-shortcut-hint" title="Alt+C focuses Payment Received">Alt+C</span>
                        </div>
                        <input id="pos-payment"
                               name="posCashTender"
                               class="sp-summary-input"
                               type="text"
                               inputmode="decimal"
                               autocomplete="off"
                               autocapitalize="off"
                               autocorrect="off"
                               spellcheck="false"
                               placeholder="0.00"
                               title="Cash received · Alt+C focus · F12 save"
                               value="@_cashGivenText"
                               @oninput="OnPaymentInput"
                               @onfocus="OnPaymentFocusAsync"
                               @onblur="OnPaymentBlur"
                               disabled="@(_isBusy || ModalOpen)" />
                    </div>
                    <div class="sp-summary-item sp-balance-summary @BalanceSummaryToneClass">
                        <div class="sp-summary-label">@BalanceSummaryLabel</div>
                        <div class="sp-summary-value sp-balance-value @BalanceSummaryValueClass">
                            @BalanceSummaryDisplay
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <section class="sp-action-bar" role="toolbar" aria-label="POS shortcuts">
        <div class="sp-category-shortcuts" aria-label="Category shortcuts">
            @foreach ((string name, string icon) in CategoryChipItems)
            {
                bool chipActive = string.Equals(_activeCategoryChip, name, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="sp-category-chip @(chipActive ? "is-active" : null)"
                        disabled="@(_isBusy || ModalOpen)"
                        title="@name"
                        @onclick="() => OnCategoryChipAsync(name)">
                    <i class="fa-solid @icon" aria-hidden="true"></i>
                    <span>@name</span>
                </button>
            }
        </div>
        <div class="sp-action-bar-shortcuts">
            <button type="button" class="sp-action-btn" data-pos-fkey="F2" disabled="@ModalOpen" @onclick="OpenItemSearch">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sp-action-key">F2</span>
                <span class="sp-action-label">Search Product</span>
            </button>
            <button type="button" class="sp-action-btn" data-pos-fkey="F4" disabled="@ModalOpen" @onclick="OpenSearchCustomerAsync">
                <i class="fa-solid fa-user" aria-hidden="true"></i>
                <span class="sp-action-key">F4</span>
                <span class="sp-action-label">Search Customer</span>
            </button>
            <button type="button" class="sp-action-btn" data-pos-fkey="F8" disabled="@(_isBusy || ModalOpen)" @onclick="NewSale">
                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                <span class="sp-action-key">F8</span>
                <span class="sp-action-label">Clear Invoice</span>
            </button>
            <button type="button"
                    class="sp-action-btn"
                    disabled="@(_isBusy || ModalOpen || CartService.IsEmpty)"
                    title="Alt+Shift+B"
                    @onclick="OpenPaymentModalAsync">
                <i class="fa-solid fa-receipt" aria-hidden="true"></i>
                <span class="sp-action-key">Alt+Shift+B</span>
                <span class="sp-action-label">Payment Breakdown</span>
            </button>
            <button type="button"
                    class="sp-save"
                    id="saveInvoiceButton"
                    disabled="@(_isBusy || (!CartService.IsEmpty && !CanPay))"
                    @onclick="OnSaveInvoiceClick">
                <div class="sp-save-icon">
                    <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                </div>
                <div class="sp-save-title">Save Invoice</div>
                <div class="sp-save-shortcuts">
                    <span class="sp-shortcut-chip">Insert</span>
                    <span class="sp-shortcut-chip">Ctrl + Enter</span>
                    <span class="sp-shortcut-chip">F12</span>
                </div>
            </button>
        </div>
    </section>

    <footer class="sp-status-bar">
        <div>
            User : @CashierDisplayName
            <span>@FormatClock(_now)</span>
            <span> · Drawer Rs @FormatRs(ShiftStatus.ExpectedCashPaisa)</span>
        </div>
        <div>Version: v1.0.0</div>
    </footer>
</div>
@if (_showPhonePrompt)
{
    <div class="modal-backdrop" @onclick="ClosePhonePrompt">
        <div class="success-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>WhatsApp phone</h2>
            <p class="success-invoice">Enter a number for the walk-in receipt.</p>
            <label class="field-label" for="waPhone">WhatsApp phone</label>
            <input id="waPhone"
                   class="txn-ref-input"
                   type="tel"
                   placeholder="03xxxxxxxxx"
                   @bind="_whatsAppPhone"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_whatsAppError))
            {
                <p class="field-error">@_whatsAppError</p>
            }
            <div class="checkout-actions">
                <button type="button" class="secondary-btn" @onclick="ClosePhonePrompt">Cancel</button>
                <button type="button" class="pay-btn" @onclick="ConfirmWhatsAppPhoneAsync">Send</button>
            </div>
        </div>
    </div>
}

<SelectVariantModal Master="@_variantMaster"
                    OnClose="CloseVariant"
                    OnSelected="OnVariantSelected" />

<CategoryPickModal CategoryName="@_categoryPickName"
                   Products="@_products"
                   Masters="@_masters"
                   OnClose="CloseCategoryPick"
                   OnProductSelected="OnCategoryProductSelected"
                   OnMasterSelected="OnCategoryMasterSelected" />

<ItemSearchModal Visible="@_showItemSearch"
                 InitialQuery="@_itemSearchSeed"
                 Products="@_products"
                 Masters="@_masters"
                 OnClose="CloseItemSearch"
                 OnProductSelected="OnSearchProductSelected"
                 OnMasterSelected="OnSearchMasterSelected" />

<PriceCheckerModal Visible="@_showPriceChecker"
                   Products="@_products"
                   Masters="@_masters"
                   OnClose="() => _showPriceChecker = false" />

<CustomerSearchModal Visible="@_showCustomerSearch"
                     Customers="@_customers"
                     OnClose="() => _showCustomerSearch = false"
                     OnSelected="OnCustomerPickedAsync"
                     OnWalkInSelected="OnWalkInPickedAsync" />

<CustomerAddModal Visible="@_showCustomerAdd"
                  OnClose="() => _showCustomerAdd = false"
                  OnCreated="OnCustomerCreatedAsync" />

<CalculatorModal Visible="@_showCalculator"
                 OnClose="() => _showCalculator = false" />

<PaymentModal Visible="@_showPaymentModal"
              LineCount="CartService.Lines.Count"
              QuantityTotal="CartService.Lines.Sum(l => l.Quantity)"
              SubtotalPaisa="CartService.SubtotalPaisa"
              DiscountPaisa="DiscountAmountPaisa"
              AmountDuePaisa="PayablePaisa"
              PreviousDuePaisa="PreviousDuePaisa"
              Customer="@(_useWalkInCustomer ? null : _selectedCustomer)"
              InitialMode="ToModalPaymentMode()"
              InitialOnlineMethod="@_onlineChannel"
              InitialTxnRef="@_onlineTxnRef"
              InitialTenderText="@_cashGivenText"
              PaymentAccounts="_paymentAccounts"
              OnCancel="ClosePaymentModal"
              OnConfirm="OnPaymentConfirmedAsync"
              OnLivePreviewChanged="OnPaymentLivePreviewAsync" />

<CreatePurchaseOrderModal @ref="_createPurchaseOrderModal"
                          Visible="_showCreatePurchaseOrder"
                          EditingPurchaseOrderId="_editingPurchaseOrderId"
                          InitialSupplierId="_createPoSupplierId"
                          IntakeService="PurchaseIntake"
                          ReceiverId="SessionService.CashierId"
                          OnClose="CloseCreatePurchaseOrder"
                          OnMinimize="MinimizeCreatePurchaseOrder"
                          OnCreated="OnPurchaseOrderCreatedAsync"
                          OnSaved="OnPurchaseOrderSavedAsync"
                          OnReceived="OnPurchaseOrderReceivedAsync" />

<PurchaseOrdersModal Visible="_showPurchaseOrders"
                     IntakeService="PurchaseIntake"
                     OnClose="ClosePurchaseOrders"
                     OnMinimize="MinimizePurchaseOrders"
                     OnCreatePurchaseOrder="OpenCreateFromPurchaseOrders"
                     OnEditPurchaseOrder="OpenEditPurchaseOrder"
                     OnReceivePurchaseOrder="OpenReceivePurchaseOrder" />

@if (_purchaseOrdersMinimized || _createPurchaseOrderMinimized)
{
    <div class="pos-mini-dock" role="status" aria-label="Minimized windows">
        @if (_createPurchaseOrderMinimized)
        {
            <button type="button" class="pos-mini-chip orders" @onclick="RestoreCreatePurchaseOrder">
                <span class="pos-mini-ico orders-ico" aria-hidden="true"></span>
                <span class="pos-mini-text">
                    <strong>@(_editingPurchaseOrderId is Guid ? "Edit Purchase Order" : "Create Purchase Order")</strong>
                    <span>
                        @(string.IsNullOrWhiteSpace(_cpoMiniInvoice) ? "Draft" : _cpoMiniInvoice)
                        · @_cpoMiniLineCount line@(_cpoMiniLineCount == 1 ? "" : "s")
                    </span>
                </span>
                <span class="pos-mini-badge">Minimized</span>
            </button>
        }
        @if (_purchaseOrdersMinimized)
        {
            <button type="button" class="pos-mini-chip orders" @onclick="RestorePurchaseOrders">
                <span class="pos-mini-ico orders-ico" aria-hidden="true"></span>
                <span class="pos-mini-text">
                    <strong>Purchase Orders</strong>
                    <span>List parked · tap to restore</span>
                </span>
                <span class="pos-mini-badge">Minimized</span>
            </button>
        }
    </div>
}

@code {
    private enum PaymentUiMode
    {
        Cash,
        Online,
        Credit
    }

    private ElementReference _scanInput;
    private ElementReference _tableScroll;
    private DotNetObjectReference<SalesTerminal>? _selfRef;
    private int _slotCount = 16;
    private bool _tableWatchBound;
    private int VisibleSlotCount => Math.Max(Math.Min(_slotCount, CartService.MaxLines), CartService.Lines.Count);
    private readonly SalesScanFocusCoordinator _scanFocus = new();
    private List<SalesProductDto> _products = [];
    private List<SaleMasterDto> _masters = [];
    private List<SaleQuickLinkDto> _quickLinks = [];
    private IReadOnlyList<PartyDto> _customers = [];
    private readonly Dictionary<Guid, string> _qtyText = [];
    private readonly Dictionary<Guid, string> _priceText = [];
    private readonly Dictionary<Guid, string> _totalText = [];
    private readonly Dictionary<Guid, string> _codeText = [];
    private string? _focusedField;
    private Guid? _lastScannedLineId;
    private Guid? _pendingFlashLineId;
    private static readonly string[] TableFields = ["itemCode", "description", "packing", "qty", "price", "total"];

    private string _scanText = string.Empty;
    private bool _searchOpen;
    private bool _showScanDropdown;
    private bool _broadSearch;
    private int _scanHighlight;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _checkoutError;
    private string? _customerLoadError;
    private string? _whatsAppError;
    private bool _isBusy;
    private bool _saveInFlight;
    private bool _useWalkInCustomer = true;
    private bool _showPhonePrompt;
    private bool _showPurchaseOrders;
    private bool _showCreatePurchaseOrder;
    private bool _purchaseOrdersMinimized;
    private bool _createPurchaseOrderMinimized;
    private Guid? _editingPurchaseOrderId;
    private Guid? _createPoSupplierId;
    private string _cpoMiniInvoice = string.Empty;
    private int _cpoMiniLineCount;
    private CreatePurchaseOrderModal? _createPurchaseOrderModal;
    private bool _showItemSearch;
    private string _itemSearchSeed = string.Empty;
    private bool _showPriceChecker;
    private bool _showCustomerSearch;
    private bool _showCustomerAdd;
    private bool _showCalculator;
    private bool _whatsAppReceipt;
    private bool _printOnPrinter;
    private bool _isDisposed;
    private string _cashGivenText = string.Empty;
    private string _discountRsText = string.Empty;
    private string _discountPctText = string.Empty;
    private string _remarks = string.Empty;
    private string _draftInvoiceNo = string.Empty;
    private DateTime _saleDate = DateTime.Today;
    private string _onlineChannel = CheckoutPaymentMethods.EasyPaisa;
    private string _onlineTxnRef = string.Empty;
    private string _whatsAppPhone = string.Empty;
    private PartyDto? _selectedCustomer;
    private SaleMasterDto? _variantMaster;
    private string? _categoryPickName;
    private string? _activeCategoryChip;
    private string _cfdPhase = "selling";
    private PaymentUiMode _paymentMode = PaymentUiMode.Cash;
    private DateTime _now = DateTime.Now;
    private Timer? _clockTimer;
    private int _selectedLineIndex = -1;
    private bool _restoreUiPending;
    private bool _showPaymentModal;
    private IReadOnlyList<PaymentAccountDto> _paymentAccounts = [];

    /// <summary>
    /// True when any overlay owns the screen — global barcode must not add to the sales cart.
    /// Includes Create PO, Price Checker, Item Search, payment, variant pick, and related modals.
    /// </summary>
    private bool ModalOpen =>
        _showPhonePrompt
        || _showPurchaseOrders
        || _showCreatePurchaseOrder
        || _showItemSearch
        || _showPriceChecker
        || _showCustomerSearch
        || _showCustomerAdd
        || _showCalculator
        || _showPaymentModal
        || _variantMaster is not null
        || !string.IsNullOrWhiteSpace(_categoryPickName);

    private static string DisplayCodeFor(PartyDto customer)
    {
        string phone = customer.PhoneNumber ?? string.Empty;
        string digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length >= 5)
        {
            return digits[^5..];
        }

        return customer.Id.ToString("N")[^5..].ToUpperInvariant();
    }

