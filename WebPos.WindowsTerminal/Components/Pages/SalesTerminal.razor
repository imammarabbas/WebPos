    private static string ItemCode(SalesProductDto product) =>
        !string.IsNullOrWhiteSpace(product.ShortCode)
            ? product.ShortCode
            : (!string.IsNullOrWhiteSpace(product.Barcode) ? product.Barcode : product.Sku);

    private static bool IsSearchableKey(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey || string.IsNullOrEmpty(e.Key) || e.Key.Length != 1)
        {
            return false;
        }

        return char.IsLetterOrDigit(e.Key[0]);
    }

    private static bool TryParseRs(string text, out long paisa)
    {
        paisa = 0;
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        string cleaned = text.Trim();
        if (cleaned.StartsWith("Rs", StringComparison.OrdinalIgnoreCase))
        {
            cleaned = cleaned[2..].Trim();
        }

        cleaned = cleaned
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .Replace(",", string.Empty, StringComparison.Ordinal);

        if (!decimal.TryParse(cleaned, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal rupees)
            && !decimal.TryParse(cleaned, NumberStyles.Number, CultureInfo.CurrentCulture, out rupees))
        {
            return false;
        }

        if (rupees < 0)
        {
            return false;
        }

        paisa = (long)Math.Round(rupees * 100m, MidpointRounding.AwayFromZero);
        return true;
    }

    private void CapturePosUiState()
    {
        PosUiStateStore.Shared.Save(new PosUiSnapshot
        {
            ScanText = _scanText,
            BroadSearch = _broadSearch,
            SearchOpen = _searchOpen,
            ScanHighlight = _scanHighlight,
            SelectedLineIndex = _selectedLineIndex,
            FocusedField = _focusedField,
            LastScannedLineId = _lastScannedLineId,
            DiscountRsText = _discountRsText,
            DiscountPctText = _discountPctText,
            CashGivenText = _cashGivenText,
            Remarks = _remarks,
            DraftInvoiceNo = _draftInvoiceNo,
            SaleDate = _saleDate,
            OnlineChannel = _onlineChannel,
            OnlineTxnRef = _onlineTxnRef,
            WhatsAppPhone = _whatsAppPhone,
            WhatsAppReceipt = _whatsAppReceipt,
            PrintOnPrinter = _printOnPrinter,
            UseWalkInCustomer = _useWalkInCustomer,
            SelectedCustomer = _selectedCustomer,
            PaymentMode = (int)_paymentMode,
            QtyText = new Dictionary<Guid, string>(_qtyText),
            PriceText = new Dictionary<Guid, string>(_priceText),
            TotalText = new Dictionary<Guid, string>(_totalText),
            CodeText = new Dictionary<Guid, string>(_codeText)
        });
    }

    private void RestorePosUiState()
    {
        PosUiSnapshot? snap = PosUiStateStore.Shared.Snapshot;
        if (snap is null)
        {
            return;
        }

        _scanText = snap.ScanText ?? string.Empty;
        _broadSearch = snap.BroadSearch;
        _searchOpen = snap.SearchOpen || _scanText.Trim().Length > 0;
        _scanHighlight = snap.ScanHighlight;
        _showScanDropdown = _scanText.Trim().Length > 0;
        _selectedLineIndex = snap.SelectedLineIndex;
        _focusedField = snap.FocusedField;
        _lastScannedLineId = snap.LastScannedLineId;
        _discountRsText = snap.DiscountRsText ?? string.Empty;
        _discountPctText = snap.DiscountPctText ?? string.Empty;
        _cashGivenText = snap.CashGivenText ?? string.Empty;
        _remarks = snap.Remarks ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(snap.DraftInvoiceNo))
        {
            _draftInvoiceNo = snap.DraftInvoiceNo;
        }

        if (snap.SaleDate != default)
        {
            _saleDate = snap.SaleDate;
        }

        if (!string.IsNullOrWhiteSpace(snap.OnlineChannel))
        {
            _onlineChannel = snap.OnlineChannel;
        }

        _onlineTxnRef = snap.OnlineTxnRef ?? string.Empty;
        _whatsAppPhone = snap.WhatsAppPhone ?? string.Empty;
        _whatsAppReceipt = snap.WhatsAppReceipt;
        _printOnPrinter = snap.PrintOnPrinter;
        _useWalkInCustomer = snap.UseWalkInCustomer;
        _selectedCustomer = snap.SelectedCustomer;
        _paymentMode = snap.PaymentMode switch
        {
            1 => PaymentUiMode.Online,
            2 => PaymentUiMode.Credit,
            _ => PaymentUiMode.Cash
        };

        CopyEditorText(_qtyText, snap.QtyText);
        CopyEditorText(_priceText, snap.PriceText);
        CopyEditorText(_totalText, snap.TotalText);
        CopyEditorText(_codeText, snap.CodeText);

        if (CartService.Lines.Count == 0)
        {
            _selectedLineIndex = -1;
        }
        else if (_selectedLineIndex >= CartService.Lines.Count)
        {
            _selectedLineIndex = CartService.Lines.Count - 1;
        }

        _restoreUiPending = true;
    }

    private static void CopyEditorText(Dictionary<Guid, string> target, Dictionary<Guid, string>? source)
    {
        target.Clear();
        if (source is null)
        {
            return;
        }

        foreach (KeyValuePair<Guid, string> pair in source)
        {
            target[pair.Key] = pair.Value;
        }
    }

    private async Task RestorePosUiFocusAsync()
    {
        string? fallbackId = null;
        if (_focusedField == "search")
        {
            fallbackId = "scanInput";
        }
        else if (_focusedField is "discount" or "discountPct")
        {
            fallbackId = "pos-discount-pct";
        }
        else if (_focusedField == "discountRs")
        {
            fallbackId = "pos-discount-rs";
        }
        else if (_focusedField == "payment")
        {
            fallbackId = "pos-payment";
        }
        else if (!string.IsNullOrWhiteSpace(_focusedField)
                 && TableFields.Contains(_focusedField)
                 && _selectedLineIndex >= 0
                 && _selectedLineIndex < CartService.Lines.Count)
        {
            fallbackId = CellId(CartService.Lines[_selectedLineIndex].LineId, _focusedField);
        }

        bool restored = false;
        try
        {
            restored = await Js.InvokeAsync<bool>("webPosRestoreCaret", fallbackId);
        }
        catch
        {
            restored = false;
        }

        if (restored)
        {
            return;
        }

        if (fallbackId == "scanInput")
        {
            await FocusScanAsync();
            return;
        }

        if (fallbackId is "pos-discount-pct")
        {
            await OnDiscountFocusAsync();
            return;
        }

        if (fallbackId is "pos-discount-rs")
        {
            await OnDiscountRsFocusAsync();
            return;
        }

        if (fallbackId is "pos-payment")
        {
            await OnPaymentFocusAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(_focusedField)
            && TableFields.Contains(_focusedField)
            && _selectedLineIndex >= 0)
        {
            await FocusTableCellAsync(_selectedLineIndex, _focusedField);
        }
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private static string FormatSignedRs(long paisa) => (paisa / 100m).ToString("N2");

    private static string FormatChangeOut(long changePaisa) =>
        (-(changePaisa / 100m)).ToString("N2");

    private static string FormatQty(decimal quantity) =>
        quantity == decimal.Truncate(quantity)
            ? quantity.ToString("0", CultureInfo.InvariantCulture)
            : quantity.ToString("0.##", CultureInfo.InvariantCulture);

    [JSInvokable]
    public Task OnTableSlotCount(int count)
    {
        if (_isDisposed)
        {
            return Task.CompletedTask;
        }

        int next = Math.Clamp(count, 12, CartService.MaxLines);
        if (next == _slotCount)
        {
            return Task.CompletedTask;
        }

        _slotCount = next;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _isDisposed = true;
        CapturePosUiState();
        CartService.Changed -= OnCartChanged;
        ShiftStatus.Changed -= OnShiftStatusChanged;
        BarcodeScanner.OnBarcodeScanned -= OnGlobalBarcodeScannedAsync;
        _clockTimer?.Dispose();
        _clockTimer = null;
        _selfRef?.Dispose();
        _selfRef = null;
    }
