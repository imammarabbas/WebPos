            {
                return PaymentBreakdownCalculator.Compute(
                    IsWalkInCustomer,
                    PreviousDuePaisa,
                    PayablePaisa,
                    live.TenderPaisa,
                    ToBreakdownMode(live.Mode),
                    live.ApplyExcessAsCustomerCredit);
            }

            return PaymentBreakdownCalculator.Compute(
                IsWalkInCustomer,
                PreviousDuePaisa,
                PayablePaisa,
                SidebarPaymentReceivedPaisa,
                ToBreakdownMode(_paymentMode),
                applyExcessAsCustomerCredit: false);
        }
