    private static readonly (string Name, string Icon)[] DefaultCategoryChips =
    [
        ("Soft Drinks", "fa-bottle-water"),
        ("Snacks", "fa-cookie"),
        ("Dairy", "fa-cow"),
        ("Grocery", "fa-basket-shopping"),
        ("Promo", "fa-tags")
    ];

    private IEnumerable<(string Name, string Icon)> CategoryChipItems
    {
        get
        {
            if (_quickLinks.Count > 0)
            {
                return _quickLinks
                    .OrderBy(l => l.SortOrder)
                    .ThenBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
                    .Take(5)
                    .Select(l => (l.Name, CategoryIconFor(l.Name)));
            }

            return DefaultCategoryChips;
        }
    }

    private static string CategoryIconFor(string name)
    {
        string n = name ?? string.Empty;
        if (n.Contains("drink", StringComparison.OrdinalIgnoreCase)
            || n.Contains("soda", StringComparison.OrdinalIgnoreCase)
            || n.Contains("beverage", StringComparison.OrdinalIgnoreCase))
        {
            return "fa-bottle-water";
        }

        if (n.Contains("snack", StringComparison.OrdinalIgnoreCase)
            || n.Contains("cookie", StringComparison.OrdinalIgnoreCase))
        {
            return "fa-cookie";
        }

        if (n.Contains("dairy", StringComparison.OrdinalIgnoreCase)
            || n.Contains("milk", StringComparison.OrdinalIgnoreCase))
        {
            return "fa-cow";
        }

        if (n.Contains("promo", StringComparison.OrdinalIgnoreCase)
            || n.Contains("offer", StringComparison.OrdinalIgnoreCase))
        {
            return "fa-tags";
        }

        return "fa-basket-shopping";
    }

