    private SalesProductDto? ResolveProductFromScan(string input)
    {
        string trimmed = input.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            return null;
        }

        // Short code / barcode / SKU exact first (e.g. r200 → Dal Mash 1kg).
        List<SalesProductDto> exactCode = _products
            .Where(product =>
                FieldEquals(product.ShortCode, trimmed)
                || FieldEquals(product.Barcode, trimmed)
                || FieldEquals(product.Sku, trimmed))
            .ToList();
        if (exactCode.Count == 1)
        {
            return exactCode[0];
        }

        if (exactCode.Count > 1)
        {
            return null;
        }

        List<SalesProductDto> exactName = _products
            .Where(product => FieldEquals(product.Name, trimmed))
            .ToList();
        if (exactName.Count == 1)
        {
            return exactName[0];
        }

        List<SalesProductDto> contains = _products
            .Where(product =>
                FieldContains(product.Name, trimmed)
                || FieldContains(product.Barcode, trimmed)
                || FieldContains(product.Sku, trimmed)
                || FieldContains(product.ShortCode, trimmed))
            .ToList();
        return contains.Count == 1 ? contains[0] : null;
    }

    private SaleMasterDto? ResolveMasterFromScan(string input)
    {
        string trimmed = input.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            return null;
        }

        List<SaleMasterDto> exactCode = _masters
            .Where(m =>
                FieldEquals(m.Barcode, trimmed)
                || FieldEquals(m.ShortCode, trimmed)
                || FieldEquals(m.Sku, trimmed))
            .ToList();
        if (exactCode.Count == 1)
        {
            return exactCode[0];
        }

        if (exactCode.Count > 1)
        {
            return null;
        }

        List<SaleMasterDto> exactName = _masters
            .Where(m => FieldEquals(m.Name, trimmed))
            .ToList();
        if (exactName.Count == 1)
        {
            return exactName[0];
        }

        List<SaleMasterDto> contains = _masters
            .Where(m =>
                FieldContains(m.Name, trimmed)
                || FieldContains(m.Barcode, trimmed)
                || FieldContains(m.Sku, trimmed)
                || FieldContains(m.ShortCode, trimmed))
            .ToList();
        return contains.Count == 1 ? contains[0] : null;
    }

    private void AddProductToCart(SalesProductDto product)
    {
        _errorMessage = null;
        _checkoutError = null;
        _successMessage = null;

        ArgumentNullException.ThrowIfNull(product);

        SalesProductDto catalog = _products.FirstOrDefault(p => p.ProductId == product.ProductId)
            ?? product;
        if (catalog.AvailableStock <= 0)
        {
            _errorMessage = $"{catalog.Name} has no sellable stock.";
            return;
        }

        decimal alreadyInCart = CartService.Lines
            .Where(l => l.Product.ProductId == catalog.ProductId)
            .Sum(l => l.Quantity);
        if (alreadyInCart + 1m > catalog.AvailableStock + 0.0001m)
        {
            _errorMessage =
                $"Only {catalog.AvailableStock:0.##} units of {catalog.Name} are available.";
            return;
        }

        bool exists = alreadyInCart > 0;
        if (!exists && CartService.Lines.Count >= CartService.MaxLines)
        {
            _scanText = string.Empty;
            _showScanDropdown = false;
            _scanFocus.OnProductAdded();
            return;
        }

        // Avoid re-entrant StateHasChanged from CartService.Changed during this UI event —
        // that was crashing Blazor WebView with the yellow "unhandled error" bar.
        CartService.Changed -= OnCartChanged;
        try
        {
            CartService.Add(catalog, 1m);
        }
        finally
        {
            CartService.Changed += OnCartChanged;
        }

        CartLine? added = CartService.Lines.FirstOrDefault(l => l.Product.ProductId == catalog.ProductId);
        if (added is not null)
        {
            _lastScannedLineId = added.LineId;
            _pendingFlashLineId = added.LineId;
        }

        SyncLineEditors(catalog.ProductId);
        FocusLastLine(catalog.ProductId);
        // Scanner workflow: stay on barcode so the next scan can fire immediately.
        // Use TAB explicitly to jump to the last scanned row quantity.
        _scanFocus.OnProductAdded();
    }

    private void SyncLineEditors(Guid productId)
    {
        CartLine? line = CartService.Lines.FirstOrDefault(l => l.Product.ProductId == productId);
        if (line is null)
        {
            _qtyText.Remove(productId);
            _priceText.Remove(productId);
            _totalText.Remove(productId);
            return;
        }

        _qtyText[productId] = line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);
        _priceText[productId] = FormatRs(line.EffectiveUnitPricePaisa);
        _totalText[productId] = FormatRs(line.LineTotalPaisa);
    }

    private void FocusLastLine(Guid productId)
    {
        int idx = -1;
        for (int i = 0; i < CartService.Lines.Count; i++)
        {
            if (CartService.Lines[i].Product.ProductId == productId)
            {
                idx = i;
                break;
            }
        }

        _selectedLineIndex = idx;
    }

    private void OnScanInput(ChangeEventArgs e)
    {
        _scanText = e.Value?.ToString() ?? string.Empty;
        _scanHighlight = 0;
        _showScanDropdown = _scanText.Trim().Length > 0;
        _errorMessage = null;
    }

    private void OnScanFocus()
    {
        _focusedField = "search";
        if (_scanText.Trim().Length > 0)
        {
            _showScanDropdown = true;
        }
    }

    private void OnScanBlur()
    {
        if (_focusedField == "search")
        {
            _focusedField = null;
        }
    }

    private async Task OnScanKeyDown(KeyboardEventArgs e)
    {
        if (_isBusy || ModalOpen)
        {
            return;
        }

        if (e.CtrlKey && (e.Key == "k" || e.Key == "K"))
        {
            await FocusSearchAndClearAsync();
            return;
        }

        if (e.Key == "Tab")
        {
            _showScanDropdown = false;
            int target = LastScannedRowIndex;
            if (target < 0 && CartService.Lines.Count > 0)
            {
                target = 0;
            }

            if (target >= 0)
            {
                await RequestQtyFocusAsync(target);
            }

            return;
        }

        if (e.CtrlKey && e.Key == "Enter")
        {
            _showScanDropdown = false;
            await RequestSaveInvoiceAsync(e.Repeat);
            return;
        }

        if (e.Key is "Insert" or "F12")
        {
            _showScanDropdown = false;
            await RequestSaveInvoiceAsync(e.Repeat);
            return;
        }

        if (e.Key == "Escape")
        {
            _showScanDropdown = false;
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (_showScanDropdown && ScanHits.Count > 0)
            {
                _scanHighlight = Math.Min(_scanHighlight + 1, ScanHits.Count - 1);
            }
            else
            {
                MoveSelectedLine(1);
            }

            return;
        }

        if (e.Key == "ArrowUp")
        {
            if (_showScanDropdown && ScanHits.Count > 0)
            {
                _scanHighlight = Math.Max(_scanHighlight - 1, 0);
            }
            else
            {
                MoveSelectedLine(-1);
            }

            return;
        }

        if (e.Key == "Enter")
        {
            await AddFromScanAsync();
            return;
        }
    }

    private async Task ChooseScanHitAsync(object hit)
    {
        _showScanDropdown = false;
        _scanText = string.Empty;

        if (hit is SaleMasterDto master)
        {
            OpenVariant(master);
            await FocusScanAsync();
            return;
        }

        if (hit is SalesProductDto product)
        {
            AddProductToCart(product);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddFromScanAsync(string? overrideCode = null)
    {
        _errorMessage = null;
        bool fromScanner = !string.IsNullOrWhiteSpace(overrideCode);
        string scan = fromScanner ? overrideCode!.Trim() : _scanText.Trim();
        if (string.IsNullOrWhiteSpace(scan))
        {
            _errorMessage = "Enter a name, barcode, SKU, or short code.";
            return;
        }

        if (fromScanner)
        {
            _scanText = string.Empty;
            _showScanDropdown = false;
            _scanHighlight = 0;
        }
        else
        {
            IReadOnlyList<object> hits = ScanHits;
            if (_showScanDropdown && hits.Count > 0)
            {
                int idx = Math.Clamp(_scanHighlight, 0, hits.Count - 1);
                await ChooseScanHitAsync(hits[idx]);
                return;
            }

            // Exact short-code / unique resolve when dropdown closed or empty.
            SaleMasterDto? typedMaster = ResolveMasterFromScan(scan);
            if (typedMaster is not null)
            {
                OpenVariant(typedMaster);
                _scanText = string.Empty;
                _showScanDropdown = false;
                await FocusScanAsync();
                return;
            }

            SalesProductDto? typedProduct = ResolveProductFromScan(scan);
            if (typedProduct is null && hits.Count == 1)
            {
                await ChooseScanHitAsync(hits[0]);
                return;
            }

            if (typedProduct is null && hits.Count > 1)
            {
                _showScanDropdown = true;
                _scanHighlight = 0;
                return;
            }

            if (typedProduct is not null)
            {
                AddProductToCart(typedProduct);
                _scanText = string.Empty;
                _showScanDropdown = false;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        SaleMasterDto? master = ResolveMasterFromScan(scan);
        if (master is not null)
        {
            OpenVariant(master);
            _scanText = string.Empty;
            _showScanDropdown = false;
            await FocusScanAsync();
            return;
        }

        SalesProductDto? product = ResolveProductFromScan(scan);
        if (product is null)
        {
            Result<BarcodeScanOutcome> lookup = await SalesApi.ScanBarcodeAsync(scan);
            if (lookup.Success && lookup.Data is not null)
            {
                if (lookup.Data.IsMaster && lookup.Data.Master is not null)
                {
                    if (!_masters.Any(m => m.ProductId == lookup.Data.Master.ProductId))
                    {
                        _masters.Add(lookup.Data.Master);
                    }

                    OpenVariant(lookup.Data.Master);
                    _scanText = string.Empty;
                    _showScanDropdown = false;
                    await FocusScanAsync();
                    return;
                }

                if (lookup.Data.Product is not null)
                {
                    UpsertProductInCache(lookup.Data.Product);
                    product = lookup.Data.Product;
                }
            }
            else
            {
                Logger.LogWarning("Barcode lookup failed for '{Barcode}': {Error}", scan, lookup.ErrorMessage);
            }
        }

        if (product is null)
        {
            _errorMessage = $"Product not found for '{scan}'.";
            _scanText = string.Empty;
            _showScanDropdown = false;
            PlayNotFoundBeep();
            _scanFocus.OnProductNotFound();
            await InvokeAsync(StateHasChanged);
            return;
        }

        AddProductToCart(product);
        _scanText = string.Empty;
        _showScanDropdown = false;
        await InvokeAsync(StateHasChanged);
        if (fromScanner)
        {
            await FocusScanAsync();
        }
    }

    private Task OnGlobalBarcodeScannedAsync(string code)
    {
        // Do not drop on _isBusy — the service queue serializes scans; checkout busy must not skip cart adds.
        if (_isDisposed || ModalOpen)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            // Clear typeahead before resolve so UI never shows a truncated wedge string.
            _scanText = string.Empty;
            _showScanDropdown = false;
            _scanHighlight = 0;
            await AddFromScanAsync(code);
        });
    }

    private async Task FocusScanAsync()
    {
        bool wasClosed = !_searchOpen;
        _searchOpen = true;
        if (wasClosed)
        {
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", "scanInput");
            return;
        }
        catch
        {
            /* fall through to ElementReference */
        }

        try { await _scanInput.FocusAsync(); } catch { /* ignore */ }
    }

    private async Task OnCellKeyDown(KeyboardEventArgs e, int row, string field)
    {
        if (_isBusy || ModalOpen)
        {
            return;
        }

        if (e.Repeat && e.Key is "F12" or "Insert")
        {
            return;
        }

        if (e.CtrlKey && e.Key == "Enter")
        {
            await RequestSaveInvoiceAsync(e.Repeat);
            return;
        }

        if (e.Key is "Insert" or "F12")
        {
            await RequestSaveInvoiceAsync(e.Repeat);
            return;
        }

        if (e.Key == "Delete" && !e.ShiftKey && !e.CtrlKey && !e.AltKey)
        {
            await DeleteLineAtAsync(row, field);
            return;
        }

        CartLine? line = row >= 0 && row < CartService.Lines.Count ? CartService.Lines[row] : null;
        if (line is not null && field == "total" && e.Key is "Enter" or "Tab" or "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight")
        {
            CommitTotal(line);
        }

        if (line is not null && IsDeleteCommand(GetCellRaw(line, field)))
        {
            if (e.Key is "Enter" or "Tab")
            {
                await DeleteLineAtAsync(row, field);
                return;
            }
        }

        if (e.Key == "Enter")
        {
            int next = e.ShiftKey ? row - 1 : row + 1;
            if (next >= 0 && next < CartService.Lines.Count)
            {
                await FocusTableCellAsync(next, field);
            }
            else if (!e.ShiftKey)
            {
                await RequestScanFocusAsync();
            }

            return;
        }

        if (e.Key == "ArrowUp")
        {
            if (row > 0)
            {
                await FocusTableCellAsync(row - 1, field);
            }

            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (row + 1 < CartService.Lines.Count)
            {
                await FocusTableCellAsync(row + 1, field);
            }

            return;
        }

        if (e.Key == "Tab")
        {
            (int nextRow, string nextField) = e.ShiftKey
                ? PreviousTableCell(row, field)
                : NextTableCell(row, field);
            await FocusTableCellAsync(nextRow, nextField);
            return;
        }

        if (e.Key == "ArrowLeft")
        {
            (int nextRow, string nextField) = PreviousTableCell(row, field);
            await FocusTableCellAsync(nextRow, nextField);
            return;
        }

        if (e.Key == "ArrowRight")
        {
            (int nextRow, string nextField) = NextTableCell(row, field);
            await FocusTableCellAsync(nextRow, nextField);
        }
    }

    private static (int row, string field) NextTableCell(int row, string field)
    {
        int i = Array.IndexOf(TableFields, field);
        if (i < 0)
        {
            i = 0;
        }

        if (i < TableFields.Length - 1)
        {
            return (row, TableFields[i + 1]);
        }

        return (row + 1, TableFields[0]);
    }

    private static (int row, string field) PreviousTableCell(int row, string field)
    {
        int i = Array.IndexOf(TableFields, field);
        if (i < 0)
        {
            i = 0;
        }

        if (i > 0)
        {
            return (row, TableFields[i - 1]);
        }

        return (row - 1, TableFields[^1]);
    }

    private static string CellId(Guid lineId, string field) => $"pos-{field}-{lineId:N}";

    private int LastScannedRowIndex
    {
        get
        {
            if (_lastScannedLineId is Guid id)
            {
                for (int i = 0; i < CartService.Lines.Count; i++)
                {
                    if (CartService.Lines[i].LineId == id)
                    {
                        return i;
                    }
                }
            }

            return CartService.Lines.Count > 0 ? 0 : -1;
        }
    }

    private async Task OnCellFocusAsync(int row, string field)
    {
        OnLineFieldFocus(row, field);
        if (row < 0 || row >= CartService.Lines.Count)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("webPosSelectById", CellId(CartService.Lines[row].LineId, field));
        }
        catch
        {
            /* ignore */
        }
    }

    private void SelectLine(int index)
    {
        if (index < 0 || index >= CartService.Lines.Count)
        {
            return;
        }

        _selectedLineIndex = index;
    }

    private void MoveSelectedLine(int delta)
    {
        int count = CartService.Lines.Count;
        if (count == 0)
        {
            return;
        }

        if (delta > 0)
        {
            _selectedLineIndex = Math.Min(count - 1, Math.Max(0, _selectedLineIndex) + 1);
        }
        else
        {
            _selectedLineIndex = Math.Max(0, (_selectedLineIndex < 0 ? count : _selectedLineIndex) - 1);
        }
    }

    private void DeleteSelectedLine()
    {
        string field = !string.IsNullOrEmpty(_focusedField) && TableFields.Contains(_focusedField)
            ? _focusedField
            : "qty";
        _ = DeleteLineAtAsync(_selectedLineIndex, field);
    }

    private async Task DeleteLineAtAsync(int index, string field)
    {
        if (index < 0 || index >= CartService.Lines.Count)
        {
            return;
        }

        CartLine line = CartService.Lines[index];
        Guid deletedId = line.LineId;
        Guid? lastId = _lastScannedLineId;
        RemoveLine(line, restoreScan: false);

        if (lastId == deletedId)
        {
            _lastScannedLineId = CartService.Lines.Count == 0
                ? null
                : CartService.Lines[Math.Min(index, CartService.Lines.Count - 1)].LineId;
        }

        if (CartService.Lines.Count == 0)
        {
            await RequestScanFocusAsync();
            return;
        }

        int target = Math.Min(index, CartService.Lines.Count - 1);
        string restoreField = TableFields.Contains(field) ? field : "qty";
        await FocusTableCellAsync(target, restoreField);
    }

    private void OnLineFieldFocus(int row, string field)
    {
        SelectLine(row);
        _focusedField = field;
    }

    private bool IsEditableFieldFocused =>
        _focusedField is "search" or "itemCode" or "description" or "packing" or "qty" or "price" or "total" or "discount" or "payment";

    private bool IsLineEditorFocused =>
        _focusedField is "itemCode" or "description" or "packing" or "qty" or "price" or "total" or "discount" or "payment";

    private string GetCodeText(CartLine line) =>
        _codeText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : ItemCode(line.Product);

    private string GetDescText(CartLine line) =>
        line.DescriptionOverride ?? (line.Product.Name ?? string.Empty);

    private string GetPackText(CartLine line) =>
        line.PackingOverride
        ?? (string.IsNullOrWhiteSpace(line.Product.PackingSize) ? "—" : line.Product.PackingSize);

    private void OnCodeInput(CartLine line, ChangeEventArgs e) =>
        _codeText[line.Product.ProductId] = e.Value?.ToString() ?? string.Empty;

    private void OnDescInput(CartLine line, ChangeEventArgs e) =>
        line.DescriptionOverride = e.Value?.ToString() ?? string.Empty;

    private void OnPackInput(CartLine line, ChangeEventArgs e) =>
        line.PackingOverride = e.Value?.ToString() ?? string.Empty;

    private void OnCodeCommit(CartLine line)
    {
        if (!_codeText.TryGetValue(line.Product.ProductId, out string? raw))
        {
            return;
        }

        if (IsDeleteCommand(raw))
        {
            int index = IndexOfLine(line);
            _ = DeleteLineAtAsync(index, "itemCode");
            return;
        }

        string code = raw.Trim();
        if (string.IsNullOrEmpty(code) || string.Equals(code, ItemCode(line.Product), StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        SalesProductDto? product = ResolveProductFromScan(code);
        if (product is null)
        {
            _codeText[line.Product.ProductId] = ItemCode(line.Product);
            return;
        }

        _codeText.Remove(line.Product.ProductId);
        CartService.Remove(line.Product.ProductId);
        AddProductToCart(product);
    }

    private int IndexOfLine(CartLine line)
    {
        for (int i = 0; i < CartService.Lines.Count; i++)
        {
            if (CartService.Lines[i].LineId == line.LineId)
            {
                return i;
            }
        }

        return -1;
    }

    private static bool IsDeleteCommand(string? raw)
    {
        string value = (raw ?? string.Empty).Trim();
        return value.Equals("delete", StringComparison.OrdinalIgnoreCase)
            || value.Equals("del", StringComparison.OrdinalIgnoreCase);
    }

    private string GetCellRaw(CartLine line, string field) =>
        field switch
        {
            "itemCode" => GetCodeText(line),
            "description" => GetDescText(line),
            "packing" => GetPackText(line),
            "qty" => GetQtyText(line),
            "price" => GetPriceText(line),
            "total" => GetTotalText(line),
            _ => string.Empty
        };

    private string GetTotalText(CartLine line) =>
        _totalText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : FormatRs(line.LineTotalPaisa);

    private void OnTotalInput(CartLine line, ChangeEventArgs e) =>
        _totalText[line.Product.ProductId] = e.Value?.ToString() ?? string.Empty;

    private void CommitTotal(CartLine line)
    {
        if (!_totalText.TryGetValue(line.Product.ProductId, out string? raw))
        {
            return;
        }

        if (IsDeleteCommand(raw))
        {
            _ = DeleteLineAtAsync(IndexOfLine(line), "total");
            return;
        }

        if (!TryParseRs(raw, out long totalPaisa) || line.Quantity <= 0)
        {
            if (!string.IsNullOrWhiteSpace(raw) && !IsDeleteCommand(raw))
            {
                _errorMessage = "Line total must be a valid non-negative amount.";
            }

            SyncLineEditors(line.Product.ProductId);
            return;
        }

        if (!CartService.SetLineTotal(line.Product.ProductId, totalPaisa))
        {
            _errorMessage = "Line total must be a valid non-negative amount.";
            SyncLineEditors(line.Product.ProductId);
            return;
        }

        _errorMessage = null;
        SyncLineEditors(line.Product.ProductId);
    }

    private async Task FocusSearchAndClearAsync()
    {
        _scanText = string.Empty;
        _showScanDropdown = false;
        _searchOpen = true;
        _focusedField = "search";
        _scanFocus.RequestScan();
        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", "scanInput");
        }
        catch
        {
            /* ignore */
        }
    }

    private void UpsertProductInCache(SalesProductDto product)
    {
        int index = _products.FindIndex(p => p.ProductId == product.ProductId);
        if (index >= 0)
        {
            _products[index] = product;
            return;
        }

        _products.Add(product);
    }

    private static void PlayNotFoundBeep()
    {
        try { Console.Beep(880, 160); }
        catch (Exception) { /* ignore */ }
    }

    private string GetQtyText(CartLine line) =>
        _qtyText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);

    private string GetPriceText(CartLine line) =>
        _priceText.TryGetValue(line.Product.ProductId, out string? text)
            ? text
            : FormatRs(line.EffectiveUnitPricePaisa);

    private void OnQtyChanged(CartLine line, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        _qtyText[line.Product.ProductId] = raw;
        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal quantity)
            && !decimal.TryParse(raw, NumberStyles.Number, CultureInfo.CurrentCulture, out quantity))
        {
            return;
        }

        if (quantity <= 0)
        {
            return;
        }

        if (quantity > line.Product.AvailableStock)
        {
            _errorMessage =
                $"Only {line.Product.AvailableStock:0.##} units of {line.Product.Name} are available.";
            return;
        }

        _errorMessage = null;
        CartService.SetQuantity(line.Product.ProductId, quantity);
        SyncLineEditors(line.Product.ProductId);
    }

    private void OnPriceChanged(CartLine line, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        _priceText[line.Product.ProductId] = raw;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        if (!TryParseRs(raw, out long paisa))
        {
            _errorMessage = "Price must be a valid non-negative amount.";
            return;
        }

        if (!CartService.SetUnitPrice(line.Product.ProductId, paisa))
        {
            _errorMessage = "Price must be a valid non-negative amount.";
            return;
        }

        _errorMessage = null;
        CartLine? updated = CartService.Lines.FirstOrDefault(l => l.Product.ProductId == line.Product.ProductId);
        if (updated is not null)
        {
            _totalText[line.Product.ProductId] = FormatRs(updated.LineTotalPaisa);
        }
    }

    private void OnPriceBlur(CartLine line)
    {
        if (IsDeleteCommand(GetPriceText(line)))
        {
            _ = DeleteLineAtAsync(IndexOfLine(line), "price");
            return;
        }

        string raw = GetPriceText(line);
        if (!string.IsNullOrWhiteSpace(raw) && !TryParseRs(raw, out _))
        {
            _errorMessage = "Price must be a valid non-negative amount.";
        }

        SyncLineEditors(line.Product.ProductId);
    }

    private void RemoveLine(CartLine line, bool restoreScan = true)
    {
        _qtyText.Remove(line.Product.ProductId);
        _priceText.Remove(line.Product.ProductId);
        _totalText.Remove(line.Product.ProductId);
        _codeText.Remove(line.Product.ProductId);
        CartService.Remove(line.Product.ProductId);
        _selectedLineIndex = Math.Min(_selectedLineIndex, CartService.Lines.Count - 1);
        if (restoreScan)
        {
            _scanFocus.OnRowRemoved();
        }
    }

    private void ClearCart()
    {
        _errorMessage = null;
        _checkoutError = null;
        _qtyText.Clear();
        _priceText.Clear();
        _totalText.Clear();
        _codeText.Clear();
        CartService.Clear();
        _cashGivenText = string.Empty;
        _discountRsText = string.Empty;
        _discountPctText = string.Empty;
        _selectedLineIndex = -1;
        _lastScannedLineId = null;
        try { _ = Js.InvokeVoidAsync("webPosResetTableScroll"); }
        catch { /* ignore */ }
    }

