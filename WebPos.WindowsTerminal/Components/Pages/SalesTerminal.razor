    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (_showPhonePrompt)
            {
                ClosePhonePrompt();
                return;
            }

            if (_showPaymentModal)
            {
                ClosePaymentModal();
                return;
            }

            if (_showCalculator)
            {
                _showCalculator = false;
                return;
            }

            if (_showCustomerAdd)
            {
                _showCustomerAdd = false;
                return;
            }

            if (_showCustomerSearch)
            {
                _showCustomerSearch = false;
                return;
            }

            if (_variantMaster is not null)
            {
                CloseVariant();
                return;
            }

            if (!string.IsNullOrWhiteSpace(_categoryPickName))
            {
                CloseCategoryPick();
                return;
            }

            if (_showItemSearch)
            {
                CloseItemSearch();
                return;
            }

            if (_showPriceChecker)
            {
                _showPriceChecker = false;
                return;
            }

            if (_showCreatePurchaseOrder)
            {
                CloseCreatePurchaseOrder();
                return;
            }

            if (_showPurchaseOrders)
            {
                ClosePurchaseOrders();
                return;
            }
        }

        if (e.AltKey && e.ShiftKey && (e.Key == "b" || e.Key == "B"))
        {
            if (!_isBusy && !_showPaymentModal && !CartService.IsEmpty)
            {
                await OpenPaymentModalAsync();
            }

            return;
        }

        if (e.AltKey && e.ShiftKey && (e.Key == "p" || e.Key == "P"))
        {
            if (!_isBusy && !_showPaymentModal)
            {
                await OnDiscountFocusAsync();
            }

            return;
        }

        if (e.AltKey && e.ShiftKey && (e.Key == "c" || e.Key == "C"))
        {
            if (!_isBusy && !_showPaymentModal)
            {
                await OnDiscountRsFocusAsync();
            }

            return;
        }

        if (e.AltKey && (e.Key == "c" || e.Key == "C"))
        {
            if (!_isBusy && !_showPaymentModal)
            {
                await OnPaymentFocusAsync();
            }

            return;
        }

        if (ModalOpen || _isBusy)
        {
            return;
        }

        if (e.CtrlKey && (e.Key == "k" || e.Key == "K"))
        {
            await FocusSearchAndClearAsync();
            return;
        }

        if (e.Key is "ArrowUp" or "ArrowDown")
        {
            if (_showScanDropdown)
            {
                return;
            }

            MoveSelectedLine(e.Key == "ArrowDown" ? 1 : -1);
            return;
        }

        if (e.Key == "Enter" && !IsEditableFieldFocused)
        {
            await RequestScanFocusAsync();
            return;
        }

        if (e.Key == "Delete" && !IsEditableFieldFocused)
        {
            DeleteSelectedLine();
            return;
        }

        if (e.Key == "Backspace" && !IsEditableFieldFocused)
        {
            DeleteSelectedLine();
            return;
        }

        if (!ModalOpen && !IsEditableFieldFocused && IsSearchableKey(e))
        {
            _searchOpen = true;
            _scanText += e.Key;
            _scanHighlight = 0;
            _showScanDropdown = _scanText.Trim().Length > 0;
            _focusedField = "search";
            _scanFocus.RequestScan();
            try
            {
                await Js.InvokeVoidAsync("webPosFocusById", "scanInput");
            }
            catch
            {
                /* ignore */
            }

            OnScanInput(new ChangeEventArgs { Value = _scanText });
            return;
        }

        if (e.CtrlKey && e.Key == "Enter")
        {
            await RequestSaveInvoiceAsync(e.Repeat);
            return;
        }

        if (e.CtrlKey && (e.Key == "h" || e.Key == "H"))
        {
            HoldCart();
            return;
        }

        if (e.CtrlKey && (e.Key == "r" || e.Key == "R"))
        {
            ResumeHeldCart();
            return;
        }

        switch (e.Key)
        {
            case "F1":
                OpenCalculator();
                break;
            case "F2":
                OpenItemSearch();
                break;
            case "F3":
                OpenAddCustomer();
                break;
            case "F4":
                await OpenSearchCustomerAsync();
                break;
            case "F5":
                GoSaleReturn();
                break;
            case "F6":
                await DuplicateLastInvoiceAsync();
                break;
            case "F7":
                TogglePrintInvoice();
                break;
            case "F8":
                NewSale();
                break;
            case "F9":
                GoInvoiceList();
                break;
            case "F12":
            case "Insert":
                await RequestSaveInvoiceAsync(e.Repeat);
                break;
        }
    }

