@page "/sales"
@using System.Globalization
@using Common.Models
@using WebPos.WindowsTerminal
@using WebPos.WindowsTerminal.Services
@implements IDisposable
@inject SalesApiClient SalesApi
@inject CartService CartService
@inject CustomerApiClient CustomerApi
@inject WhatsAppReceiptService WhatsAppReceiptService
@inject ISessionService SessionService
@inject InvoiceApiClient InvoiceApi
@inject PurchaseIntakeApiClient PurchaseIntake
@inject ShiftStatusApiClient ShiftStatus
@inject LastSaleReceiptStore LastSaleReceiptStore
@inject CartHoldService CartHoldService
@inject NavigationManager Navigation

<PageTitle>Copenhagen Mart POS</PageTitle>

<div class="pos-shell" @onkeydown="OnKeyDown">
    <header class="pos-header">
        <div class="pos-title-block">
            <span class="pos-version">TERMINAL POS v2.0</span>
            <h1 class="pos-store">@TerminalBranding.StoreName</h1>
        </div>

        <div class="scan-bar">
            <input id="scanInput"
                   class="scan-input"
                   type="search"
                   placeholder="Scan barcode or type short code — try 1001"
                   autocomplete="off"
                   @ref="_scanInput"
                   @bind="_scanText"
                   @bind:event="oninput"
                   disabled="@_isBusy" />
            <button type="button" class="add-btn" disabled="@_isBusy" @onclick="AddFromScanAsync">
                ADD
            </button>
            <button type="button"
                    class="secondary-btn receive-goods-btn"
                    disabled="@_isBusy"
                    title="F9"
                    @onclick="OpenReceiveGoods">
                F9 · Receive
            </button>
        </div>

        <div class="pos-meta">
            <div class="header-badges">
                @if (SessionService.IsActive)
                {
                    <span class="header-badge shift-open">Shift OPEN</span>
                }
                <span class="header-badge cash-drawer">
                    Cash Rs @FormatRs(ShiftStatus.ExpectedCashPaisa)
                </span>
            </div>
            <span class="lane-badge">LANE 01</span>
            <span class="clock">@_now.ToString("HH:mm:ss")</span>
            <span class="clock-date">@_now.ToString("dd MMM")</span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert-red" role="alert" aria-live="assertive">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="success-toast" role="status" aria-live="polite">@_successMessage</div>
    }

    <div class="pos-layout">
        <section class="products-panel">
            <div class="panel-head">
                <h2>Products</h2>
                <span class="item-count">@VisibleProducts.Count() items</span>
            </div>

            <input class="grid-search"
                   type="search"
                   placeholder="Search products…"
                   @bind="_gridSearch"
                   @bind:event="oninput"
                   disabled="@_isBusy" />

            <div class="category-pills" role="tablist" aria-label="Categories">
                @foreach (string category in CategoryFilters)
                {
                    <button type="button"
                            class="pill @(string.Equals(_categoryFilter, category, StringComparison.Ordinal) ? "active" : string.Empty)"
                            @onclick="() => SelectCategory(category)">
                        @category
                    </button>
                }
            </div>

            @if (_isLoadingProducts)
            {
                <p class="loading-text">Loading products…</p>
            }
            else if (!VisibleProducts.Any())
            {
                <p class="loading-text">No products match this filter.</p>
            }
            else
            {
                <div class="product-grid">
                    @foreach (SalesProductDto product in VisibleProducts)
                    {
                        <div class="product-card @(product.IsLoose ? "loose" : string.Empty)">
                            <span class="stock-badge @(product.AvailableStock <= 5m ? "low" : string.Empty)">
                                @(product.AvailableStock <= 5m
                                    ? $"Low · {product.AvailableStock:0.##}"
                                    : $"{product.AvailableStock:0.##} in stock")
                            </span>
                            <span class="code-badge">@product.ShortCode</span>
                            <span class="product-name">@product.Name</span>
                            <span class="product-category">@DisplayCategory(product)</span>
                            <div class="product-footer">
                                <span class="product-price">Rs @FormatRs(product.UnitPricePaisa)</span>
                                <button type="button"
                                        class="add-circle"
                                        disabled="@_isBusy"
                                        aria-label="@($"Add {product.Name}")"
                                        @onclick="() => AddProductToCart(product)">
                                    +
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <aside class="cart-panel">
            <div class="cart-header">
                <h2>Cart <span class="cart-count">@CartService.Lines.Count</span></h2>
                <button type="button"
                        class="link-btn"
                        disabled="@(CartService.IsEmpty || _isBusy)"
                        @onclick="ClearCart">
                    Clear
                </button>
            </div>

            <div class="customer-toggle">
                <button type="button"
                        class="customer-pill @(_useWalkInCustomer ? "active" : string.Empty)"
                        @onclick="SelectWalkInCustomer">
                    Walk-in
                </button>
                <button type="button"
                        class="customer-pill @(!_useWalkInCustomer ? "active" : string.Empty)"
                        @onclick="SelectRegisteredCustomerMode">
                    Registered
                </button>
            </div>

            @if (!_useWalkInCustomer)
            {
                <div class="customer-lookup">
                    @if (_selectedCustomer is not null)
                    {
                        <div class="customer-chip">
                            <div>
                                <strong>@_selectedCustomer.Name</strong>
                                <span>@_selectedCustomer.PhoneNumber</span>
                                <span class="customer-balance">Balance Rs @FormatRs(_selectedCustomer.CurrentBalancePaisa)</span>
                            </div>
                            <button type="button" class="link-btn" @onclick="ClearSelectedCustomer">Clear</button>
                        </div>
                    }
                    else
                    {
                        <input class="customer-search"
                               type="search"
                               placeholder="Search by name or phone…"
                               autocomplete="off"
                               @ref="_customerSearchInput"
                               @bind="_customerSearch"
                               @bind:event="oninput"
                               @onkeydown="OnCustomerSearchKeyDown"
                               disabled="@_isBusy" />

                        @if (_isLoadingCustomers)
                        {
                            <p class="loading-text small">Loading customers…</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(_customerLoadError))
                        {
                            <p class="field-error">@_customerLoadError</p>
                        }
                        else
                        {
                            <ul class="typeahead customer-dropdown">
                                @foreach (PartyDto customer in FilteredCustomers.Take(12))
                                {
                                    <li>
                                        <button type="button" @onclick="() => BindCustomer(customer)">
                                            <strong>@customer.Name</strong>
                                            <span>@customer.PhoneNumber · Bal Rs @FormatRs(customer.CurrentBalancePaisa)</span>
                                        </button>
                                    </li>
                                }
                                @if (!FilteredCustomers.Any())
                                {
                                    <li class="typeahead-empty">No match</li>
                                }
                            </ul>
                        }
                    }
                </div>
            }

            @if (CartService.IsEmpty)
            {
                <div class="empty-cart">Scan or tap a product to start.</div>
            }
            else
            {
                <ul class="cart-lines">
                    @foreach (CartLine line in CartService.Lines)
                    {
                        <li class="cart-line">
                            <div class="line-info">
                                <strong>@line.Product.Name</strong>
                                <span>Rs @FormatRs(line.Product.UnitPricePaisa) × @FormatQty(line)</span>
                            </div>
                            <div class="line-actions">
                                @if (line.Product.IsLoose)
                                {
                                    <input type="number"
                                           class="qty-input loose"
                                           inputmode="decimal"
                                           step="0.01"
                                           min="0.01"
                                           max="@line.Product.AvailableStock.ToString(CultureInfo.InvariantCulture)"
                                           aria-label="@($"Quantity for {line.Product.Name}")"
                                           value="@GetLooseQtyText(line)"
                                           @onchange="e => OnLooseQtyChanged(line, e)" />
                                }
                                else
                                {
                                    <button type="button" class="qty-btn" @onclick="() => ChangeQty(line, -1m)">−</button>
                                    <span class="line-qty">@line.Quantity.ToString("0")</span>
                                    <button type="button" class="qty-btn" @onclick="() => ChangeQty(line, 1m)">+</button>
                                }
                                <span class="line-total">Rs @FormatRs(line.LineTotalPaisa)</span>
                                <button type="button" class="remove-btn" @onclick="() => RemoveLine(line)">×</button>
                            </div>
                        </li>
                    }
                </ul>
            }

            <div class="payment-section">
                <div class="payment-methods">
                    <button type="button"
                            class="payment-btn @(_paymentMode == PaymentUiMode.Cash ? "active" : string.Empty)"
                            @onclick="SelectCashMode">
                        Cash
                    </button>
                    <button type="button"
                            class="payment-btn @(_paymentMode == PaymentUiMode.Online ? "active" : string.Empty)"
                            @onclick="SelectOnlineMode">
                        Online
                    </button>
                    @if (_selectedCustomer is not null)
                    {
                        <button type="button"
                                class="payment-btn @(_paymentMode == PaymentUiMode.Credit ? "active" : string.Empty)"
                                @onclick="SelectCreditMode">
                            Credit
                        </button>
                    }
                </div>

                @if (_paymentMode == PaymentUiMode.Cash)
                {
                    <label class="field-label" for="cashGiven">Cash given (Rs)</label>
                    <input id="cashGiven"
                           class="cash-given-input"
                           type="number"
                           inputmode="decimal"
                           min="0"
                           step="0.01"
                           @bind="_cashGivenText"
                           @bind:event="oninput"
                           disabled="@_isBusy" />
                    <div class="change-box">
                        Change: <strong>Rs @FormatRs(ChangePaisa)</strong>
                    </div>
                }
                else if (_paymentMode == PaymentUiMode.Online)
                {
                    <div class="online-channels">
                        @foreach (CheckoutPaymentOption channel in CheckoutPaymentMethods.OnlineChannels)
                        {
                            <button type="button"
                                    class="channel-pill @(string.Equals(_onlineChannel, channel.Method, StringComparison.Ordinal) ? "active" : string.Empty)"
                                    @onclick="() => _onlineChannel = channel.Method">
                                @channel.Label
                            </button>
                        }
                    </div>
                    <label class="field-label" for="txnRef">Txn ref</label>
                    <input id="txnRef"
                           class="txn-ref-input"
                           type="text"
                           placeholder="Transaction / reference ID"
                           @bind="_onlineTxnRef"
                           @bind:event="oninput"
                           disabled="@_isBusy" />
                }
                else if (_paymentMode == PaymentUiMode.Credit && _selectedCustomer is not null)
                {
                    <button type="button"
                            class="pay-btn"
                            disabled="@(CartService.IsEmpty || _isBusy || !CanPay)"
                            @onclick="PayNowAsync">
                        @if (_isBusy)
                        {
                            <span>Processing…</span>
                        }
                        else
                        {
                            <span>Charge account · Bal Rs @FormatRs(_selectedCustomer.CurrentBalancePaisa)</span>
                        }
                    </button>
                }
            </div>

            <div class="totals">
                <div class="total-row">
                    <span>Subtotal</span>
                    <span>Rs @FormatRs(CartService.SubtotalPaisa)</span>
                </div>
                @if (DiscountAmountPaisa > 0)
                {
                    <div class="total-row">
                        <span>Discount</span>
                        <span>− Rs @FormatRs(DiscountAmountPaisa)</span>
                    </div>
                }
                <div class="total-row grand">
                    <span>Total</span>
                    <span>Rs @FormatRs(PayablePaisa)</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_checkoutError))
            {
                <p class="field-error" role="alert">@_checkoutError</p>
            }

            @if (_paymentMode != PaymentUiMode.Credit)
            {
                <button type="button"
                        class="pay-btn"
                        disabled="@(CartService.IsEmpty || _isBusy || !CanPay)"
                        @onclick="PayNowAsync">
                    @if (_isBusy)
                    {
                        <span>Processing…</span>
                    }
                    else
                    {
                        <span>Pay Now · Rs @FormatRs(PayablePaisa)</span>
                    }
                </button>
            }

            @if (LastSaleReceiptStore.Current is not null)
            {
                <button type="button"
                        class="whatsapp-btn"
                        disabled="@_isBusy"
                        @onclick="WhatsAppOrPrintAsync">
                    WhatsApp / Print
                </button>
            }

            <div class="utility-row">
                <a class="utility-btn" href="returns">Return</a>
                <button type="button"
                        class="utility-btn"
                        disabled="@(CartService.IsEmpty || _isBusy)"
                        @onclick="HoldCart">
                    Hold
                </button>
                @if (CartHoldService.HasHeldCart)
                {
                    <button type="button"
                            class="utility-btn"
                            disabled="@_isBusy"
                            @onclick="ResumeHeldCart">
                        Resume
                    </button>
                }
                <button type="button"
                        class="utility-btn @(_showDiscountInput ? "active" : string.Empty)"
                        disabled="@_isBusy"
                        @onclick="ToggleDiscount">
                    Discount
                </button>
            </div>

            @if (_showDiscountInput)
            {
                <label class="field-label" for="discountRs">Discount (Rs)</label>
                <input id="discountRs"
                       class="discount-input"
                       type="number"
                       inputmode="decimal"
                       min="0"
                       step="0.01"
                       placeholder="0.00"
                       @bind="_discountRsText"
                       @bind:event="oninput"
                       disabled="@_isBusy" />
            }

            <a class="close-shift-link" href="close-shift">Close shift</a>
        </aside>
    </div>

    <section class="recent-bills-strip" aria-label="Recent bills">
        <div class="recent-bills-head">
            <h2>Recent bills</h2>
            <a class="view-all-link" href="recent-bills">View all →</a>
        </div>

        @if (_isLoadingRecentBills)
        {
            <p class="loading-text small">Loading recent bills…</p>
        }
        else if (_recentBills.Count == 0)
        {
            <p class="loading-text small">No bills yet this shift.</p>
        }
        else
        {
            <div class="bill-mini-grid">
                @foreach (SalesInvoiceSummaryDto bill in _recentBills)
                {
                    <article class="bill-mini-card">
                        <div class="bill-mini-top">
                            <strong>#@ShortId(bill.InvoiceNo)</strong>
                            <span>@bill.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="bill-mini-total">Rs @FormatRs(bill.TotalAmountPaisa)</div>
                        <div class="bill-mini-meta">
                            @bill.ItemCount items · @bill.PaymentMethod
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@if (_showPhonePrompt)
{
    <div class="modal-backdrop" @onclick="ClosePhonePrompt">
        <div class="success-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>WhatsApp phone</h2>
            <p class="success-invoice">Enter a number for the walk-in receipt.</p>
            <label class="field-label" for="waPhone">WhatsApp phone</label>
            <input id="waPhone"
                   class="txn-ref-input"
                   type="tel"
                   placeholder="03xxxxxxxxx"
                   @bind="_whatsAppPhone"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(_whatsAppError))
            {
                <p class="field-error">@_whatsAppError</p>
            }

            <div class="checkout-actions">
                <button type="button" class="secondary-btn" @onclick="ClosePhonePrompt">Cancel</button>
                <button type="button" class="pay-btn" @onclick="ConfirmWhatsAppPhoneAsync">
                    Send
                </button>
            </div>
        </div>
    </div>
}

<ReceiveGoodsModal Visible="_showReceiveGoods"
                   IntakeService="PurchaseIntake"
                   Products="_receiveProducts"
                   ReceiverId="SessionService.CashierId"
                   OnClose="CloseReceiveGoods"
                   OnReceived="OnGoodsReceivedAsync" />

@code {
    private enum PaymentUiMode
    {
        Cash,
        Online,
        Credit
    }

    private static readonly string[] CategoryFilters = ["All", "Dairy", "Grocery", "Bakery", "Loose only"];

    private ElementReference _scanInput;
    private ElementReference _customerSearchInput;
    private IReadOnlyList<SalesProductDto> _products = [];
    private IReadOnlyList<SalesProductDto> _receiveProducts = [];
    private IReadOnlyList<PartyDto> _customers = [];
    private IReadOnlyList<SalesInvoiceSummaryDto> _recentBills = [];
    private readonly Dictionary<Guid, string> _looseQtyText = [];

    private string _scanText = string.Empty;
    private string _gridSearch = string.Empty;
    private string _categoryFilter = "All";
    private string? _errorMessage;
    private string? _successMessage;
    private string? _checkoutError;
    private string? _customerLoadError;
    private string? _whatsAppError;
    private bool _isLoadingProducts;
    private bool _isLoadingCustomers;
    private bool _isLoadingRecentBills;
    private bool _isBusy;
    private bool _useWalkInCustomer = true;
    private bool _showDiscountInput;
    private bool _showPhonePrompt;
    private bool _showReceiveGoods;
    private string _customerSearch = string.Empty;
    private string _cashGivenText = string.Empty;
    private string _discountRsText = string.Empty;
    private string _onlineChannel = CheckoutPaymentMethods.EasyPaisa;
    private string _onlineTxnRef = string.Empty;
    private string _whatsAppPhone = string.Empty;
    private PartyDto? _selectedCustomer;
    private PaymentUiMode _paymentMode = PaymentUiMode.Cash;
    private DateTime _now = DateTime.Now;
    private Timer? _clockTimer;

    private IEnumerable<SalesProductDto> VisibleProducts =>
        GroupProductsForDisplay(ApplyFilters(_products, _gridSearch, _categoryFilter));

    private IEnumerable<PartyDto> FilteredCustomers =>
        CustomerApiClient.FilterCustomers(_customers, _customerSearch);

    private long DiscountAmountPaisa
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_discountRsText))
            {
                return 0;
            }

            return TryParseRs(_discountRsText, out long paisa) ? paisa : 0;
        }
    }

    private long PayablePaisa =>
        Math.Max(0, CartService.SubtotalPaisa - DiscountAmountPaisa);

    private long ChangePaisa
    {
        get
        {
            if (!TryParseRs(_cashGivenText, out long givenPaisa))
            {
                return 0;
            }

            long change = givenPaisa - PayablePaisa;
            return change > 0 ? change : 0;
        }
    }

    private bool CanPay
    {
        get
        {
            if (CartService.IsEmpty)
            {
                return false;
            }

            if (DiscountAmountPaisa > CartService.SubtotalPaisa)
            {
                return false;
            }

            if (_paymentMode == PaymentUiMode.Credit)
            {
                return _selectedCustomer is not null;
            }

            if (_paymentMode == PaymentUiMode.Cash)
            {
                if (string.IsNullOrWhiteSpace(_cashGivenText))
                {
                    return true; // exact tender
                }

                return TryParseRs(_cashGivenText, out long given)
                       && given >= PayablePaisa;
            }

            return !string.IsNullOrWhiteSpace(_onlineTxnRef)
                   && !string.IsNullOrWhiteSpace(_onlineChannel);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        CartService.Changed += OnCartChanged;
        ShiftStatus.Changed += OnShiftStatusChanged;
        _clockTimer = new Timer(_ =>
        {
            _now = DateTime.Now;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        await Task.WhenAll(
            LoadProductsAsync(),
            LoadReceiveProductsAsync(),
            LoadCustomersAsync(),
            LoadRecentBillsAsync(),
            ShiftStatus.RefreshAsync());

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("receive=1", StringComparison.OrdinalIgnoreCase))
        {
            _showReceiveGoods = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _scanInput.FocusAsync();
        }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private void OnShiftStatusChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadProductsAsync()
    {
        _isLoadingProducts = true;
        Result<IReadOnlyList<SalesProductDto>> result =
            await SalesApi.GetProductsForSaleAsync();
        _isLoadingProducts = false;

        if (result.Success && result.Data is not null)
        {
            _products = result.Data;
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
            ? "Unable to load products."
            : result.ErrorMessage;
    }

    private async Task LoadReceiveProductsAsync()
    {
        Result<IReadOnlyList<SalesProductDto>> result =
            await SalesApi.GetProductsForReceiveAsync();

        if (result.Success && result.Data is not null)
        {
            _receiveProducts = result.Data;
            return;
        }

        // Fall back to sale catalog so receive still works if endpoint is unavailable.
        if (_products.Count > 0)
        {
            _receiveProducts = _products;
        }
    }

    private async Task LoadCustomersAsync()
    {
        _isLoadingCustomers = true;
        _customerLoadError = null;
        Result<IReadOnlyList<PartyDto>> result = await CustomerApi.GetCustomersAsync();
        _isLoadingCustomers = false;

        if (result.Success && result.Data is not null)
        {
            _customers = result.Data;
            return;
        }

        _customers = [];
        _customerLoadError = string.IsNullOrWhiteSpace(result.ErrorMessage)
            ? "Unable to load customers."
            : result.ErrorMessage;
    }

    private async Task LoadRecentBillsAsync()
    {
        if (!SessionService.IsActive)
        {
            _recentBills = [];
            return;
        }

        _isLoadingRecentBills = true;
        Result<IReadOnlyList<SalesInvoiceSummaryDto>> result =
            await InvoiceApi.ListAsync(SessionService.ShiftId, 4);
        _isLoadingRecentBills = false;

        if (result.Success && result.Data is not null)
        {
            _recentBills = result.Data;
            return;
        }

        _recentBills = [];
    }

    private void SelectCategory(string category)
    {
        _categoryFilter = category;
        _errorMessage = null;
    }

    private static IEnumerable<SalesProductDto> ApplyFilters(
        IReadOnlyList<SalesProductDto> products,
        string gridSearch,
        string categoryFilter)
    {
        IEnumerable<SalesProductDto> query = products;

        if (!string.Equals(categoryFilter, "All", StringComparison.Ordinal))
        {
            query = categoryFilter switch
            {
                "Loose only" => query.Where(product => product.IsLoose),
                _ => query.Where(product =>
                    string.Equals(product.CategoryName, categoryFilter, StringComparison.OrdinalIgnoreCase))
            };
        }

        string search = gridSearch.Trim();
        if (!string.IsNullOrEmpty(search))
        {
            query = query.Where(product =>
                product.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                || product.Sku.Contains(search, StringComparison.OrdinalIgnoreCase)
                || product.ShortCode.Contains(search, StringComparison.OrdinalIgnoreCase)
                || product.Barcode.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(product => product.ShortCode).ThenBy(product => product.Name);
    }

    private SalesProductDto? ResolveProductFromScan(string input)
    {
        string trimmed = input.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            return null;
        }

        SalesProductDto? byShortCode = _products.FirstOrDefault(product =>
            string.Equals(product.ShortCode, trimmed, StringComparison.OrdinalIgnoreCase));
        if (byShortCode is not null)
        {
            return byShortCode;
        }

        SalesProductDto? byBarcode = _products.FirstOrDefault(product =>
            string.Equals(product.Barcode, trimmed, StringComparison.OrdinalIgnoreCase));
        if (byBarcode is not null)
        {
            return byBarcode;
        }

        List<SalesProductDto> matches = ApplyFilters(_products, trimmed, "All").ToList();
        return matches.Count == 1 ? matches[0] : null;
    }

    private void AddProductToCart(SalesProductDto product)
    {
        _errorMessage = null;
        _checkoutError = null;
        _successMessage = null;

        // Grid cards are product-level; allocate qty across FEFO batches.
        decimal remaining = product.IsLoose ? 1m : 1m;
        List<SalesProductDto> batches = BatchesForProduct(product.ProductId).ToList();
        if (batches.Count == 0)
        {
            _errorMessage = $"{product.Name} has no sellable stock.";
            return;
        }

        decimal available = batches.Sum(b => b.AvailableStock);
        decimal alreadyInCart = CartService.Lines
            .Where(l => l.Product.ProductId == product.ProductId)
            .Sum(l => l.Quantity);
        if (alreadyInCart + remaining > available + 0.0001m)
        {
            _errorMessage =
                $"Only {available:0.##} units of {product.Name} are available.";
            return;
        }

        foreach (SalesProductDto batch in batches)
        {
            if (remaining <= 0)
            {
                break;
            }

            decimal inCart = CartService.Lines
                .FirstOrDefault(l => l.Product.BatchId == batch.BatchId)?.Quantity ?? 0m;
            decimal room = batch.AvailableStock - inCart;
            if (room <= 0)
            {
                continue;
            }

            decimal take = Math.Min(room, remaining);
            CartService.Add(batch, take);
            remaining -= take;

            if (batch.IsLoose)
            {
                CartLine? line = CartService.Lines.FirstOrDefault(
                    entry => entry.Product.BatchId == batch.BatchId);
                if (line is not null)
                {
                    _looseQtyText[batch.BatchId] =
                        line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);
                }
            }
        }
    }

    private static IEnumerable<SalesProductDto> GroupProductsForDisplay(
        IEnumerable<SalesProductDto> batches)
    {
        return batches
            .GroupBy(p => p.ProductId)
            .Select(g =>
            {
                List<SalesProductDto> ordered = g
                    .OrderBy(x => x.ExpiryDate ?? DateOnly.MaxValue)
                    .ThenBy(x => x.BatchNumber)
                    .ToList();
                SalesProductDto first = ordered[0];
                return new SalesProductDto
                {
                    ProductId = first.ProductId,
                    BatchId = first.BatchId,
                    BatchNumber = first.BatchNumber,
                    Name = first.Name,
                    Sku = first.Sku,
                    Barcode = first.Barcode,
                    ShortCode = first.ShortCode,
                    CategoryName = first.CategoryName,
                    IsLoose = first.IsLoose,
                    UnitPricePaisa = first.UnitPricePaisa,
                    AvailableStock = ordered.Sum(x => x.AvailableStock),
                    ExpiryDate = first.ExpiryDate
                };
            })
            .OrderBy(p => p.Name);
    }

    private IEnumerable<SalesProductDto> BatchesForProduct(Guid productId) =>
        _products
            .Where(p => p.ProductId == productId && p.AvailableStock > 0)
            .OrderBy(p => p.ExpiryDate ?? DateOnly.MaxValue)
            .ThenBy(p => p.BatchNumber);

    private async Task AddFromScanAsync()
    {
        _errorMessage = null;
        SalesProductDto? product = ResolveProductFromScan(_scanText);
        if (product is null)
        {
            _errorMessage = string.IsNullOrWhiteSpace(_scanText)
                ? "Enter a short code or scan a barcode."
                : $"Product not found for '{_scanText.Trim()}'.";
            return;
        }

        AddProductToCart(product);
        _scanText = string.Empty;
        await _scanInput.FocusAsync();
    }

    private void ChangeQty(CartLine line, decimal delta)
    {
        decimal newQty = line.Quantity + delta;
        if (newQty > line.Product.AvailableStock)
        {
            _errorMessage =
                $"Only {line.Product.AvailableStock:0.##} units of {line.Product.Name} are available.";
            return;
        }

        _errorMessage = null;
        CartService.SetQuantity(line.Product.BatchId, newQty);
    }

    private string GetLooseQtyText(CartLine line) =>
        _looseQtyText.TryGetValue(line.Product.BatchId, out string? text)
            ? text
            : line.Quantity.ToString("0.##", CultureInfo.InvariantCulture);

    private void OnLooseQtyChanged(CartLine line, ChangeEventArgs e)
    {
        string raw = e.Value?.ToString() ?? string.Empty;
        _looseQtyText[line.Product.BatchId] = raw;

        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal quantity)
            && !decimal.TryParse(raw, NumberStyles.Number, CultureInfo.CurrentCulture, out quantity))
        {
            return;
        }

        if (quantity <= 0)
        {
            return;
        }

        if (quantity > line.Product.AvailableStock)
        {
            _errorMessage =
                $"Only {line.Product.AvailableStock:0.##} units of {line.Product.Name} are available.";
            return;
        }

        _errorMessage = null;
        CartService.SetQuantity(line.Product.BatchId, quantity);
        _looseQtyText[line.Product.BatchId] = quantity.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private void RemoveLine(CartLine line)
    {
        _looseQtyText.Remove(line.Product.BatchId);
        CartService.Remove(line.Product.BatchId);
    }

