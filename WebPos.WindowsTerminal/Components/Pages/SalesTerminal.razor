    private async Task CompleteSaleFromModalAsync(PaymentModal.PaymentCheckoutResult choice)
    {
        _checkoutError = null;
        _errorMessage = null;
        _successMessage = null;

        _paymentMode = choice.Mode switch
        {
            PaymentModal.PaymentUiMode.Online => PaymentUiMode.Online,
            PaymentModal.PaymentUiMode.Credit => PaymentUiMode.Credit,
            _ => PaymentUiMode.Cash
        };

        if (choice.Mode == PaymentModal.PaymentUiMode.Cash)
        {
            _cashGivenText = FormatRs(choice.AmountPaidPaisa);
        }
        else if (choice.Mode == PaymentModal.PaymentUiMode.Online)
        {
            _onlineChannel = choice.PaymentMethod;
            _onlineTxnRef = choice.OnlineTxnRef ?? string.Empty;
            _cashGivenText = FormatRs(choice.AmountPaidPaisa);
        }

        Guid? customerId = _selectedCustomer?.Id;
        long? changePaisa = choice.ChangePaisa > 0 ? choice.ChangePaisa : null;
        string? txnRef = choice.OnlineTxnRef;
        long discountPaisa = DiscountAmountPaisa;

        List<CartLine> saleLines = CartService.Lines
            .Select(line => new CartLine
            {
                LineId = line.LineId,
                Product = line.Product,
                Quantity = line.Quantity,
                UnitPriceOverridePaisa = line.UnitPriceOverridePaisa,
                DescriptionOverride = line.DescriptionOverride,
                PackingOverride = line.PackingOverride
            })
            .ToList();
        string? customerPhone = _selectedCustomer?.PhoneNumber;
        bool whatsApp = _whatsAppReceipt;
        bool printPrinter = _printOnPrinter;

        _isBusy = true;
        try
        {
            Result<CompleteSaleResult> result = await SalesApi.CompleteCartAsync(
                CartService.Lines,
                choice.PaymentMethod,
                customerId,
                discountPaisa,
                invoiceNo: string.IsNullOrWhiteSpace(_draftInvoiceNo) ? null : $"POS-{_draftInvoiceNo}",
                amountPaidPaisa: WalkInSettlement.ResolveAmountPaidForApi(
                    IsWalkInCustomer,
                    isCreditMode: choice.Mode == PaymentModal.PaymentUiMode.Credit,
                    uiAmountPaidPaisa: choice.AmountPaidPaisa),
                cashAccountId: choice.CashAccountId,
                applyExcessAsCustomerCredit: choice.ApplyExcessAsCustomerCredit,
                onlineTxnRef: txnRef);

            if (!result.Success)
            {
                _checkoutError = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Sale failed."
                    : result.ErrorMessage;
                return;
            }

            CompleteSaleResult sale = result.Data!;
            string paymentLabel = CheckoutPaymentMethods.DisplayLabel(choice.PaymentMethod);

            if (_selectedCustomer is not null && sale.CustomerBalancePaisa is long bal)
            {
                _selectedCustomer = new PartyDto
                {
                    Id = _selectedCustomer.Id,
                    Name = _selectedCustomer.Name,
                    Role = _selectedCustomer.Role,
                    PhoneNumber = _selectedCustomer.PhoneNumber,
                    Address = _selectedCustomer.Address,
                    CreditLimitPaisa = _selectedCustomer.CreditLimitPaisa,
                    CurrentBalancePaisa = bal
                };
            }

            LastSaleReceiptStore.Set(new LastSaleReceipt
            {
                Sale = sale,
                Lines = saleLines,
                PaymentLabel = paymentLabel,
                OnlineTxnRef = txnRef,
                ChangePaisa = changePaisa ?? (sale.ChangePaisa > 0 ? sale.ChangePaisa : null),
                CustomerPhone = customerPhone
            });

            _showPaymentModal = false;
            _paymentLivePreview = null;
            _qtyText.Clear();
            _priceText.Clear();
            _totalText.Clear();
            _codeText.Clear();
            CartService.Clear();
            _cashGivenText = string.Empty;
            _onlineTxnRef = string.Empty;
            _discountRsText = string.Empty;
            _discountPctText = string.Empty;
            _remarks = string.Empty;
            _selectedCustomer = null;
            _useWalkInCustomer = true;
            _paymentMode = PaymentUiMode.Cash;
            _selectedLineIndex = -1;
            _lastScannedLineId = null;
            _whatsAppReceipt = false;
            _printOnPrinter = false;
            _cfdPhase = "selling";
            AssignDraftInvoiceNo();
            await PublishCfdSnapshotAsync("selling");
            try { await Js.InvokeVoidAsync("webPosResetTableScroll"); }
            catch { /* ignore */ }

            await Task.WhenAll(
                LoadProductsAsync(),
                LoadMastersAsync(),
                LoadQuickLinksAsync(),
                LoadCustomersAsync(),
                ShiftStatus.RefreshAsync());

            if (whatsApp)
            {
                await WhatsAppReceiptAsync();
            }

            if (printPrinter)
            {
                await PrintReceiptAsync();
            }

            await FocusScanAsync();
        }
        catch (SessionNotActiveException)
        {
            _checkoutError = "Start Shift before processing a sale.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Payment modal checkout failed.");
            _checkoutError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Unexpected sale error. Try again."
                : ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

