@page "/sales"
@using System.Globalization
@using Common.Models
@using Microsoft.Extensions.Logging
@using WebPos.WindowsTerminal
@using WebPos.WindowsTerminal.Services
@implements IDisposable
@inject SalesApiClient SalesApi
@inject CartService CartService
@inject CustomerApiClient CustomerApi
@inject WhatsAppReceiptService WhatsAppReceiptService
@inject ISessionService SessionService
@inject InvoiceApiClient InvoiceApi
@inject PurchaseIntakeApiClient PurchaseIntake
@inject ShiftStatusApiClient ShiftStatus
@inject LastSaleReceiptStore LastSaleReceiptStore
@inject CartHoldService CartHoldService
@inject LoginApiClient Login
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ILogger<SalesTerminal> Logger

<PageTitle>Cone Mart POS</PageTitle>

<div class="pos-shell sf-shell smart-pos" @onkeydown="OnKeyDown" tabindex="0">
    <PosTopMenu OnPurchaseOrders="OpenPurchaseOrdersAsync"
                OnCreatePurchaseOrder="OpenCreatePurchaseOrder"
                OnLockRequested="LockTerminal"
                OnHold="HoldCart"
                OnRetrieve="ResumeHeldCart" />

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert-red" role="alert" aria-live="assertive">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="success-toast" role="status" aria-live="polite">@_successMessage</div>
    }

    <div class="sf-body sp-body">
        <section class="sf-main sp-main">
            <header class="sp-search-bar">
                <div class="sp-search-wrap">
                    <input id="scanInput"
                           class="sp-search-input"
                           type="text"
                           placeholder="Enter item code, description or barcode..."
                           autocomplete="off"
                           inputmode="search"
                           @ref="_scanInput"
                           value="@_scanText"
                           @oninput="OnScanInput"
                           @onkeydown="OnScanKeyDown"
                           @onfocus="OnScanFocus"
                           disabled="@(_isBusy || ModalOpen)" />
                    <button type="button"
                            class="sp-search-mode @(_broadSearch ? "active" : null)"
                            title="@(_broadSearch ? "Fast mode: barcode & short code only" : "Include name / SKU search")"
                            disabled="@(_isBusy || ModalOpen)"
                            @onclick="ToggleBroadSearch">
                        @(_broadSearch ? "All" : "Code")
                    </button>
                    <span class="sp-search-icon" aria-hidden="true"></span>
                    @if (_showScanDropdown && ScanHits.Count > 0)
                    {
                        <ul class="sf-scan-dropdown" role="listbox">
                            @foreach ((object hit, int i) in ScanHits.Select((h, i) => (h, i)))
                            {
                                <li class="@(i == _scanHighlight ? "active" : null)"
                                    role="option"
                                    @onmousedown:preventDefault
                                    @onclick="() => ChooseScanHitAsync(hit)">
                                    @if (hit is SalesProductDto p)
                                    {
                                        <strong>@p.Name</strong>
                                        <span>@(string.IsNullOrWhiteSpace(p.ShortCode) ? p.Barcode : p.ShortCode) · Rs @FormatRs(p.UnitPricePaisa)</span>
                                    }
                                    else if (hit is SaleMasterDto m)
                                    {
                                        <strong>@m.Name</strong>
                                        <span>Master · @(m.ShortCode ?? "—") · @((m.Children?.Count) ?? 0) pack(s)</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="sp-qty-chip" title="Line count">
                    <span>QUANTITY</span>
                    <strong>@CartService.Lines.Count</strong>
                </div>
                <div class="sp-till-chip" title="Till drawer expected cash">
                    <span>DRAWER</span>
                    <strong>Rs @FormatRs(ShiftStatus.ExpectedCashPaisa)</strong>
                </div>
                <div class="sp-invoice">
                    <span class="sp-invoice-icon" aria-hidden="true"></span>
                    <strong>Invoice #@_draftInvoiceNo</strong>
                </div>
            </header>

            <div class="sp-grid-wrap">
                <table class="sp-grid">
                    <thead>
                        <tr>
                            <th class="col-sr">Sr. #</th>
                            <th class="col-code">Item Code</th>
                            <th class="col-desc">Description</th>
                            <th class="col-pack">Packing</th>
                            <th class="col-qty">Qty</th>
                            <th class="col-price">Price</th>
                            <th class="col-total">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            IReadOnlyList<CartLine> cartLines = CartService.Lines;
                            for (int row = 0; row < 12; row++)
                            {
                                if (row < cartLines.Count)
                                {
                                    CartLine line = cartLines[row];
                                    bool selected = row == _selectedLineIndex;
                                    <tr class="@(selected ? "selected" : null) @(row % 2 == 1 ? "zebra" : null)" @onclick="() => _selectedLineIndex = row">
                                        <td class="col-sr">@(row + 1)</td>
                                        <td class="col-code">@ItemCode(line.Product)</td>
                                        <td class="col-desc">@(line.Product.Name ?? string.Empty)</td>
                                        <td class="col-pack">@(string.IsNullOrWhiteSpace(line.Product.PackingSize) ? "—" : line.Product.PackingSize)</td>
                                        <td class="col-qty">
                                            <input id="@($"pos-qty-{row}")"
                                                   class="sf-cell-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   value="@GetQtyText(line)"
                                                   @oninput="e => OnQtyChanged(line, e)"
                                                   @onfocus="() => _selectedLineIndex = row"
                                                   @onkeydown="e => OnQtyKeyDown(e, row)"
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-price">
                                            <input class="sf-cell-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   value="@GetPriceText(line)"
                                                   @oninput="e => OnPriceChanged(line, e)"
                                                   disabled="@_isBusy" />
                                        </td>
                                        <td class="col-total">@FormatRs(line.LineTotalPaisa)</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="sp-empty-row @(row % 2 == 1 ? "zebra" : null)">
                                        <td class="col-sr">@(row + 1)</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="sp-totals">
                <div class="sp-tot">
                    <span>Sub Total</span>
                    <strong>@FormatRs(CartService.SubtotalPaisa)</strong>
                </div>
                <div class="sp-tot">
                    <span>Previous Due</span>
                    <strong>@FormatRs(PreviousDuePaisa)</strong>
                </div>
                <div class="sp-tot sp-tot-disc">
                    <span>Discount</span>
                    <div class="sp-disc-row">
                        <input type="text" inputmode="decimal" title="Discount %" placeholder="0.00 %" value="@_discountPctText" @oninput="OnDiscountPctInput" disabled="@_isBusy" />
                        <strong>@FormatRs(DiscountPaisa)</strong>
                    </div>
                </div>
                <div class="sp-tot sp-tot-pay">
                    <span>Payment</span>
                    <input type="text" inputmode="decimal" @bind="_cashGivenText" @bind:event="oninput" disabled="@(_isBusy || _paymentMode != PaymentUiMode.Cash)" />
                    <div class="sp-pay-modes">
                        <button type="button" class="sp-pay-link @(_paymentMode == PaymentUiMode.Cash ? "active" : null)" @onclick="SelectCashMode">Cash</button>
                        <button type="button" class="sp-pay-link @(_paymentMode == PaymentUiMode.Online ? "active" : null)" @onclick="SelectOnlineMode">Online</button>
                        <button type="button" class="sp-pay-link @(_paymentMode == PaymentUiMode.Credit ? "active" : null)" disabled="@(_selectedCustomer is null)" @onclick="SelectCreditMode">Credit</button>
                    </div>
                    @if (_paymentMode == PaymentUiMode.Online)
                    {
                        <div class="sf-online-row">
                            @foreach (CheckoutPaymentOption channel in CheckoutPaymentMethods.OnlineChannels)
                            {
                                <button type="button"
                                        class="channel-pill @(string.Equals(_onlineChannel, channel.Method, StringComparison.Ordinal) ? "active" : string.Empty)"
                                        @onclick="() => _onlineChannel = channel.Method">
                                    @channel.Label
                                </button>
                            }
                            <input class="txn-ref-input" placeholder="Txn ref" @bind="_onlineTxnRef" @bind:event="oninput" disabled="@_isBusy" />
                        </div>
                    }
                </div>
                <div class="sp-tot sp-tot-balance">
                    <span>Balance</span>
                    <strong>@FormatRs(SaleBalancePaisa)</strong>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_checkoutError))
            {
                <p class="field-error sf-checkout-error" role="alert">@_checkoutError</p>
            }

            <div class="sp-fkey-bar" role="toolbar" aria-label="POS shortcuts">
                <button type="button" class="sp-fkey" disabled="@ModalOpen" @onclick="OpenSearchCustomerAsync">
                    <span class="sp-fkey-badge">F3</span>
                    <span class="sp-ico sp-ico-cust-search" aria-hidden="true"></span>
                    <span class="sp-fkey-label">Search Customer</span>
                </button>
                <button type="button" class="sp-fkey" disabled="@ModalOpen" @onclick="OpenAddCustomer">
                    <span class="sp-fkey-badge">F4</span>
                    <span class="sp-ico sp-ico-cust-add" aria-hidden="true"></span>
                    <span class="sp-fkey-label">Add Customer</span>
                </button>
                <button type="button" class="sp-fkey" disabled="@_isBusy" @onclick="NewSale">
                    <span class="sp-fkey-badge">F5</span>
                    <span class="sp-ico sp-ico-doc" aria-hidden="true"></span>
                    <span class="sp-fkey-label">Form Reset</span>
                </button>
                <button type="button"
                        class="sp-fkey @(_whatsAppReceipt ? "sp-fkey-on" : null)"
                        disabled="@ModalOpen"
                        title="Toggle WhatsApp invoice after save"
                        @onclick="ToggleWhatsAppInvoice">
                    <span class="sp-fkey-badge">F6</span>
                    <span class="sp-ico sp-ico-wa" aria-hidden="true"></span>
                    <span class="sp-fkey-label">WhatsApp Invoice</span>
                </button>
                <button type="button"
                        class="sp-fkey @(_printOnPrinter ? "sp-fkey-on" : null)"
                        disabled="@ModalOpen"
                        title="Toggle print invoice after save"
                        @onclick="TogglePrintInvoice">
                    <span class="sp-fkey-badge">F7</span>
                    <span class="sp-ico sp-ico-print" aria-hidden="true"></span>
                    <span class="sp-fkey-label">Print Invoice</span>
                </button>
                <button type="button"
                        class="sp-fkey sp-fkey-cust @(!_useWalkInCustomer ? "sp-fkey-on-red" : null)"
                        disabled="@ModalOpen"
                        title="Select regular customer"
                        @onclick="SelectRegisteredCustomerMode">
                    <span class="sp-fkey-badge">F8</span>
                    <span class="sp-ico sp-ico-person" aria-hidden="true"></span>
                    @if (!_useWalkInCustomer && _selectedCustomer is not null)
                    {
                        <span class="sp-fkey-cust-name">@_selectedCustomer.Name</span>
                        <span class="sp-fkey-cust-code">@DisplayCodeFor(_selectedCustomer)</span>
                    }
                    else
                    {
                        <span class="sp-fkey-label">Regular Customer</span>
                    }
                </button>
                <button type="button"
                        class="sp-fkey sp-fkey-cust @(_useWalkInCustomer ? "sp-fkey-on-red" : null)"
                        disabled="@ModalOpen"
                        title="Use walk-in customer"
                        @onclick="SelectWalkInCustomer">
                    <span class="sp-fkey-badge">F9</span>
                    <span class="sp-ico sp-ico-walk" aria-hidden="true"></span>
                    <span class="sp-fkey-label">Walk In Customer</span>
                </button>
                <button type="button" class="sp-save" disabled="@(CartService.IsEmpty || _isBusy || !CanPay)" @onclick="PayNowAsync">
                    <span class="sp-save-keys">
                        <span>(Insert)</span>
                        <span>Ctrl + Enter</span>
                        <span>F12</span>
                    </span>
                    <span class="sp-save-main">
                        <span class="sp-ico sp-ico-save" aria-hidden="true"></span>
                        <span class="sp-save-label">Save Invoice</span>
                    </span>
                </button>
            </div>
        </section>
    </div>
</div>

@if (_showPhonePrompt)
{
    <div class="modal-backdrop" @onclick="ClosePhonePrompt">
        <div class="success-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h2>WhatsApp phone</h2>
            <p class="success-invoice">Enter a number for the walk-in receipt.</p>
            <label class="field-label" for="waPhone">WhatsApp phone</label>
            <input id="waPhone"
                   class="txn-ref-input"
                   type="tel"
                   placeholder="03xxxxxxxxx"
                   @bind="_whatsAppPhone"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_whatsAppError))
            {
                <p class="field-error">@_whatsAppError</p>
            }
            <div class="checkout-actions">
                <button type="button" class="secondary-btn" @onclick="ClosePhonePrompt">Cancel</button>
                <button type="button" class="pay-btn" @onclick="ConfirmWhatsAppPhoneAsync">Send</button>
            </div>
        </div>
    </div>
}

<SelectVariantModal Master="@_variantMaster"
                    OnClose="CloseVariant"
                    OnSelected="OnVariantSelected" />

<CategoryPickModal CategoryName="@_categoryPickName"
                   Products="@_products"
                   Masters="@_masters"
                   OnClose="CloseCategoryPick"
                   OnProductSelected="OnCategoryProductSelected"
                   OnMasterSelected="OnCategoryMasterSelected" />

<ItemSearchModal Visible="@_showItemSearch"
                 InitialQuery="@_itemSearchSeed"
                 Products="@_products"
                 Masters="@_masters"
                 OnClose="CloseItemSearch"
                 OnProductSelected="OnSearchProductSelected"
                 OnMasterSelected="OnSearchMasterSelected" />

<PriceCheckerModal Visible="@_showPriceChecker"
                   Products="@_products"
                   Masters="@_masters"
                   OnClose="() => _showPriceChecker = false" />

<CustomerSearchModal Visible="@_showCustomerSearch"
                     Customers="@_customers"
                     OnClose="() => _showCustomerSearch = false"
                     OnSelected="OnCustomerPickedAsync" />

<CustomerAddModal Visible="@_showCustomerAdd"
                  OnClose="() => _showCustomerAdd = false"
                  OnCreated="OnCustomerCreatedAsync" />

<CalculatorModal Visible="@_showCalculator"
                 OnClose="() => _showCalculator = false" />

<CreatePurchaseOrderModal @ref="_createPurchaseOrderModal"
                          Visible="_showCreatePurchaseOrder"
                          EditingPurchaseOrderId="_editingPurchaseOrderId"
                          IntakeService="PurchaseIntake"
                          ReceiverId="SessionService.CashierId"
                          OnClose="CloseCreatePurchaseOrder"
                          OnMinimize="MinimizeCreatePurchaseOrder"
                          OnCreated="OnPurchaseOrderCreatedAsync"
                          OnSaved="OnPurchaseOrderSavedAsync"
                          OnReceived="OnPurchaseOrderReceivedAsync" />

<PurchaseOrdersModal Visible="_showPurchaseOrders"
                     IntakeService="PurchaseIntake"
                     OnClose="ClosePurchaseOrders"
                     OnMinimize="MinimizePurchaseOrders"
                     OnCreatePurchaseOrder="OpenCreateFromPurchaseOrders"
                     OnEditPurchaseOrder="OpenEditPurchaseOrder"
                     OnReceivePurchaseOrder="OpenReceivePurchaseOrder" />

@if (_purchaseOrdersMinimized || _createPurchaseOrderMinimized)
{
    <div class="pos-mini-dock" role="status" aria-label="Minimized windows">
        @if (_createPurchaseOrderMinimized)
        {
            <button type="button" class="pos-mini-chip orders" @onclick="RestoreCreatePurchaseOrder">
                <span class="pos-mini-ico orders-ico" aria-hidden="true"></span>
                <span class="pos-mini-text">
                    <strong>@(_editingPurchaseOrderId is Guid ? "Edit Purchase Order" : "Create Purchase Order")</strong>
                    <span>
                        @(string.IsNullOrWhiteSpace(_cpoMiniInvoice) ? "Draft" : _cpoMiniInvoice)
                        · @_cpoMiniLineCount line@(_cpoMiniLineCount == 1 ? "" : "s")
                    </span>
                </span>
                <span class="pos-mini-badge">Minimized</span>
            </button>
        }
        @if (_purchaseOrdersMinimized)
        {
            <button type="button" class="pos-mini-chip orders" @onclick="RestorePurchaseOrders">
                <span class="pos-mini-ico orders-ico" aria-hidden="true"></span>
                <span class="pos-mini-text">
                    <strong>Purchase Orders</strong>
                    <span>List parked · tap to restore</span>
                </span>
                <span class="pos-mini-badge">Minimized</span>
            </button>
        }
    </div>
}

@code {
    private enum PaymentUiMode
    {
        Cash,
        Online,
        Credit
    }

    private ElementReference _scanInput;
    private readonly SalesScanFocusCoordinator _scanFocus = new();
    private List<SalesProductDto> _products = [];
    private List<SaleMasterDto> _masters = [];
    private List<SaleQuickLinkDto> _quickLinks = [];
    private IReadOnlyList<PartyDto> _customers = [];
    private readonly Dictionary<Guid, string> _qtyText = [];
    private readonly Dictionary<Guid, string> _priceText = [];

    private string _scanText = string.Empty;
    private bool _showScanDropdown;
    private bool _broadSearch;
    private int _scanHighlight;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _checkoutError;
    private string? _customerLoadError;
    private string? _whatsAppError;
    private bool _isBusy;
    private bool _useWalkInCustomer = true;
    private bool _showPhonePrompt;
    private bool _showPurchaseOrders;
    private bool _showCreatePurchaseOrder;
    private bool _purchaseOrdersMinimized;
    private bool _createPurchaseOrderMinimized;
    private Guid? _editingPurchaseOrderId;
    private string _cpoMiniInvoice = string.Empty;
    private int _cpoMiniLineCount;
    private CreatePurchaseOrderModal? _createPurchaseOrderModal;
    private bool _showItemSearch;
    private string _itemSearchSeed = string.Empty;
    private bool _showPriceChecker;
    private bool _showCustomerSearch;
    private bool _showCustomerAdd;
    private bool _showCalculator;
    private bool _whatsAppReceipt;
    private bool _printOnPrinter;
    private bool _isDisposed;
    private string _cashGivenText = string.Empty;
    private string _discountRsText = string.Empty;
    private string _discountPctText = string.Empty;
    private string _remarks = string.Empty;
    private string _draftInvoiceNo = string.Empty;
    private DateTime _saleDate = DateTime.Today;
    private string _onlineChannel = CheckoutPaymentMethods.EasyPaisa;
    private string _onlineTxnRef = string.Empty;
    private string _whatsAppPhone = string.Empty;
    private PartyDto? _selectedCustomer;
    private SaleMasterDto? _variantMaster;
    private string? _categoryPickName;
    private PaymentUiMode _paymentMode = PaymentUiMode.Cash;
    private DateTime _now = DateTime.Now;
    private Timer? _clockTimer;
    private int _selectedLineIndex = -1;

    private bool ModalOpen =>
        _showPhonePrompt
        || _showPurchaseOrders
        || _showCreatePurchaseOrder
        || _showItemSearch
        || _showPriceChecker
        || _showCustomerSearch
        || _showCustomerAdd
        || _showCalculator
        || _variantMaster is not null
        || !string.IsNullOrWhiteSpace(_categoryPickName);

    private static string DisplayCodeFor(PartyDto customer)
    {
        string phone = customer.PhoneNumber ?? string.Empty;
        string digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length >= 5)
        {
            return digits[^5..];
        }

        return customer.Id.ToString("N")[^5..].ToUpperInvariant();
    }

    private IReadOnlyList<object> ScanHits
    {
        get
        {
            string q = (_scanText ?? string.Empty).Trim();
            if (q.Length == 0)
            {
                return [];
            }

            List<object> list = [];
            IEnumerable<SaleMasterDto> masters = _masters ?? [];
            IEnumerable<SalesProductDto> products = _products ?? [];

            foreach (SaleMasterDto m in masters
                         .Where(m => ProductFieldMatches(m.Name, m.Barcode, m.Sku, m.ShortCode, q))
                         .OrderBy(m => ExactProductRank(m.Name, m.Barcode, m.Sku, m.ShortCode, q))
                         .ThenBy(m => m.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                         .Take(_broadSearch ? 8 : 6))
            {
                list.Add(m);
            }

            foreach (SalesProductDto p in products
                         .Where(p => ProductFieldMatches(p.Name, p.Barcode, p.Sku, p.ShortCode, q))
                         .OrderBy(p => ExactProductRank(p.Name, p.Barcode, p.Sku, p.ShortCode, q))
                         .ThenBy(p => p.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                         .Take(Math.Max(0, (_broadSearch ? 16 : 10) - list.Count)))
            {
                list.Add(p);
            }

            return list;
        }
    }

    private void ToggleBroadSearch()
    {
        _broadSearch = !_broadSearch;
        if (_scanText.Trim().Length > 0)
        {
            _showScanDropdown = true;
            _scanHighlight = 0;
        }
    }

    private bool ProductFieldMatches(string? name, string? barcode, string? sku, string? shortCode, string q)
    {
        if (!_broadSearch)
        {
            return FieldContains(barcode, q) || FieldContains(shortCode, q);
        }

        return FieldContains(name, q)
            || FieldContains(barcode, q)
            || FieldContains(sku, q)
            || FieldContains(shortCode, q);
    }

    private static int ExactProductRank(string? name, string? barcode, string? sku, string? shortCode, string q)
    {
        if (FieldEquals(shortCode, q) || FieldEquals(barcode, q) || FieldEquals(sku, q))
        {
            return 0;
        }

        if (FieldEquals(name, q))
        {
            return 1;
        }

        if (FieldContains(shortCode, q) || FieldContains(barcode, q) || FieldContains(sku, q))
        {
            return 2;
        }

        return 3;
    }

    private static bool FieldContains(string? field, string q) =>
        !string.IsNullOrEmpty(field) && field.Contains(q, StringComparison.OrdinalIgnoreCase);

    private static bool FieldEquals(string? field, string q) =>
        !string.IsNullOrEmpty(field) && string.Equals(field, q, StringComparison.OrdinalIgnoreCase);

    private long DiscountAmountPaisa
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_discountRsText))
            {
                return 0;
            }

            return TryParseRs(_discountRsText, out long paisa) ? paisa : 0;
        }
    }

    private long DiscountPaisa => DiscountAmountPaisa;

    private void SyncDiscountPctFromRs()
    {
        long sub = CartService.SubtotalPaisa;
        if (sub <= 0 || DiscountAmountPaisa <= 0)
        {
            _discountPctText = string.Empty;
            return;
        }

        decimal pct = DiscountAmountPaisa * 100m / sub;
        _discountPctText = pct.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private void OnDiscountRsInput(ChangeEventArgs e)
    {
        _discountRsText = e.Value?.ToString() ?? string.Empty;
        SyncDiscountPctFromRs();
    }

    private void OnDiscountPctInput(ChangeEventArgs e)
    {
        _discountPctText = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_discountPctText))
        {
            _discountRsText = string.Empty;
            return;
        }

        if (!decimal.TryParse(_discountPctText, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal pct)
            || pct < 0)
        {
            return;
        }

        long paisa = (long)Math.Round(CartService.SubtotalPaisa * pct / 100m, MidpointRounding.AwayFromZero);
        _discountRsText = (paisa / 100m).ToString("0.##", CultureInfo.InvariantCulture);
    }

    private long PayablePaisa =>
        Math.Max(0, CartService.SubtotalPaisa - DiscountAmountPaisa);

    private long PreviousDuePaisa =>
        !_useWalkInCustomer && _selectedCustomer is not null
            ? _selectedCustomer.CurrentBalancePaisa
            : 0;

    private long PaymentReceivedPaisa
    {
        get
        {
            if (_paymentMode == PaymentUiMode.Credit)
            {
                return 0;
            }

            if (_paymentMode == PaymentUiMode.Online)
            {
                return string.IsNullOrWhiteSpace(_onlineTxnRef) ? 0 : PayablePaisa;
            }

            if (TryParseRs(_cashGivenText, out long given) && given > 0)
            {
                return given;
            }

            return 0;
        }
    }

    private long SaleBalancePaisa => PayablePaisa - Math.Min(PaymentReceivedPaisa, PayablePaisa);

    private long CustomerNetBalancePaisa =>
        PreviousDuePaisa + PayablePaisa - PaymentReceivedPaisa;

    private bool CanPay
    {
        get
        {
            if (CartService.IsEmpty || DiscountAmountPaisa > CartService.SubtotalPaisa)
            {
                return false;
            }

            if (_paymentMode == PaymentUiMode.Credit)
            {
                return _selectedCustomer is not null;
            }

            if (_paymentMode == PaymentUiMode.Cash)
            {
                if (string.IsNullOrWhiteSpace(_cashGivenText))
                {
                    return true;
                }

                return TryParseRs(_cashGivenText, out long given) && given >= PayablePaisa;
            }

            return !string.IsNullOrWhiteSpace(_onlineTxnRef)
                   && !string.IsNullOrWhiteSpace(_onlineChannel);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        CartService.Changed += OnCartChanged;
        ShiftStatus.Changed += OnShiftStatusChanged;
        _clockTimer = new Timer(_ =>
        {
            if (_isDisposed)
            {
                return;
            }

            _now = DateTime.Now;
            _ = InvokeAsync(() =>
            {
                if (!_isDisposed)
                {
                    StateHasChanged();
                }
            });
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(30));

        try
        {
            await Task.WhenAll(
                LoadProductsAsync(),
                LoadMastersAsync(),
                LoadQuickLinksAsync(),
                LoadCustomersAsync(),
                ShiftStatus.RefreshAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sales terminal failed to load catalog/session data.");
            _errorMessage = "Could not load sales data. Check API connection and Reload.";
        }

        AssignDraftInvoiceNo();

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("orders=1", StringComparison.OrdinalIgnoreCase)
            || uri.Query.Contains("purchases=1", StringComparison.OrdinalIgnoreCase))
        {
            _showPurchaseOrders = true;
        }

        if (uri.Query.Contains("createpo=1", StringComparison.OrdinalIgnoreCase))
        {
            OpenCreatePurchaseOrder();
        }

        try
        {
            await TryBindCustomerFromQueryAsync(uri);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to bind customer from query.");
        }
    }

    private async Task TryBindCustomerFromQueryAsync(Uri uri)
    {
        string? customerRaw = null;
        if (!string.IsNullOrEmpty(uri.Query))
        {
            foreach (string part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                string[] kv = part.Split('=', 2);
                if (kv.Length == 2
                    && string.Equals(Uri.UnescapeDataString(kv[0]), "customer", StringComparison.OrdinalIgnoreCase))
                {
                    customerRaw = Uri.UnescapeDataString(kv[1]);
                    break;
                }
            }
        }

        if (customerRaw is null || !Guid.TryParse(customerRaw, out Guid customerId) || customerId == Guid.Empty)
        {
            return;
        }

        if (_customers.Count == 0)
        {
            await LoadCustomersAsync();
        }

        PartyDto? customer = _customers.FirstOrDefault(c => c.Id == customerId);
        if (customer is not null)
        {
            BindCustomer(customer);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _scanFocus.RequestScan();
            }

            // Re-bind each render when ElementReference may have been replaced.
            try
            {
                await Js.InvokeVoidAsync("webPosPreventKeys", _scanInput, new[] { "Tab" });
            }
            catch
            {
                /* ignore until DOM ready */
            }

            (SalesScanFocusCoordinator.Target target, int? qtyRow) = _scanFocus.TakePending();
            if (target == SalesScanFocusCoordinator.Target.Qty && qtyRow is int row)
            {
                await FocusQtyAsync(row);
                return;
            }

            if (target == SalesScanFocusCoordinator.Target.Scan)
            {
                await FocusScanAsync();
            }
        }
        catch (Exception ex)
        {
            // Never let focus/JS failures become the yellow Blazor error bar.
            Logger.LogDebug(ex, "SalesTerminal OnAfterRenderAsync ignored failure.");
        }
    }

    private async Task FocusQtyAsync(int row)
    {
        if (row < 0 || row >= CartService.Lines.Count)
        {
            await RequestScanFocusAsync();
            return;
        }

        _selectedLineIndex = row;
        try
        {
            // Prefer DOM id over ElementReference[] — array @ref capture during render
            // was throwing IndexOutOfRangeException → yellow "unhandled error" bar.
            await Js.InvokeVoidAsync("webPosFocusById", $"pos-qty-{row}");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Qty focus failed; falling back to scan.");
            try { await FocusScanAsync(); }
            catch { /* ignore */ }
        }
    }

    private Task RequestQtyFocusAsync(int row)
    {
        // Always resolve through coordinator so TAB targets the latest row.
        _scanFocus.RequestLatestQty(CartService.Lines.Count);
        if (row >= 0 && row < CartService.Lines.Count)
        {
            _selectedLineIndex = row;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task RequestScanFocusAsync()
    {
        _scanFocus.RequestScan();
        return InvokeAsync(StateHasChanged);
    }

