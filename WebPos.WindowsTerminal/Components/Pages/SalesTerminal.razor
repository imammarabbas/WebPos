    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        CartService.Changed += OnCartChanged;
        ShiftStatus.Changed += OnShiftStatusChanged;
        BarcodeScanner.OnBarcodeScanned += OnGlobalBarcodeScannedAsync;
        _clockTimer = new Timer(_ =>
        {
            if (_isDisposed)
            {
                return;
            }

            _now = DateTime.Now;
            _ = InvokeAsync(() =>
            {
                if (!_isDisposed)
                {
                    StateHasChanged();
                }
            });
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));

        try
        {
            await Task.WhenAll(
                LoadProductsAsync(),
                LoadMastersAsync(),
                LoadQuickLinksAsync(),
                LoadCustomersAsync(),
                LoadPaymentAccountsAsync(),
                ShiftStatus.RefreshAsync());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sales terminal failed to load catalog/session data.");
            _errorMessage = "Could not load sales data. Check API connection and Reload.";
        }

        AssignDraftInvoiceNo();
        RestorePosUiState();

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("orders=1", StringComparison.OrdinalIgnoreCase)
            || uri.Query.Contains("purchases=1", StringComparison.OrdinalIgnoreCase))
        {
            _showPurchaseOrders = true;
        }

        if (uri.Query.Contains("createpo=1", StringComparison.OrdinalIgnoreCase))
        {
            _createPoSupplierId = TryParseGuidQuery(uri, "supplierId");
            OpenCreatePurchaseOrder();
        }

        try
        {
            await TryBindCustomerFromQueryAsync(uri);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to bind customer from query.");
        }
    }

    private async Task TryBindCustomerFromQueryAsync(Uri uri)
    {
        string? customerRaw = null;
        if (!string.IsNullOrEmpty(uri.Query))
        {
            foreach (string part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                string[] kv = part.Split('=', 2);
                if (kv.Length == 2
                    && string.Equals(Uri.UnescapeDataString(kv[0]), "customer", StringComparison.OrdinalIgnoreCase))
                {
                    customerRaw = Uri.UnescapeDataString(kv[1]);
                    break;
                }
            }
        }

        if (customerRaw is null || !Guid.TryParse(customerRaw, out Guid customerId) || customerId == Guid.Empty)
        {
            return;
        }

        if (_customers.Count == 0)
        {
            await LoadCustomersAsync();
        }

        PartyDto? customer = _customers.FirstOrDefault(c => c.Id == customerId);
        if (customer is null)
        {
            return;
        }

        BindCustomer(customer);
    }

    private static Guid? TryParseGuidQuery(Uri uri, string key)
    {
        if (string.IsNullOrEmpty(uri.Query))
        {
            return null;
        }

        foreach (string part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] kv = part.Split('=', 2);
            if (kv.Length == 2
                && string.Equals(Uri.UnescapeDataString(kv[0]), key, StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(kv[1]), out Guid id)
                && id != Guid.Empty)
            {
                return id;
            }
        }

        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                try
                {
                    await Js.InvokeVoidAsync("webPosBindPosShortcuts");
                    await Js.InvokeVoidAsync("webPosBindCellKeys");
                }
                catch
                {
                    /* ignore until DOM ready */
                }

                bool initialSessionFocus = false;
                try
                {
                    initialSessionFocus = await Js.InvokeAsync<bool>("webPosConsumeInitialScanFocus");
                }
                catch
                {
                    initialSessionFocus = !_restoreUiPending;
                }

                if (_restoreUiPending)
                {
                    _restoreUiPending = false;
                    if (!ModalOpen)
                    {
                        await RestorePosUiFocusAsync();
                    }
                }
                else if (initialSessionFocus)
                {
                    _scanFocus.RequestScan();
                }
            }

            if (!_tableWatchBound)
            {
                try
                {
                    _selfRef ??= DotNetObjectReference.Create(this);
                    await Js.InvokeVoidAsync("webPosWatchTableRows", _tableScroll, _selfRef);
                    _tableWatchBound = true;
                }
                catch
                {
                    /* retry on the next render */
                }
            }

            // Re-bind each render when ElementReference may have been replaced.
            try
            {
                await Js.InvokeVoidAsync("webPosPreventKeys", _scanInput, new[] { "Tab" });
            }
            catch
            {
                /* ignore until DOM ready */
            }

            if (_pendingFlashLineId is Guid flashId)
            {
                _pendingFlashLineId = null;
                try
                {
                    await Js.InvokeVoidAsync("webPosFlashLine", flashId.ToString());
                }
                catch
                {
                    /* ignore until DOM ready */
                }
            }

            (SalesScanFocusCoordinator.Target target, int? qtyRow, string? field) = _scanFocus.TakePending();
            if (target == SalesScanFocusCoordinator.Target.Qty && qtyRow is int row)
            {
                await FocusTableCellAsync(row, string.IsNullOrWhiteSpace(field) ? "qty" : field);
                return;
            }

            if (target == SalesScanFocusCoordinator.Target.Scan)
            {
                await FocusScanAsync();
            }

            await PublishCfdSnapshotAsync();
        }
        catch (Exception ex)
        {
            // Never let focus/JS failures become the yellow Blazor error bar.
            Logger.LogDebug(ex, "SalesTerminal OnAfterRenderAsync ignored failure.");
        }
    }

    private async Task FocusTableCellAsync(int row, string field)
    {
        if (row < 0 || row >= CartService.Lines.Count)
        {
            await RequestScanFocusAsync();
            return;
        }

        CartLine line = CartService.Lines[row];
        _selectedLineIndex = row;
        _focusedField = field;
        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", CellId(line.LineId, field));
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Cell focus failed; falling back to scan.");
            try { await FocusScanAsync(); }
            catch { /* ignore */ }
        }
    }

    private Task RequestQtyFocusAsync(int row)
    {
        _scanFocus.RequestCell(row, "qty");
        if (row >= 0 && row < CartService.Lines.Count)
        {
            _selectedLineIndex = row;
        }

        return InvokeAsync(StateHasChanged);
    }

