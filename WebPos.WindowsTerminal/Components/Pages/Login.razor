@page "/"
@page "/login"
@using Common.Models
@using WebPos.Client.Sdk
@implements IDisposable
@inject LoginApiClient LoginApi
@inject NavigationManager Navigation
@inject TerminalOptions TerminalOptions
@inject SecureEnrollmentCertificateStore CertificateStore
@inject ShiftStatusApiClient ShiftStatus
@inject ISessionService SessionService
@inject IJSRuntime Js

<PageTitle>Staff Login</PageTitle>

<div class="auth-shell">
    <aside class="login-rail" aria-label="Terminal status">
        <div class="login-rail-stats">
            <div class="login-stat">
                <span>Drawer</span>
                <strong>Rs @FormatRs(ShiftStatus.ExpectedCashPaisa)</strong>
            </div>
            <div class="login-stat">
                <span>Shift</span>
                <strong>@(SessionService.IsActive ? $"OPEN · {ShiftLabel}" : "—")</strong>
            </div>
            <div class="login-stat">
                <span>Terminal</span>
                <strong class="@(_terminalOnline ? "online" : "offline")">
                    @(_terminalOnline ? "Online" : "Offline")
                </strong>
            </div>
        </div>

        <div class="login-rail-spacer"></div>

        <div class="login-rail-user">
            <span class="login-avatar" aria-hidden="true">PIN</span>
            <div class="login-lock-wrap">
                <button type="button" class="login-lock-btn" @onclick="OnLock" disabled="@_isBusy">Lock</button>
                <span class="login-lock-hint">Keeps shift open</span>
            </div>
            <span class="login-loc">Chakwal</span>
        </div>
    </aside>

    <section class="auth-card" aria-labelledby="loginTitle">
        <header class="auth-brand">
            <span class="auth-logo" aria-hidden="true"></span>
            <div class="auth-brand-text">
                <strong>Smart POS</strong>
                <span>Cone Mart · Staff</span>
            </div>
        </header>

        <div class="auth-heading">
            <h1 id="loginTitle">Enter PIN</h1>
            <p>4-digit staff code</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="auth-alert" role="alert">@_errorMessage</div>
        }

        <form class="auth-form" @onsubmit="LoginAsync" @onsubmit:preventDefault>
            <div class="pin-dots" aria-live="polite" aria-label="PIN length @_pin.Length of @PinLength">
                @for (int i = 0; i < PinLength; i++)
                {
                    <span class="pin-dot @(i < _pin.Length ? "filled" : null)"></span>
                }
            </div>

            <input id="pin"
                   class="pin-sr-only"
                   type="password"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   maxlength="@PinLength"
                   autocomplete="off"
                   tabindex="0"
                   aria-hidden="true"
                   aria-label="4-digit PIN"
                   value="@_pin"
                   readonly
                   disabled="@_isBusy" />

            <div class="keypad" aria-label="Numeric keypad">
                @foreach (string digit in Digits)
                {
                    <button type="button"
                            class="key @KeyPressedClass(digit)"
                            data-pin-key="@digit"
                            @onclick="() => AppendDigit(digit)"
                            disabled="@_isBusy">@digit</button>
                }
                <button type="button"
                        class="key key-muted @KeyPressedClass("clear")"
                        data-pin-key="clear"
                        @onclick="Clear"
                        disabled="@_isBusy">Clear</button>
                <button type="button"
                        class="key @KeyPressedClass("0")"
                        data-pin-key="0"
                        @onclick="AppendZero"
                        disabled="@_isBusy">0</button>
                <button type="button"
                        class="key key-muted @KeyPressedClass("backspace")"
                        data-pin-key="backspace"
                        @onclick="Backspace"
                        disabled="@_isBusy"
                        aria-label="Backspace">⌫</button>
            </div>

            <button class="auth-submit @KeyPressedClass("enter")"
                    type="submit"
                    data-pin-key="enter"
                    disabled="@(_isBusy || _pin.Length < PinLength)">
                @(_isBusy ? "Signing in…" : "Login")
            </button>
        </form>
    </section>
</div>

@code {
    private const int PinLength = 4;
    private static readonly string[] Digits = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];

    private string _pin = string.Empty;
    private string? _errorMessage;
    private bool _isBusy;
    private bool _terminalOnline;
    private string? _pressedKey;
    private CancellationTokenSource? _pressCts;
    private DotNetObjectReference<Login>? _selfRef;

    private string ShiftLabel =>
        SessionService.OpenedAt is DateTimeOffset opened
            ? opened.ToLocalTime().ToString("HH:mm")
            : "—";

    protected override async Task OnInitializedAsync()
    {
        LoginApi.ClearCashier();
        _pin = string.Empty;
        _errorMessage = null;
        ShiftStatus.Changed += OnShiftStatusChanged;

        if (!CertificateStore.IsEnrolled || !TerminalOptions.IsEnrolled)
        {
            Navigation.NavigateTo("/enroll");
            return;
        }

        await RefreshTerminalStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("webPosBindPinPad", _selfRef);
            await Js.InvokeVoidAsync("webPosAllowNextScanFocus");
        }
        catch
        {
            /* PIN pad keys still work after a refresh once JS is ready */
        }
    }

    public void Dispose()
    {
        ShiftStatus.Changed -= OnShiftStatusChanged;
        _pressCts?.Cancel();
        _pressCts?.Dispose();
        try
        {
            _ = Js.InvokeVoidAsync("webPosUnbindPinPad");
        }
        catch
        {
        }

        _selfRef?.Dispose();
    }

    private void OnShiftStatusChanged() => InvokeAsync(StateHasChanged);

    private string? KeyPressedClass(string key) =>
        string.Equals(_pressedKey, key, StringComparison.Ordinal) ? "is-pressed active" : null;

    private async Task ClearPulseAsync(string key)
    {
        CancellationTokenSource cts = new();
        _pressCts?.Cancel();
        _pressCts?.Dispose();
        _pressCts = cts;
        try
        {
            await Task.Delay(150, cts.Token);
            if (string.Equals(_pressedKey, key, StringComparison.Ordinal))
            {
                _pressedKey = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    [JSInvokable]
    public async Task OnPhysicalPinKey(string key)
    {
        if (string.IsNullOrEmpty(key) || _isBusy)
        {
            return;
        }

        _pressedKey = key;
        _ = ClearPulseAsync(key);

        switch (key)
        {
            case "backspace":
                Backspace();
                break;
            case "clear":
                Clear();
                break;
            case "enter":
                await LoginAsync();
                break;
            default:
                if (key.Length == 1 && char.IsDigit(key[0]))
                {
                    await AppendDigit(key);
                }

                break;
        }
    }

    private async Task RefreshTerminalStatusAsync()
    {
        try
        {
            using CancellationTokenSource cts = new(TimeSpan.FromSeconds(8));
            await ShiftStatus.RefreshAsync(cts.Token);
            _terminalOnline = ShiftStatus.IsApiOnline;
        }
        catch
        {
            _terminalOnline = false;
        }
    }

    private async Task AppendDigit(string digit)
    {
        if (_pin.Length < PinLength)
        {
            _pin += digit;
            _errorMessage = null;
            await TryAutoSubmitAsync();
        }
    }

    private void Clear()
    {
        _pin = string.Empty;
        _errorMessage = null;
    }

    private Task AppendZero() => AppendDigit("0");

    private void Backspace()
    {
        if (_pin.Length > 0)
        {
            _pin = _pin[..^1];
        }
    }

    private async Task TryAutoSubmitAsync()
    {
        if (_pin.Length != PinLength || _isBusy)
        {
            return;
        }

        await LoginAsync();
    }

    private async Task LoginAsync()
    {
        if (_isBusy || _pin.Length < PinLength)
        {
            return;
        }

        _errorMessage = null;
        _isBusy = true;
        string pin = _pin;
        _pin = string.Empty;
        try
        {
            if (!_terminalOnline)
            {
                using CancellationTokenSource probeCts = new(TimeSpan.FromSeconds(5));
                await ShiftStatus.ProbeApiReachableAsync(probeCts.Token);
                _terminalOnline = ShiftStatus.IsApiOnline;
                if (!_terminalOnline)
                {
                    _errorMessage =
                        $"Cannot reach API at {ShiftStatus.ApiBaseAddress}. Start WebPos on port 8080, then try again.";
                    return;
                }
            }

            Result<CashierDto> result = await LoginApi.LoginAsync(pin);

            if (!result.Success)
            {
                _errorMessage = FormatLoginError(result.ErrorMessage);
                _ = RefreshTerminalStatusAsync();
                return;
            }

            Navigation.NavigateTo("/start-shift");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string FormatLoginError(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "Login failed.";
        }

        if (raw.Contains("timed out", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("Failed to reach", StringComparison.OrdinalIgnoreCase)
            || raw.Contains("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return $"Cannot reach API at {ShiftStatus.ApiBaseAddress}. Check that WebPos is running (http://localhost:8080).";
        }

        return raw;
    }

    private async Task OnLock()
    {
        LoginApi.ClearCashier();
        if (SessionService.IsActive)
        {
            SessionService.ClearSession();
        }

        await ShiftStatus.RefreshAsync();
        _pin = string.Empty;
        _errorMessage = null;
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2");
}
