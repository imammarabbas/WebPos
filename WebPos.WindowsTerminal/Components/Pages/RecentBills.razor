    private async Task DownloadPdfAsync()
    {
        if (_ledgerCustomer is null || _ledgerEntries.Count == 0)
        {
            return;
        }

        _sharing = true;
        _error = null;
        try
        {
            IReadOnlyDictionary<string, SalesInvoiceDetailDto>? details = await EnsureDetailsForShareAsync();
            byte[] pdf = LedgerPdf.GenerateStatement(
                _ledgerCustomer, _ledgerEntries, _fromDate, _toDate,
                _openingBalancePaisa, _closingBalancePaisa, details);
            string name = $"Customer_{Sanitize(_ledgerCustomer.Name)}_{_fromDate:yyyyMMdd}_{_toDate:yyyyMMdd}.pdf";
            string? path = await StatementFiles.SavePdfAsync(pdf, name);
            if (path is not null)
            {
                _error = null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sharing = false;
        }
    }

    private async Task EmailPdfAsync()
    {
        if (_ledgerCustomer is null || string.IsNullOrWhiteSpace(_ledgerCustomer.Email))
        {
            _error = "Customer has no email on file.";
            return;
        }

        if (!EmailService.IsConfigured)
        {
            _error = "Email is not configured. Set Smtp:Enabled and Host/From in appsettings.json.";
            return;
        }

        _sharing = true;
        _error = null;
        try
        {
            IReadOnlyDictionary<string, SalesInvoiceDetailDto>? details = await EnsureDetailsForShareAsync();
            byte[] pdf = LedgerPdf.GenerateStatement(
                _ledgerCustomer, _ledgerEntries, _fromDate, _toDate,
                _openingBalancePaisa, _closingBalancePaisa, details);
            string name = $"Customer_{Sanitize(_ledgerCustomer.Name)}_{_fromDate:yyyyMMdd}.pdf";
            await EmailService.SendAsync(
                _ledgerCustomer.Email!,
                $"{TerminalBranding.PosDisplayName} — Customer statement",
                $"Please find attached the statement for {_ledgerCustomer.Name} ({_fromDate:dd/MM/yyyy} – {_toDate:dd/MM/yyyy}).",
                pdf,
                name);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sharing = false;
        }
    }

    private static string Sanitize(string name)
    {
        char[] invalid = Path.GetInvalidFileNameChars();
        return new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray());
    }

    private async Task ConfirmWhatsAppAsync()
    {
        if (_waMode == WaMode.Ledger)
        {
            await OpenWhatsAppLedgerAsync(_waPhone);
            return;
        }

        if (_pendingDetail is null)
        {
            return;
        }

        await OpenWhatsAppReceiptAsync(_waPhone, _pendingDetail);
    }

    private async Task PrintDetailAsync(SalesInvoiceDetailDto detail)
    {
        string message = BuildReceiptText(detail);
        try
        {
            await Js.InvokeVoidAsync("webPosPrintReceipt", message);
        }
        catch
        {
            _error = "Could not print receipt.";
        }
    }

    private async Task OpenWhatsAppReceiptAsync(string phone, SalesInvoiceDetailDto detail)
    {
        string message = BuildReceiptText(detail);
        string? url = WhatsAppReceipt.BuildWhatsAppUrl(phone, message);
        if (url is null)
        {
            _waError = "Enter a valid mobile number.";
            _showPhonePrompt = true;
            return;
        }

        _showPhonePrompt = false;
        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch
        {
            _error = "Could not open WhatsApp.";
        }
    }

    private async Task OpenWhatsAppLedgerAsync(string phone)
    {
        if (_ledgerCustomer is null)
        {
            return;
        }

        IReadOnlyDictionary<string, SalesInvoiceDetailDto>? details = await EnsureDetailsForShareAsync();
        string message = WhatsAppReceipt.BuildLedgerMessage(
            _ledgerCustomer.Name,
            _fromDate,
            _toDate,
            _openingBalancePaisa,
            _closingBalancePaisa,
            _ledgerEntries,
            "CUSTOMER",
            details);

        string? url = WhatsAppReceipt.BuildWhatsAppUrl(phone, message);
        if (url is null)
        {
            _waError = "Enter a valid mobile number.";
            _showPhonePrompt = true;
            return;
        }

        _showPhonePrompt = false;
        try
        {
            await Browser.Default.OpenAsync(url, BrowserLaunchMode.SystemPreferred);
        }
        catch
        {
            _error = "Could not open WhatsApp.";
        }
    }

    private string BuildReceiptText(SalesInvoiceDetailDto detail)
    {
        List<CartLine> lines = detail.Lines.Select(line => new CartLine
        {
            Product = new SalesProductDto
            {
                ProductId = line.ProductId,
                BatchId = line.BatchId ?? Guid.Empty,
                BatchNumber = line.BatchNumber,
                Name = line.ProductName,
                Sku = string.Empty,
                Barcode = string.Empty,
                ShortCode = string.Empty,
                CategoryName = string.Empty,
                UnitPricePaisa = line.UnitPricePaisa,
                AvailableStock = line.ReturnableQuantity
            },
            Quantity = line.QuantitySold
        }).ToList();

        CompleteSaleResult sale = new()
        {
            InvoiceNo = detail.InvoiceNo,
            ReceiptNumber = detail.ReceiptNumber,
            TotalAmountPaisa = detail.TotalAmountPaisa,
            GrossAmountPaisa = detail.GrossAmountPaisa,
            DiscountAmountPaisa = detail.DiscountAmountPaisa,
            TransactionGroupId = Guid.Empty
        };

        return WhatsAppReceipt.BuildReceiptMessage(sale, lines, detail.PaymentMethod);
    }

    private static string DescribeEntry(PartyLedgerEntryDto entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.ReferenceDetails))
        {
            return entry.ReferenceDetails;
        }

        if (!string.IsNullOrWhiteSpace(entry.Type))
        {
            return entry.Type;
        }

        return entry.PaymentMethod;
    }

    private static DateTimeOffset StartOfLocalDay(DateOnly date) =>
        new(date.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local));

    private static DateTimeOffset EndOfLocalDay(DateOnly date) =>
        new(date.ToDateTime(new TimeOnly(23, 59, 59), DateTimeKind.Local));

    private static string ShortId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        return value.Length <= 10 ? value : value[^10..];
    }

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");
