@using Common.Models
@using System.Globalization
@using WebPos.WindowsTerminal.Services

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="sf-modal sf-customer-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="sf-modal-head">
                <h2>Search Customer · F4</h2>
                <button type="button" class="link-btn" @onclick="Close">Close</button>
            </div>
            <input class="scan-input"
                   type="search"
                   placeholder="Name or phone…"
                   @ref="_input"
                   @bind="_query"
                   @bind:event="oninput"
                   @bind:after="OnQueryChanged"
                   @onkeydown="OnKeyDown"
                   autocomplete="off" />
            <ul class="sf-search-list" role="listbox">
                @if (IncludeWalkIn)
                {
                    <li class="@(_highlight == 0 ? "active" : null) sf-walkin-option"
                        role="option"
                        @onclick="ChooseWalkInAsync">
                        <strong>Walk-In Customer</strong>
                        <span>No account · cash / online only</span>
                    </li>
                }
                @foreach ((PartyDto customer, int i) in Hits.Select((c, i) => (c, i)))
                {
                    int row = IncludeWalkIn ? i + 1 : i;
                    <li class="@(row == _highlight ? "active" : null)"
                        role="option"
                        @onclick="() => ChooseAsync(customer)">
                        <strong>@customer.Name</strong>
                        <span>@customer.PhoneNumber · Bal Rs @FormatRs(customer.CurrentBalancePaisa)</span>
                    </li>
                }
            </ul>
            @if (Hits.Count == 0 && !IncludeWalkIn)
            {
                <p class="muted">No customers match.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public IReadOnlyList<PartyDto> Customers { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PartyDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnWalkInSelected { get; set; }

    private ElementReference _input;
    private string _query = string.Empty;
    private int _highlight;
    private bool _wasVisible;

    private bool IncludeWalkIn => CustomerSearchRows.IncludeWalkIn(_query);

    private IReadOnlyList<PartyDto> Hits =>
        CustomerApiClient.FilterCustomers(Customers, _query).Take(40).ToList();

    private int TotalRows => CustomerSearchRows.TotalRows(Hits.Count, IncludeWalkIn);

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_wasVisible)
        {
            _query = string.Empty;
            _highlight = 0;
        }

        _wasVisible = Visible;
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible)
        {
            try { await _input.FocusAsync(); } catch { /* ignore */ }
        }
    }

    private void OnQueryChanged()
    {
        // Keep the top visible row selected while typing or clearing.
        _highlight = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (TotalRows > 0)
            {
                _highlight = Math.Min(_highlight + 1, TotalRows - 1);
            }

            return;
        }

        if (e.Key == "ArrowUp")
        {
            _highlight = Math.Max(_highlight - 1, 0);
            return;
        }

        if (e.Key == "Enter")
        {
            var selection = CustomerSearchRows.ResolveEnter(
                _highlight,
                Hits.Count,
                IncludeWalkIn);
            if (selection is null)
            {
                return;
            }

            if (selection.Value.Kind == CustomerSearchRows.SelectionKind.WalkIn)
            {
                await ChooseWalkInAsync();
                return;
            }

            await ChooseAsync(Hits[selection.Value.HitIndex]);
        }
    }

    private async Task ChooseWalkInAsync() =>
        await OnWalkInSelected.InvokeAsync();

    private async Task ChooseAsync(PartyDto customer) =>
        await OnSelected.InvokeAsync(customer);

    private async Task Close() => await OnClose.InvokeAsync();

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);
}
