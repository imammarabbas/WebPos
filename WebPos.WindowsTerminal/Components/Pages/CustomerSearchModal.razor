@using Common.Models
@using System.Globalization
@using WebPos.WindowsTerminal.Services
@inject IJSRuntime Js

@if (Visible)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div @ref="_panel"
             class="sf-modal sf-customer-modal"
             role="dialog"
             aria-modal="true"
             aria-label="Search customer"
             tabindex="0"
             @onclick:stopPropagation="true"
             @onkeydown="OnKeyDown"
             @onkeydown:preventDefault="true"
             @onkeydown:stopPropagation="true">
            <div class="sf-customer-query" aria-live="polite">
                @if (string.IsNullOrEmpty(_query))
                {
                    <span class="sf-customer-query-hint">Type to search</span>
                }
                else
                {
                    <span class="sf-customer-query-text">@_query</span>
                }
            </div>
            @if (Hits.Count == 0 && !IncludeWalkIn)
            {
                <p class="muted sf-customer-nomatch">No matching customers</p>
            }
            else
            {
                <ul class="sf-search-list" role="listbox">
                    @if (IncludeWalkIn)
                    {
                        <li class="@(_highlight == 0 ? "is-selected" : null) sf-walkin-option"
                            role="option"
                            @onclick="ChooseWalkInAsync">
                            <strong>Walk-In Customer</strong>
                            <span>No account · cash / online only</span>
                        </li>
                    }
                    @foreach ((PartyDto customer, int i) in Hits.Select((c, i) => (c, i)))
                    {
                        int row = IncludeWalkIn ? i + 1 : i;
                        PartyDto selected = customer;
                        <li class="@(row == _highlight ? "is-selected" : null)"
                            role="option"
                            @onclick="() => ChooseAsync(selected)">
                            <strong>@customer.Name</strong>
                            <span>@customer.PhoneNumber · Bal Rs @FormatRs(customer.CurrentBalancePaisa)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public IReadOnlyList<PartyDto> Customers { get; set; } = [];
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PartyDto> OnSelected { get; set; }
    [Parameter] public EventCallback OnWalkInSelected { get; set; }

    private ElementReference _panel;
    private string _query = string.Empty;
    private int _highlight;
    private bool _wasVisible;
    private bool _busy;
    private bool _focusPanelPending;

    private bool IncludeWalkIn => CustomerSearchRows.IncludeWalkIn(_query);

    private IReadOnlyList<PartyDto> Hits =>
        CustomerApiClient.FilterCustomers(Customers, _query).Take(40).ToList();

    private int TotalRows => CustomerSearchRows.TotalRows(Hits.Count, IncludeWalkIn);

    protected override void OnParametersSet()
    {
        if (Visible && !_wasVisible)
        {
            _query = string.Empty;
            _busy = false;
            ApplyQueryChange();
            _focusPanelPending = true;
        }

        _wasVisible = Visible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanelPending || !Visible)
        {
            return;
        }

        _focusPanelPending = false;
        try
        {
            await _panel.FocusAsync();
        }
        catch
        {
            /* ignore until element is ready */
        }
    }

    private void ApplyQueryChange() =>
        _highlight = TotalRows > 0 ? 0 : -1;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (_busy || !Visible)
        {
            return;
        }

        if (e.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (TotalRows > 0)
            {
                _highlight = Math.Min(Math.Max(_highlight, 0) + 1, TotalRows - 1);
            }

            return;
        }

        if (e.Key == "ArrowUp")
        {
            if (TotalRows > 0)
            {
                _highlight = Math.Max(_highlight - 1, 0);
            }

            return;
        }

        if (e.Key == "Home")
        {
            if (TotalRows > 0)
            {
                _highlight = 0;
            }

            return;
        }

        if (e.Key == "End")
        {
            if (TotalRows > 0)
            {
                _highlight = TotalRows - 1;
            }

            return;
        }

        if (e.Key == "Enter")
        {
            var selection = CustomerSearchRows.ResolveEnter(
                _highlight,
                Hits.Count,
                IncludeWalkIn);
            if (selection is null)
            {
                return;
            }

            if (selection.Value.Kind == CustomerSearchRows.SelectionKind.WalkIn)
            {
                await ChooseWalkInAsync();
                return;
            }

            await ChooseAsync(Hits[selection.Value.HitIndex]);
            return;
        }

        if (e.Key == "Backspace")
        {
            if (_query.Length > 0)
            {
                _query = _query[..^1];
                ApplyQueryChange();
            }

            return;
        }

        if (e.CtrlKey || e.AltKey || e.MetaKey)
        {
            return;
        }

        if (IsQueryChar(e))
        {
            _query += e.Key;
            ApplyQueryChange();
        }
    }

    private static bool IsQueryChar(KeyboardEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Key) || e.Key.Length != 1)
        {
            return false;
        }

        return !char.IsControl(e.Key[0]);
    }

    private async Task ChooseWalkInAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnWalkInSelected.InvokeAsync();
            await RestoreScannerFocusAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChooseAsync(PartyDto customer)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnSelected.InvokeAsync(customer);
            await RestoreScannerFocusAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_busy)
        {
            return;
        }

        await OnClose.InvokeAsync();
        await RestoreScannerFocusAsync();
    }

    private async Task RestoreScannerFocusAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("webPosFocusById", "scanInput");
        }
        catch
        {
            /* parent FocusScanAsync may also run */
        }
    }

    private static string FormatRs(long paisa) =>
        (paisa / 100m).ToString("N2", CultureInfo.InvariantCulture);
}
