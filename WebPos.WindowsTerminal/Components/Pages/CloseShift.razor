@page "/close-shift"
@using Common.Models
@using WebPos.Client.Sdk
@inject LoginApiClient Login
@inject ShiftApiClient ShiftApi
@inject IApiClient ApiClient
@inject ISessionService SessionService
@inject TerminalOptions TerminalOptions
@inject NavigationManager Navigation

<PageTitle>Close Shift</PageTitle>

<div class="terminal-shell">
    <section class="shift-card">
        <header>
            <span class="brand">WebPos</span>
            <h1>Close Shift</h1>
            @if (Login.CurrentCashier is not null)
            {
                <p>Cashier: <strong>@Login.CurrentCashier.Name</strong></p>
            }
        </header>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert-red" role="alert">@_errorMessage</div>
        }

        @if (_report is not null)
        {
            <section class="variance-panel" aria-live="polite">
                <h2>Cash reconciliation</h2>
                <dl>
                    <dt>Expected cash</dt>
                    <dd>Rs @FormatRs(_report.ExpectedCashPaisa)</dd>
                    <dt>Physical count</dt>
                    <dd>Rs @FormatRs(_report.PhysicalCountPaisa)</dd>
                    <dt>Difference</dt>
                    <dd class="@(_report.IsBalanced ? "ok" : "warn")">
                        Rs @FormatRs(_report.DiscrepancyPaisa)
                    </dd>
                    <dt>Registered (ledger)</dt>
                    <dd>Rs @FormatRs(_report.RegisteredLedgerPaisa)</dd>
                    <dt>Available</dt>
                    <dd>Rs @FormatRs(_report.AvailablePaisa)</dd>
                    <dt>Unreconciled Cash In</dt>
                    <dd>Rs @FormatRs(_report.UnreconciledCashInPaisa)</dd>
                    <dt>Unreconciled Cash Out</dt>
                    <dd>Rs @FormatRs(_report.UnreconciledCashOutPaisa)</dd>
                    <dt>Status</dt>
                    <dd class="@(_report.ReconciliationStatus == "MATCHED" ? "ok" : "warn")">
                        @_report.ReconciliationStatus
                    </dd>
                </dl>
                <button type="button" class="start-button" @onclick="GoLogin">
                    Done — back to login
                </button>
            </section>
        }
        else
        {
            <form @onsubmit="CloseShiftAsync" @onsubmit:preventDefault>
                <label for="actualCash">Blind cash count (Rs)</label>
                <input id="actualCash"
                       class="cash-input"
                       type="number"
                       inputmode="decimal"
                       min="0"
                       step="0.01"
                       autofocus
                       @bind="_actualCashText"
                       @bind:event="oninput"
                       disabled="@_isBusy" />

                @if (_open is not null)
                {
                    long physical = ParsePhysicalPaisa();
                    long difference = physical - _open.ExpectedCashPaisa;
                    string status = difference < 0
                        ? "SHORTAGE"
                        : difference > 0
                            ? "OVERAGE"
                            : (_open.UnreconciledCashInPaisa + _open.UnreconciledCashOutPaisa) > 0
                                ? "UNRECONCILED"
                                : "MATCHED";
                    <section class="variance-panel" style="margin-top:1rem;" aria-live="polite">
                        <h2>Preview</h2>
                        <dl>
                            <dt>Expected cash</dt>
                            <dd>Rs @FormatRs(_open.ExpectedCashPaisa)</dd>
                            <dt>Physical count</dt>
                            <dd>Rs @FormatRs(physical)</dd>
                            <dt>Difference</dt>
                            <dd>Rs @FormatRs(difference)</dd>
                            <dt>Registered (ledger)</dt>
                            <dd>Rs @FormatRs(_open.RegisteredLedgerPaisa)</dd>
                            <dt>Available</dt>
                            <dd>Rs @FormatRs(_open.AvailablePaisa)</dd>
                            <dt>Unreconciled Cash In</dt>
                            <dd>Rs @FormatRs(_open.UnreconciledCashInPaisa)</dd>
                            <dt>Unreconciled Cash Out</dt>
                            <dd>Rs @FormatRs(_open.UnreconciledCashOutPaisa)</dd>
                            <dt>Status</dt>
                            <dd>@status</dd>
                        </dl>
                        <p class="mm-muted" style="font-size:0.85rem;">
                            Expected cash is the system float. Physical count is your blind observation — it does not overwrite Expected.
                            Ledger vs Expected is not treated as shortage here.
                        </p>
                    </section>
                }

                <div class="terminal-id">
                    Shift: @(SessionService.IsActive ? SessionService.ShiftId.ToString() : "none")
                </div>

                <button type="submit"
                        class="start-button"
                        disabled="@(_isBusy || !SessionService.IsActive)">
                    @(_isBusy ? "Closing…" : "Close Shift")
                </button>
            </form>
        }
    </section>
</div>

@code {
    private string _actualCashText = "0.00";
    private string? _errorMessage;
    private bool _isBusy;
    private CashVarianceReport? _report;
    private OpenShiftDto? _open;

    protected override async Task OnInitializedAsync()
    {
        if (Login.CurrentCashier is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!SessionService.IsActive)
        {
            _errorMessage = "No open shift. Start a shift before closing.";
            return;
        }

        try
        {
            _open = await ApiClient.GetOpenShiftAsync(TerminalOptions.TerminalId);
        }
        catch
        {
            /* preview best-effort */
        }
    }

    private long ParsePhysicalPaisa()
    {
        if (!decimal.TryParse(_actualCashText, out decimal actualCash)
            || actualCash < 0
            || actualCash > long.MaxValue / 100m)
        {
            return 0;
        }

        return (long)Math.Round(actualCash * 100m, MidpointRounding.AwayFromZero);
    }

    private async Task CloseShiftAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        if (!decimal.TryParse(_actualCashText, out decimal actualCash)
            || actualCash < 0
            || actualCash > long.MaxValue / 100m)
        {
            _errorMessage = "Enter a valid non-negative cash count.";
            return;
        }

        _errorMessage = null;
        _isBusy = true;
        try
        {
            long actualCashPaisa =
                (long)Math.Round(actualCash * 100m, MidpointRounding.AwayFromZero);

            Result<CashVarianceReport> result = await ShiftApi.CloseShiftAsync(
                SessionService.ShiftId,
                SessionService.CashierId,
                SessionService.TerminalId,
                actualCashPaisa);

            if (!result.Success || result.Data is null)
            {
                _errorMessage = string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Could not close the shift."
                    : result.ErrorMessage;
                return;
            }

            _report = result.Data;
            SessionService.ClearSession();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoLogin() => Navigation.NavigateTo("/login");

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");
}
