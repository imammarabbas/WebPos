@page "/returns"
@using System.Globalization
@using Common.Models
@inject ISessionService SessionService
@inject InvoiceApiClient InvoiceApi
@inject ShiftStatusApiClient ShiftStatus
@inject NavigationManager Navigation

<PageTitle>Sales Return</PageTitle>

<div class="page-shell po-page po-detail">
    <PosTopMenu />

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="po-alert">@_error</div>
    }
    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="cpo-ok" role="status">@_success</div>
    }

    @if (_detail is null)
    {
        <div class="po-page-header">
            <div class="po-page-header-left">
                <div class="po-icon-tile" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7h16v12H4zM9 7V5h6v2" stroke-linecap="round" />
                        <path d="M9 14h6" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <h1>Sales Return</h1>
                    <p>Find a sale or open Return from Previous Sales</p>
                </div>
            </div>
            <div class="po-actions">
                <a class="po-btn po-btn-primary" href="recent-bills">Previous Sales</a>
                <a class="po-btn po-btn-outline" href="sales">Back to Sale</a>
            </div>
        </div>

        <div class="po-card">
            <h2>Find sale</h2>
            <EditForm Model="_search" OnValidSubmit="FindSaleAsync">
                <div class="po-filter-row" style="grid-template-columns:repeat(3,minmax(0,1fr)) auto;">
                    <div class="po-field">
                        <label for="invoiceSearch">Invoice / Sale ID</label>
                        <InputText id="invoiceSearch" class="form-control" @bind-Value="_search.Invoice" placeholder="e.g. INV-1021" />
                    </div>
                    <div class="po-field">
                        <label for="customerSearch">Customer</label>
                        <InputText id="customerSearch" class="form-control" @bind-Value="_search.Customer" placeholder="Name…" />
                    </div>
                    <div class="po-field">
                        <label for="productSearch">Product</label>
                        <InputText id="productSearch" class="form-control" @bind-Value="_search.Product" placeholder="Scan or type…" />
                    </div>
                    <div class="po-filter-actions">
                        <button type="submit" class="po-btn po-btn-primary" disabled="@_isLoading">Find</button>
                        <button type="button" class="po-btn po-btn-outline" disabled="@_isLoading" @onclick="LoadRecentSalesAsync">Recent</button>
                    </div>
                </div>
            </EditForm>
        </div>

        <div class="po-card" style="margin-top:1rem;">
            <h2>@(_showingSearchResults ? "Search results" : "Recent bills")</h2>
            @if (_isLoading)
            {
                <p class="po-empty">Loading…</p>
            }
            else if (_invoices.Count == 0)
            {
                <p class="po-empty">@(_showingSearchResults ? "No matching sales found." : "No bills yet — start from Previous Sales.")</p>
            }
            else
            {
                <div class="po-table-wrap">
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th class="po-num">Items</th>
                                <th class="po-num">Total</th>
                                <th>Payment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (SalesInvoiceSummaryDto bill in _invoices)
                            {
                                <tr>
                                    <td><strong>@ShortId(bill.InvoiceNo)</strong></td>
                                    <td>@bill.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="po-num">@bill.ItemCount</td>
                                    <td class="po-num">@FormatRs(bill.TotalAmountPaisa)</td>
                                    <td>@PaymentLabel(bill.PaymentMethod)</td>
                                    <td>
                                        <button type="button" class="po-btn po-btn-sm po-btn-primary" @onclick="() => OpenInvoiceAsync(bill.InvoiceNo)">Return</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="po-page-header">
            <div class="po-page-header-left">
                <div class="po-icon-tile" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7h16v12H4zM9 7V5h6v2" stroke-linecap="round" />
                        <path d="M9 14h6" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <h1>Sales Return</h1>
                    <p>Return products from original sale #@ShortId(_detail.InvoiceNo)</p>
                </div>
            </div>
            <div class="po-actions">
                <button type="button" class="po-btn po-btn-outline" @onclick="ClearDetailAsync">Change sale</button>
                <a class="po-btn po-btn-outline" href="recent-bills">Previous Sales</a>
            </div>
        </div>

        <div class="po-card">
            <h2>Original sale</h2>
            <div class="pov-info-grid">
                <div class="pov-info-item"><label>Invoice</label><div class="pov-value">@_detail.InvoiceNo</div></div>
                <div class="pov-info-item"><label>Sold</label><div class="pov-value">@_detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                <div class="pov-info-item"><label>Customer</label><div class="pov-value">@(string.IsNullOrWhiteSpace(_detail.CustomerName) ? "Walk-in" : _detail.CustomerName)</div></div>
                <div class="pov-info-item"><label>Payment</label><div class="pov-value">@PaymentLabel(_detail.PaymentMethod)</div></div>
                <div class="pov-info-item"><label>Original total</label><div class="pov-value">Rs @FormatRs(_detail.TotalAmountPaisa)</div></div>
            </div>
            <div class="pov-footer-actions">
                <button type="button" class="po-btn po-btn-outline" @onclick="ApplyFullReturn">Return Entire Sale</button>
            </div>
        </div>

        <div class="po-card">
            <h2>Return items (@ActiveReturnLineCount selected)</h2>
            @if (_lines.Count == 0)
            {
                <p class="po-empty">Nothing left to return on this invoice.</p>
            }
            else
            {
                <div class="po-table-wrap">
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="po-num">Max</th>
                                <th class="po-num">Price</th>
                                <th class="po-num">Return Qty</th>
                                <th class="po-num">Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ReturnLineEdit line in _lines)
                            {
                                <tr>
                                    <td><strong>@line.ProductName</strong></td>
                                    <td class="po-num">@line.ReturnableQuantity.ToString("0.##")</td>
                                    <td class="po-num">@FormatRs(line.UnitPricePaisa)</td>
                                    <td class="po-num">
                                        <div class="po-actions" style="justify-content:flex-end;">
                                            <button type="button" class="po-btn po-btn-sm" disabled="@(line.ReturnQuantity <= 0 || _isBusy)" @onclick="() => AdjustQty(line, -Step(line))">−</button>
                                            @if (line.IsLoose)
                                            {
                                                <input class="form-control" style="width:4.5rem;text-align:right;"
                                                       type="number" step="0.01" min="0"
                                                       max="@line.ReturnableQuantity.ToString(CultureInfo.InvariantCulture)"
                                                       value="@line.ReturnQtyText"
                                                       @oninput="e => OnQtyInput(line, e.Value?.ToString())" />
                                            }
                                            else
                                            {
                                                <span style="min-width:2rem;text-align:center;">@line.ReturnQuantity.ToString("0.##")</span>
                                            }
                                            <button type="button" class="po-btn po-btn-sm" disabled="@(line.ReturnQuantity >= line.ReturnableQuantity || _isBusy)" @onclick="() => AdjustQty(line, Step(line))">+</button>
                                        </div>
                                    </td>
                                    <td class="po-num">@FormatRs(line.LineGrossPaisa)</td>
                                    <td>
                                        <button type="button" class="po-btn po-btn-sm" disabled="@_isBusy" @onclick="() => ClearLine(line)">Clear</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pov-totals" style="margin-top:1rem;">
                    <div class="pov-totals-row"><span>Subtotal</span><span>Rs @FormatRs(RefundGrossPaisa)</span></div>
                    @if (RefundDiscountPaisa > 0)
                    {
                        <div class="pov-totals-row"><span>Discount</span><span>− Rs @FormatRs(RefundDiscountPaisa)</span></div>
                    }
                    <div class="pov-totals-row grand"><span>Total refund</span><span>Rs @FormatRs(RefundNetPaisa)</span></div>
                </div>

                <div class="pov-footer-actions">
                    <button type="button" class="po-btn po-btn-primary" disabled="@(_isBusy || ActiveReturnLineCount == 0)" @onclick="SubmitReturnAsync">
                        @(_isBusy ? "Processing…" : "Confirm return")
                    </button>
                    <button type="button" class="po-btn" @onclick="ClearDetailAsync">Back</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "invoice")]
    public string? InvoiceQuery { get; set; }

    private sealed class SearchModel
    {
        public string Invoice { get; set; } = string.Empty;
        public string Customer { get; set; } = string.Empty;
        public string Product { get; set; } = string.Empty;
    }

    private sealed class ReturnLineEdit
    {
        public Guid ProductId { get; init; }
        public Guid? BatchId { get; init; }
        public required string ProductName { get; init; }
        public bool IsLoose { get; init; }
        public decimal QuantitySold { get; init; }
        public decimal ReturnableQuantity { get; init; }
        public long UnitPricePaisa { get; init; }
        public string ReturnQtyText { get; set; } = "0";

        public decimal ReturnQuantity
        {
            get
            {
                if (decimal.TryParse(ReturnQtyText, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal qty)
                    || decimal.TryParse(ReturnQtyText, NumberStyles.Number, CultureInfo.CurrentCulture, out qty))
                {
                    return qty;
                }

                return 0m;
            }
        }

        public long LineGrossPaisa =>
            (long)Math.Round(ReturnQuantity * UnitPricePaisa, MidpointRounding.AwayFromZero);
    }

    private readonly SearchModel _search = new();
    private IReadOnlyList<SalesInvoiceSummaryDto> _invoices = [];
    private SalesInvoiceDetailDto? _detail;
    private List<ReturnLineEdit> _lines = [];
    private string? _error;
    private string? _success;
    private bool _isBusy;
    private bool _isLoading;
    private bool _showingSearchResults;

    private int ActiveReturnLineCount => _lines.Count(line => line.ReturnQuantity > 0);

    private long RefundGrossPaisa => _lines.Sum(line => line.LineGrossPaisa);

    private long OriginalGrossPaisa =>
        _detail?.Lines.Sum(line =>
            (long)Math.Round(line.QuantitySold * line.UnitPricePaisa, MidpointRounding.AwayFromZero)) ?? 0L;

    private long RefundDiscountPaisa
    {
        get
        {
            if (_detail is null || OriginalGrossPaisa <= 0 || RefundGrossPaisa <= 0)
            {
                return 0;
            }

            return (long)Math.Round(
                (decimal)_detail.DiscountAmountPaisa * RefundGrossPaisa / OriginalGrossPaisa,
                MidpointRounding.AwayFromZero);
        }
    }

    private long RefundTaxPaisa
    {
        get
        {
            if (_detail is null || _detail.TaxAmountPaisa <= 0 || OriginalGrossPaisa <= 0 || RefundGrossPaisa <= 0)
            {
                return 0;
            }

            return (long)Math.Round(
                (decimal)_detail.TaxAmountPaisa * RefundGrossPaisa / OriginalGrossPaisa,
                MidpointRounding.AwayFromZero);
        }
    }

    // Matches SalesReturnService: net = gross − proportional discount (tax not posted separately today).
    private long RefundNetPaisa => Math.Max(0, RefundGrossPaisa - RefundDiscountPaisa);

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsActive)
        {
            Navigation.NavigateTo("/start-shift");
            return;
        }

        await LoadRecentSalesAsync();

        if (!string.IsNullOrWhiteSpace(InvoiceQuery))
        {
            await OpenInvoiceAsync(InvoiceQuery);
        }
    }

    private async Task LoadRecentSalesAsync()
    {
        _error = null;
        _showingSearchResults = false;
        _isLoading = true;
        try
        {
            Result<IReadOnlyList<SalesInvoiceSummaryDto>> list =
                await InvoiceApi.ListRecentAsync(50);
            if (!list.Success || list.Data is null)
            {
                _error = list.ErrorMessage ?? "Could not load recent sales.";
                _invoices = [];
                return;
            }

            _invoices = list.Data;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FindSaleAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_search.Invoice)
            && string.IsNullOrWhiteSpace(_search.Customer)
            && string.IsNullOrWhiteSpace(_search.Product))
        {
            _error = "Enter an invoice, customer, or product to search.";
            return;
        }

        _isLoading = true;
        _showingSearchResults = true;
        try
        {
            Result<IReadOnlyList<SalesInvoiceSummaryDto>> result = await InvoiceApi.SearchAsync(
                string.IsNullOrWhiteSpace(_search.Invoice) ? null : _search.Invoice,
                string.IsNullOrWhiteSpace(_search.Customer) ? null : _search.Customer,
                string.IsNullOrWhiteSpace(_search.Product) ? null : _search.Product,
                limit: 40);

            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Search failed.";
                _invoices = [];
                return;
            }

            _invoices = result.Data;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenInvoiceAsync(string invoiceNo)
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(invoiceNo))
        {
            return;
        }

        _isBusy = true;
        try
        {
            Result<SalesInvoiceDetailDto> result = await InvoiceApi.GetAsync(invoiceNo);
            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Invoice not found.";
                return;
            }

            _detail = result.Data;
            _lines = _detail.Lines
                .Where(line => line.ReturnableQuantity > 0)
                .Select(line => new ReturnLineEdit
                {
                    ProductId = line.ProductId,
                    BatchId = line.BatchId,
                    ProductName = line.ProductName,
                    IsLoose = line.IsLoose,
                    QuantitySold = line.QuantitySold,
                    ReturnableQuantity = line.ReturnableQuantity,
                    UnitPricePaisa = line.UnitPricePaisa,
                    ReturnQtyText = "0"
                }).ToList();

            if (_lines.Count == 0)
            {
                _error = "Nothing left to return on this invoice.";
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ApplyFullReturn()
    {
        foreach (ReturnLineEdit line in _lines)
        {
            SetQty(line, line.ReturnableQuantity);
        }
    }

    private async Task ClearDetailAsync()
    {
        _detail = null;
        _lines = [];
        _error = null;
        await LoadRecentSalesAsync();
    }

    private static decimal Step(ReturnLineEdit line) => line.IsLoose ? 0.25m : 1m;

    private void AdjustQty(ReturnLineEdit line, decimal delta)
    {
        decimal next = Math.Clamp(line.ReturnQuantity + delta, 0m, line.ReturnableQuantity);
        if (!line.IsLoose)
        {
            next = Math.Round(next, 0, MidpointRounding.AwayFromZero);
        }

        SetQty(line, next);
    }

    private void OnQtyInput(ReturnLineEdit line, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            line.ReturnQtyText = "0";
            return;
        }

        if (!decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal qty)
            && !decimal.TryParse(raw, NumberStyles.Number, CultureInfo.CurrentCulture, out qty))
        {
            return;
        }

        SetQty(line, Math.Clamp(qty, 0m, line.ReturnableQuantity));
    }

    private static void SetQty(ReturnLineEdit line, decimal qty)
    {
        line.ReturnQtyText = qty.ToString(
            line.IsLoose ? "0.##" : "0",
            CultureInfo.InvariantCulture);
    }

    private void ClearLine(ReturnLineEdit line) => SetQty(line, 0m);

    private async Task SubmitReturnAsync()
    {
        if (_detail is null)
        {
            return;
        }

        _error = null;
        _success = null;

        List<ReturnLineRequest> items = [];
        foreach (ReturnLineEdit line in _lines)
        {
            decimal qty = line.ReturnQuantity;
            if (qty <= 0)
            {
                continue;
            }

            if (qty > line.ReturnableQuantity)
            {
                _error = $"{line.ProductName}: cannot return more than {line.ReturnableQuantity:0.##}.";
                return;
            }

            items.Add(new ReturnLineRequest
            {
                ProductId = line.ProductId,
                BatchId = line.BatchId,
                Quantity = qty,
                ReturnCondition = "GOOD"
            });
        }

        if (items.Count == 0)
        {
            _error = "Enter a return quantity on at least one line.";
            return;
        }

        _isBusy = true;
        try
        {
            Result<ReturnItemsResult> result = await InvoiceApi.ReturnAsync(new ReturnItemsRequest
            {
                OriginalInvoiceNo = _detail.InvoiceNo,
                CashierId = SessionService.CashierId,
                Items = items
            });

            if (!result.Success || result.Data is null)
            {
                _error = result.ErrorMessage ?? "Return failed.";
                return;
            }

            _success = $"Return OK — refund Rs {FormatRs(result.Data.TotalRefundPaisa)}";
            if (CheckoutPaymentMethods.IsCash(_detail.PaymentMethod))
            {
                ShiftStatus.ApplyLocalCashDelta(-result.Data.TotalRefundPaisa);
            }

            await ShiftStatus.RefreshAsync();
            _detail = null;
            _lines = [];
            await LoadRecentSalesAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string ShortId(string invoiceNo) =>
        invoiceNo.Length <= 8 ? invoiceNo : invoiceNo[^8..];

    private static string FormatRs(long paisa) => (paisa / 100m).ToString("N2");

    private static string PaymentLabel(string method)
    {
        if (CheckoutPaymentMethods.IsCash(method))
        {
            return "Cash";
        }

        if (CheckoutPaymentMethods.IsOnline(method)
            || string.Equals(method, "BANK", StringComparison.OrdinalIgnoreCase)
            || string.Equals(method, "CREDIT_CARD", StringComparison.OrdinalIgnoreCase))
        {
            return "Online";
        }

        return CheckoutPaymentMethods.DisplayLabel(method);
    }
}

