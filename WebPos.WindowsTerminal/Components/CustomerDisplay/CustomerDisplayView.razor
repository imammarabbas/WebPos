@inject CustomerDisplayState DisplayState
@implements IDisposable

<CustomerDisplayChromeBridge />

<div class="cfd-shell">
    <header class="cfd-header">
        <h1>Smart POS</h1>
        <div class="cfd-meta">@CustomerHeader</div>
    </header>

    <main class="cfd-lines" aria-live="polite">
        @if (Snapshot.Items.Count == 0)
        {
            <div class="cfd-empty">Waiting for items...</div>
        }
        else
        {
            @foreach (CustomerDisplayLine line in Snapshot.Items)
            {
                <div class="cfd-row">
                    <span>@FormatQty(line.Quantity) × @line.Description</span>
                    <strong>@FormatMoney(line.LineTotal)</strong>
                </div>
            }
        }
    </main>

    <footer class="cfd-ledger" aria-live="polite">
        @if (Snapshot.IsWalkIn)
        {
            <div class="cfd-tot">Total: Rs @FormatMoney(Snapshot.CurrentSaleTotal)</div>
            <div class="cfd-status">
                Paid: Rs @FormatMoney(Snapshot.PaymentReceived)
                <span class="cfd-sep">·</span>
                @if (Snapshot.ChangeReturn > 0m)
                {
                    <span class="cfd-change-out">CHANGE TO RETURN: @FormatChangeOut(Snapshot.ChangeReturn)</span>
                }
                else
                {
                    <span>Return: Rs @FormatMoney(0m)</span>
                }
            </div>
        }
        else
        {
            <div class="cfd-due-row">
                <span>Current Sale: Rs @FormatMoney(Snapshot.CurrentSaleTotal)</span>
                <span class="cfd-sep">|</span>
                <span>Previous Due: Rs @FormatMoney(Snapshot.PreviousDue)</span>
            </div>
            <div class="cfd-status">
                Paid: Rs @FormatMoney(Snapshot.PaymentReceived)
                @if (Snapshot.AccountCredit > 0m)
                {
                    <span class="cfd-sep">·</span>
                    <span class="cfd-account-credit">Added to Account: Rs @FormatMoney(Snapshot.AccountCredit)</span>
                }
                else if (Snapshot.OnAccount > 0m)
                {
                    <span class="cfd-sep">·</span>
                    <span>Added to Account: Rs @FormatMoney(Snapshot.OnAccount)</span>
                }
            </div>
            <div class="cfd-balance @(Snapshot.NewCustomerBalance < 0m || Snapshot.AccountCredit > 0m ? "is-credit" : null)">
                New Total Balance: Rs @FormatMoney(Snapshot.NewCustomerBalance)
            </div>
        }
    </footer>
</div>

@code {
    private CustomerDisplaySnapshot Snapshot = CustomerDisplayState.Empty;

    private string CustomerHeader =>
        $"{(string.IsNullOrWhiteSpace(Snapshot.CustomerName) ? "WALK IN CUSTOMER" : Snapshot.CustomerName).ToUpperInvariant()} · Invoice #{Snapshot.InvoiceNo}";

    protected override void OnInitialized()
    {
        Snapshot = DisplayState.Current;
        DisplayState.Changed += OnDisplayChanged;
    }

    private void OnDisplayChanged()
    {
        _ = InvokeAsync(() =>
        {
            Snapshot = DisplayState.Current;
            StateHasChanged();
        });
    }

    private static string FormatQty(decimal qty) =>
        qty % 1m == 0m
            ? qty.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
            : qty.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatMoney(decimal amount) =>
        amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatChangeOut(decimal change) =>
        (-change).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    public void Dispose()
    {
        DisplayState.Changed -= OnDisplayChanged;
    }
}
